                                          </fo:list-item-label>
                                          <fo:list-item-body start-indent="body-start()">
                                             <fo:block>public static final String REMOTE_INTENTS_SUPPORTED = "remote.intents.supported"</fo:block>
                                          </fo:list-item-body>
