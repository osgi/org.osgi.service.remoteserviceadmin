                           </fo:block>
                        </fo:list-item-label>
                        <fo:list-item-body start-indent="body-start()">
                           <fo:block>
                              <fo:basic-link internal-destination="org.osgi.service.remoteserviceadmin.RemoteServiceAdminEvent">
                                 <fo:inline color="inherit"
                                            font-family="inherit"
                                            letter-spacing="inherit"
                                            hyphenate="inherit">RemoteServiceAdminEvent</fo:inline>
                              </fo:basic-link>
                           </fo:block>
                        </fo:list-item-body>
                     </fo:list-item>
                  </fo:list-block>
               </fo:block>
