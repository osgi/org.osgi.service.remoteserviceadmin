&lt;schema xmlns="http://www.w3.org/2001/XMLSchema"
  xmlns:rsa="http://www.osgi.org/xmlns/rsa/v1.0.0"
  targetNamespace="http://www.osgi.org/xmlns/rsa/v1.0.0"
  elementFormDefault="qualified" version="1.0.1"&gt;

  &lt;annotation&gt;
    &lt;documentation xml:lang="en"&gt;
      This is the XML Schema for endpoint descriptions used by
      the Remote Service Admin Specification. Endpoint descriptions
      are used to describe remote services to a client in cases
      where a real live Discovery system isn't used. An extender,
      such as a local Discovery Service can look for service
      descriptions in installed bundles and inform the Topology
      Manager of these remote services. The Topology Manager can then
      instruct the Remote Service Admin to create client proxies for
      these services.
    &lt;/documentation&gt;
  &lt;/annotation&gt;

  &lt;element name="endpoint-descriptions" type="rsa:Tendpoint-descriptions" /&gt;

  &lt;complexType name="Tendpoint-descriptions"&gt;
    &lt;sequence&gt;
      &lt;element name="endpoint-description" type="rsa:Tendpoint-description"
               minOccurs="1" maxOccurs="unbounded" /&gt;
        &lt;!--
          It is non-deterministic, per W3C XML Schema 1.0:
          http://www.w3.org/TR/xmlschema-1/#cos-nonambig to use
          namespace="##any" below.
        --&gt;
      &lt;any namespace="##other" minOccurs="0" maxOccurs="unbounded"
           processContents="lax" /&gt;
    &lt;/sequence&gt;
    &lt;anyAttribute processContents="lax" /&gt;
  &lt;/complexType&gt;

  &lt;complexType name="Tendpoint-description"&gt;
    &lt;annotation&gt;
      &lt;documentation xml:lang="en"&gt;
        A Distribution Provider can register a proxy with the properties
        provided. Whether or not it is instructed to do so, is up to the
        Topology Manager. If any 'intents' properties are specified then the
        Distribution Provider should only register a proxy if it can support 
        those intents.
      &lt;/documentation&gt;
    &lt;/annotation&gt;
    &lt;sequence&gt;
      &lt;element name="property" type="rsa:Tproperty" minOccurs="1"
               maxOccurs="unbounded" /&gt;
      &lt;any namespace="##other" minOccurs="0" maxOccurs="unbounded"
           processContents="lax" /&gt;
    &lt;/sequence&gt;
    &lt;anyAttribute processContents="lax" /&gt;
  &lt;/complexType&gt;

  &lt;complexType name="Tproperty" mixed="true"&gt;
    &lt;sequence&gt;
      &lt;choice minOccurs="0" maxOccurs="1"&gt;
        &lt;element name="array" type="rsa:Tmulti-value"/&gt;
        &lt;element name="list" type="rsa:Tmulti-value"/&gt;
        &lt;element name="set" type="rsa:Tmulti-value"/&gt;
        &lt;element name="xml" type="rsa:Txml"/&gt;
      &lt;/choice&gt;
      &lt;any namespace="##other" minOccurs="0" maxOccurs="unbounded"
           processContents="lax" /&gt;
    &lt;/sequence&gt;
    &lt;attribute name="name" type="string" use="required" /&gt;
    &lt;attribute name="value" type="string" use="optional" /&gt;
    &lt;attribute name="value-type" type="rsa:Tvalue-types" default="String" use="optional" /&gt;
    &lt;anyAttribute processContents="lax" /&gt;
  &lt;/complexType&gt;
  
  &lt;complexType name="Tmulti-value"&gt;
    &lt;sequence&gt;
      &lt;element name="value" minOccurs="0" maxOccurs="unbounded" type="rsa:Tvalue"/&gt;
      &lt;any namespace="##other" minOccurs="0" maxOccurs="unbounded"
           processContents="lax" /&gt;      
    &lt;/sequence&gt;
    &lt;anyAttribute processContents="lax" /&gt;
  &lt;/complexType&gt;
  
  &lt;complexType name="Tvalue" mixed="true"&gt;
    &lt;sequence&gt;
      &lt;element name="xml" minOccurs="0" maxOccurs="1" type="rsa:Txml"/&gt;
      &lt;any namespace="##other" minOccurs="0" maxOccurs="unbounded"
           processContents="lax" /&gt;      
    &lt;/sequence&gt;
    &lt;anyAttribute processContents="lax" /&gt;
  &lt;/complexType&gt;
  
  &lt;!-- Specifies the data type of a property or of the elements in a multi-value  
       property. Numerical and boolean values are trimmed before they are processed.
       Simple types are automatically boxed if needed. Only the array data type 
       allows for simple type values. When specifying a simple type on any other 
       type of property it will automatically be boxed. --&gt;
  &lt;simpleType name="Tvalue-types"&gt;
    &lt;restriction base="string"&gt;
      &lt;enumeration value="String" /&gt;
      &lt;enumeration value="long" /&gt;
      &lt;enumeration value="Long" /&gt;
      &lt;enumeration value="double" /&gt;
      &lt;enumeration value="Double" /&gt;
      &lt;enumeration value="float" /&gt;
      &lt;enumeration value="Float" /&gt;
      &lt;enumeration value="int" /&gt;
      &lt;enumeration value="Integer" /&gt;
      &lt;enumeration value="byte" /&gt;
      &lt;enumeration value="Byte" /&gt;
      &lt;enumeration value="char" /&gt;
      &lt;enumeration value="Character" /&gt;
      &lt;enumeration value="boolean" /&gt;
      &lt;enumeration value="Boolean" /&gt;
      &lt;enumeration value="short" /&gt;
      &lt;enumeration value="Short" /&gt;
    &lt;/restriction&gt;
  &lt;/simpleType&gt;
  
  &lt;!-- This complex type allows literal XML to be specified in an &lt;xml/&gt; tag (which 
       is more convenient than putting it in a CDATA section). 
       The embedded XML must be well-formed and not be in the rsa namespace. It will 
       be put in a String value of a property or in an element of a multi-value 
       property of base type String. The XML will be prefixed with the standard 
       &lt;?XML ?&gt; header which is copied from the enclosing document. Hence it will 
       carry the same version and encoding as the document in the rsa namespace. --&gt;
  &lt;complexType name="Txml"&gt;
    &lt;sequence&gt;
      &lt;any namespace="##other" minOccurs="1" maxOccurs="1"
           processContents="lax" /&gt;
    &lt;/sequence&gt;
    &lt;anyAttribute processContents="lax" /&gt;
  &lt;/complexType&gt;

  &lt;attribute name="must-understand" type="boolean" default="false"&gt;
    &lt;annotation&gt;
      &lt;documentation xml:lang="en"&gt;
        This attribute should be used by extensions to documents
        to require that the document consumer understand the
        extension.
      &lt;/documentation&gt;
    &lt;/annotation&gt;
  &lt;/attribute&gt;
&lt;/schema&gt;
</fo:block>
            </fo:block>
         </fo:block>
         <fo:block id="d61e1578">
            <fo:block>
               <fo:block>
                  <fo:block keep-together.within-column="always"
                            margin-left="0pt"
                            font-family="ProductusSemibold,ArialUnicodeMS">
                     <fo:block keep-with-next.within-column="always">
                        <fo:block xmlns:d="http://docbook.org/ns/docbook"
                                  xmlns:xlink="http://www.w3.org/1999/xlink"
                                  font-family="ProductusSemibold,ArialUnicodeMS"
                                  font-weight="normal"
                                  keep-with-next.within-column="always"
                                  space-before.minimum="0.8em"
                                  space-before.optimum="1.0em"
                                  space-before.maximum="1.2em"
                                  text-align="start"
                                  start-indent="0pt"
                                  hyphenate="false">
                           <fo:marker marker-class-name="section.head.marker">Capability Namespaces</fo:marker>
                           <fo:block font-size="18pt"
                                     line-height="25pt"
                                     space-before="12.5pt"
                                     space-after="12pt">
                              <fo:list-block provisional-distance-between-starts="1in"
                                             provisional-label-separation="0.090in">
                                 <fo:list-item>
                                    <fo:list-item-label end-indent="label-end()" text-align="start">
                                       <fo:block>122.9</fo:block>
                                    </fo:list-item-label>
                                    <fo:list-item-body start-indent="body-start()">
                                       <fo:block>Capability Namespaces</fo:block>
                                    </fo:list-item-body>
                                 </fo:list-item>
                              </fo:list-block>
                           </fo:block>
                        </fo:block>
                     </fo:block>
                  </fo:block>
               </fo:block>
            </fo:block>
            <fo:block id="d61e1580">
               <fo:block>
                  <fo:block>
                     <fo:block keep-together.within-column="always"
                               margin-left="0pt"
                               font-family="ProductusSemibold,ArialUnicodeMS">
                        <fo:block keep-with-next.within-column="always">
                           <fo:block xmlns:d="http://docbook.org/ns/docbook"
                                     xmlns:xlink="http://www.w3.org/1999/xlink"
                                     font-family="ProductusSemibold,ArialUnicodeMS"
                                     font-weight="normal"
                                     keep-with-next.within-column="always"
                                     space-before.minimum="0.8em"
                                     space-before.optimum="1.0em"
                                     space-before.maximum="1.2em"
                                     text-align="start"
                                     start-indent="0pt"
                                     hyphenate="false">
                              <fo:block font-size="12pt"
                                        line-height="14pt"
                                        space-before="8pt"
                                        space-after="5pt">
                                 <fo:list-block provisional-distance-between-starts="1in"
                                                provisional-label-separation="0.090in">
                                    <fo:list-item>
                                       <fo:list-item-label end-indent="label-end()" text-align="start">
                                          <fo:block>122.9.1</fo:block>
                                       </fo:list-item-label>
                                       <fo:list-item-body start-indent="body-start()">
                                          <fo:block>Local Discovery Extender</fo:block>
                                       </fo:list-item-body>
                                    </fo:list-item>
                                 </fo:list-block>
                              </fo:block>
                           </fo:block>
                        </fo:block>
                     </fo:block>
                  </fo:block>
               </fo:block>
               <fo:block space-before.optimum="5pt"
                         space-before.minimum="5pt"
                         space-before.maximum="5pt">A bundle containing Endpoint Description Extender resources can
      indicate its dependency on the Remote Service Admin extender by
      declaring a requirement on the <fo:inline font-family="ProductusOSGiBookc,ArialUnicodeMS"
                             font-size="9pt"
                             letter-spacing="0.08em">osgi.extender</fo:inline>
      namespace.</fo:block>
               <fo:block space-before.minimum="0.8em"
                         space-before.optimum="1em"
                         space-before.maximum="1.2em"
                         space-after.minimum="0.8em"
                         space-after.optimum="1em"
                         space-after.maximum="1.2em"
                         hyphenate="false"
                         wrap-option="no-wrap"
                         white-space-collapse="false"
                         white-space-treatment="preserve"
                         linefeed-treatment="preserve"
                         text-align="start"
                         font-family="ProductusOSGiMonoc,ArialUnicodeMS"
                         font-size="9pt"
                         letter-spacing="-.0em"
                         space-before="5pt"
                         space-after="3pt"
                         space-after.conditionality="retain"
                         start-indent="inherit"
                         line-height="11pt"
                         id="d61e1586">Require-Capability: osgi.extender;
    filter:="(&amp;(osgi.extender=osgi.remoteserviceadmin.localdiscovery)
             (version&gt;=1.0)(!(version&gt;=2.0)))"</fo:block>
               <fo:block space-before.optimum="5pt"
                         space-before.minimum="5pt"
                         space-before.maximum="5pt">With this constraint declared a bundle that depends on the
      extender will fail to resolve if no extender is present in the
      framework.</fo:block>
               <fo:block space-before.optimum="5pt"
                         space-before.minimum="5pt"
                         space-before.maximum="5pt">Implementations of this specification must provide this extender
      capability at version 1.0 as follows:</fo:block>
               <fo:block space-before.minimum="0.8em"
                         space-before.optimum="1em"
                         space-before.maximum="1.2em"
                         space-after.minimum="0.8em"
                         space-after.optimum="1em"
                         space-after.maximum="1.2em"
                         hyphenate="false"
                         wrap-option="no-wrap"
                         white-space-collapse="false"
                         white-space-treatment="preserve"
                         linefeed-treatment="preserve"
                         text-align="start"
                         font-family="ProductusOSGiMonoc,ArialUnicodeMS"
                         font-size="9pt"
                         letter-spacing="-.0em"
                         space-before="5pt"
                         space-after="3pt"
                         space-after.conditionality="retain"
                         start-indent="inherit"
                         line-height="11pt"
                         id="d61e1589">Provide-Capability: osgi.extender;
    osgi.extender="osgi.remoteserviceadmin.localdiscovery";
    version:Version="1.0";
    uses:="org.osgi.service.remoteserviceadmin"</fo:block>
               <fo:block space-before.optimum="5pt"
                         space-before.minimum="5pt"
                         space-before.maximum="5pt">The reason that the extender capability is declared at version 1.0
      is because the extender is unchanged from version 1.0 of this
      specification.</fo:block>
            </fo:block>
            <fo:block id="d61e1591">
               <fo:block>
                  <fo:block>
                     <fo:block keep-together.within-column="always"
                               margin-left="0pt"
                               font-family="ProductusSemibold,ArialUnicodeMS">
                        <fo:block keep-with-next.within-column="always">
                           <fo:block xmlns:d="http://docbook.org/ns/docbook"
                                     xmlns:xlink="http://www.w3.org/1999/xlink"
                                     font-family="ProductusSemibold,ArialUnicodeMS"
                                     font-weight="normal"
                                     keep-with-next.within-column="always"
                                     space-before.minimum="0.8em"
                                     space-before.optimum="1.0em"
                                     space-before.maximum="1.2em"
                                     text-align="start"
                                     start-indent="0pt"
                                     hyphenate="false">
                              <fo:block font-size="12pt"
                                        line-height="14pt"
                                        space-before="8pt"
                                        space-after="5pt">
                                 <fo:list-block provisional-distance-between-starts="1in"
                                                provisional-label-separation="0.090in">
                                    <fo:list-item>
                                       <fo:list-item-label end-indent="label-end()" text-align="start">
                                          <fo:block>122.9.2</fo:block>
                                       </fo:list-item-label>
                                       <fo:list-item-body start-indent="body-start()">
                                          <fo:block>Discovery Provider Capability</fo:block>
                                       </fo:list-item-body>
                                    </fo:list-item>
                                 </fo:list-block>
                              </fo:block>
                           </fo:block>
                        </fo:block>
                     </fo:block>
                  </fo:block>
               </fo:block>
               <fo:block space-before.optimum="5pt"
                         space-before.minimum="5pt"
                         space-before.maximum="5pt">Discovery Providers use the
      <fo:inline font-family="ProductusOSGiBookc,ArialUnicodeMS"
                             font-size="9pt"
                             letter-spacing="0.08em">osgi.remoteserviceadmin.discovery</fo:inline> namespace to declare
      themselves as such. The version defined for this namespace indicates the
      version of this specification that the discovery provider
      supports.</fo:block>
               <fo:block space-before.optimum="5pt"
                         space-before.minimum="5pt"
                         space-before.maximum="5pt">This namespace has a defined attribute, <fo:inline font-family="ProductusOSGiBookc,ArialUnicodeMS"
                             font-size="9pt"
                             letter-spacing="0.08em">protocols</fo:inline> of
      type <fo:inline font-family="ProductusOSGiBookc,ArialUnicodeMS"
                             font-size="9pt"
                             letter-spacing="0.08em">List&lt;String&gt;</fo:inline>, which contains a list of the
      discovery protocols supported by the discovery provider. Local discovery
      providers (using the <fo:basic-link xmlns:d="http://docbook.org/ns/docbook"
                                 xmlns:xlink="http://www.w3.org/1999/xlink"
                                 internal-destination="i1889341">
                     <fo:inline color="inherit"
                                font-family="inherit"
                                letter-spacing="inherit"
                                hyphenate="inherit">
                        <fo:inline font-style="italic">Endpoint Description Extender Format</fo:inline> on page <fo:page-number-citation ref-id="i1889341"/>
                     </fo:inline>
                  </fo:basic-link>), should use the value
      <fo:inline font-family="ProductusOSGiBookc,ArialUnicodeMS"
                             font-size="9pt"
                             letter-spacing="0.08em">local</fo:inline> to indicate that they support this. Additionally, it
      defines a <fo:inline font-family="ProductusOSGiBookc,ArialUnicodeMS"
                             font-size="9pt"
                             letter-spacing="0.08em">version</fo:inline> attribute. Other values for the protocols
      attribute are implementation specific.</fo:block>
               <fo:block xmlns:rx="http://www.renderx.com/XSL/Extensions" start-indent="0pt">
                  <fo:block space-before.minimum="0.5em"
                            space-before.optimum="1em"
                            space-before.maximum="2em"
                            space-after.minimum="0.5em"
                            space-after.optimum="1em"
                            space-after.maximum="2em"
                            keep-together.within-column="auto"
                            id="d61e1609">
                     <fo:block xmlns:d="http://docbook.org/ns/docbook"
                               xmlns:xlink="http://www.w3.org/1999/xlink"
                               space-before.optimum="5pt"
                               space-before.minimum="5pt"
                               space-before.maximum="5pt"
                               font-weight="normal"
                               font-size="9pt"
                               hyphenate="false"
                               space-after.minimum="0.4em"
                               space-after.optimum="0.6em"
                               space-after.maximum="0.8em"
                               start-indent="0pt"
                               font-family="Proforma-Book,ArialUnicodeMS"
                               font-style="italic"
                               keep-with-next.within-column="always">
                        <fo:list-block provisional-distance-between-starts="1in"
                                       provisional-label-separation="0.090in">
                           <fo:list-item>
                              <fo:list-item-label end-indent="label-end()" text-align="start">
                                 <fo:block>Table 122.3</fo:block>
                              </fo:list-item-label>
                              <fo:list-item-body start-indent="body-start()">
                                 <fo:block>osgi.remoteserviceadmin.discovery Namespace</fo:block>
                              </fo:list-item-body>
                           </fo:list-item>
                        </fo:list-block>
                     </fo:block>
                     <fo:table border-before-width.conditionality="retain"
                               border-collapse="collapse"
                               table-layout="fixed"
                               width="100%">
                        <fo:table-column column-number="1" column-width="proportional-column-width(2)"/>
                        <fo:table-column column-number="2" column-width="proportional-column-width(1)"/>
                        <fo:table-column column-number="3" column-width="proportional-column-width(1)"/>
                        <fo:table-column column-number="4" column-width="proportional-column-width(2)"/>
                        <fo:table-column column-number="5" column-width="proportional-column-width(3.5)"/>
                        <fo:table-column column-number="6" column-width="proportional-column-width(7)"/>
                        <fo:table-header start-indent="0pt" end-indent="0pt">
                           <fo:table-row keep-together.within-column="always"
                                         keep-with-next.within-column="always"
                                         font-family="ProductusSemibold,ArialUnicodeMS">
                              <fo:table-cell padding-start="0pt"
                                             padding-end="4pt"
                                             padding-top="1pt"
                                             padding-bottom="1pt">
                                 <fo:block>Name</fo:block>
                              </fo:table-cell>
                              <fo:table-cell padding-start="0pt"
                                             padding-end="4pt"
                                             padding-top="1pt"
                                             padding-bottom="1pt">
                                 <fo:block>Kind</fo:block>
                              </fo:table-cell>
                              <fo:table-cell padding-start="0pt"
                                             padding-end="4pt"
                                             padding-top="1pt"
                                             padding-bottom="1pt">
                                 <fo:block>M/O</fo:block>
                              </fo:table-cell>
                              <fo:table-cell padding-start="0pt"
                                             padding-end="4pt"
                                             padding-top="1pt"
                                             padding-bottom="1pt">
                                 <fo:block>Type</fo:block>
                              </fo:table-cell>
                              <fo:table-cell padding-start="0pt"
                                             padding-end="4pt"
                                             padding-top="1pt"
                                             padding-bottom="1pt">
                                 <fo:block>Syntax</fo:block>
                              </fo:table-cell>
                              <fo:table-cell padding-start="0pt"
                                             padding-end="4pt"
                                             padding-top="1pt"
                                             padding-bottom="1pt">
                                 <fo:block>Description</fo:block>
                              </fo:table-cell>
                           </fo:table-row>
                        </fo:table-header>
                        <fo:table-body start-indent="0pt" end-indent="0pt">
                           <fo:table-row keep-together.within-column="always">
                              <fo:table-cell padding-start="0pt"
                                             padding-end="4pt"
                                             padding-top="1pt"
                                             padding-bottom="1pt">
                                 <fo:block>
                                    <fo:inline font-family="ProductusOSGiBookc,ArialUnicodeMS"
                                               font-size="9pt"
                                               letter-spacing="0.08em">protocols</fo:inline>
                                 </fo:block>
                              </fo:table-cell>
                              <fo:table-cell padding-start="0pt"
                                             padding-end="4pt"
                                             padding-top="1pt"
                                             padding-bottom="1pt">
                                 <fo:block>
                                    <fo:inline font-family="ProductusOSGiBookc,ArialUnicodeMS"
                                               font-size="9pt"
                                               letter-spacing="0.08em">CA</fo:inline>
                                 </fo:block>
                              </fo:table-cell>
                              <fo:table-cell padding-start="0pt"
                                             padding-end="4pt"
                                             padding-top="1pt"
                                             padding-bottom="1pt">
                                 <fo:block>
                                    <fo:inline font-family="ProductusOSGiBookc,ArialUnicodeMS"
                                               font-size="9pt"
                                               letter-spacing="0.08em">M</fo:inline>
                                 </fo:block>
                              </fo:table-cell>
                              <fo:table-cell padding-start="0pt"
                                             padding-end="4pt"
                                             padding-top="1pt"
                                             padding-bottom="1pt">
                                 <fo:block>
                                    <fo:inline font-family="ProductusOSGiBookc,ArialUnicodeMS"
                                               font-size="9pt"
                                               letter-spacing="0.08em">List&lt;String&gt;</fo:inline>
                                 </fo:block>
                              </fo:table-cell>
                              <fo:table-cell padding-start="0pt"
                                             padding-end="4pt"
                                             padding-top="1pt"
                                             padding-bottom="1pt">
                                 <fo:block>
                                    <fo:inline font-family="ProductusOSGiBookc,ArialUnicodeMS"
                                               font-size="9pt"
                                               letter-spacing="0.08em">symbolic-name</fo:inline>
                                 </fo:block>
                              </fo:table-cell>
                              <fo:table-cell padding-start="0pt"
                                             padding-end="4pt"
                                             padding-top="1pt"
                                             padding-bottom="1pt">
                                 <fo:block>
                                    <fo:block space-before.optimum="5pt"
                                              space-before.minimum="5pt"
                                              space-before.maximum="5pt">The discovery protocols supported. A value of
              <fo:inline font-family="ProductusOSGiBookc,ArialUnicodeMS"
                                                  font-size="9pt"
