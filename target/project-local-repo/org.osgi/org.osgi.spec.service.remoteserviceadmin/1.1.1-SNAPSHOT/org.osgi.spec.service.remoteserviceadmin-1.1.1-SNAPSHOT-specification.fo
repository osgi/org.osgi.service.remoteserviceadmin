      <fo:flow flow-name="xsl-region-body" start-indent="1in" end-indent="0pt">
         <fo:block id="service.remoteserviceadmin">
            <fo:block font-family="ProductusSemibold,ArialUnicodeMS">
               <fo:block margin-left="0pt">
                  <fo:block font-size="24.8832pt" font-weight="bold">
                     <fo:block xmlns:d="http://docbook.org/ns/docbook"
                               xmlns:xlink="http://www.w3.org/1999/xlink"
                               keep-with-next.within-column="always"
                               space-before.optimum="0in"
                               space-before.minimum="0in"
                               space-before.maximum="0in"
                               hyphenate="false"
                               text-align="start"
                               start-indent="0pt"
                               font-family="ProductusSemibold,ArialUnicodeMS"
                               font-size="28pt"
                               line-height="35pt"
                               font-weight="normal"
                               space-after="24pt">
                        <fo:list-block provisional-distance-between-starts="1in"
                                       provisional-label-separation="0.090in">
                           <fo:list-item>
                              <fo:list-item-label end-indent="label-end()" text-align="start">
                                 <fo:block>122</fo:block>
                              </fo:list-item-label>
                              <fo:list-item-body start-indent="body-start()">
                                 <fo:block>Remote Service Admin Service Specification</fo:block>
                              </fo:list-item-body>
                           </fo:list-item>
                        </fo:list-block>
                     </fo:block>
                  </fo:block>
                  <fo:block>
                     <fo:block xmlns:d="http://docbook.org/ns/docbook"
                               xmlns:xlink="http://www.w3.org/1999/xlink"
                               font-family="ProductusOSGiBookcItalic"
                               font-size="18pt"
                               line-height="25pt">
                        <fo:basic-link internal-destination="org.osgi.service.remoteserviceadmin">
                           <fo:inline color="inherit"
                                      font-family="inherit"
                                      letter-spacing="inherit"
                                      hyphenate="inherit">Version 1.1</fo:inline>
                        </fo:basic-link>
                     </fo:block>
                  </fo:block>
               </fo:block>
            </fo:block>
         </fo:block>
         <fo:block id="d61e88">
            <fo:block>
               <fo:block>
                  <fo:block keep-together.within-column="always"
                            margin-left="0pt"
                            font-family="ProductusSemibold,ArialUnicodeMS">
                     <fo:block keep-with-next.within-column="always">
                        <fo:block xmlns:d="http://docbook.org/ns/docbook"
                                  xmlns:xlink="http://www.w3.org/1999/xlink"
                                  font-family="ProductusSemibold,ArialUnicodeMS"
                                  font-weight="normal"
                                  keep-with-next.within-column="always"
                                  space-before.minimum="0.8em"
                                  space-before.optimum="1.0em"
                                  space-before.maximum="1.2em"
                                  text-align="start"
                                  start-indent="0pt"
                                  hyphenate="false">
                           <fo:marker marker-class-name="section.head.marker">Introduction</fo:marker>
                           <fo:block font-size="18pt"
                                     line-height="25pt"
                                     space-before="12.5pt"
                                     space-after="12pt">
                              <fo:list-block provisional-distance-between-starts="1in"
                                             provisional-label-separation="0.090in">
                                 <fo:list-item>
                                    <fo:list-item-label end-indent="label-end()" text-align="start">
                                       <fo:block>122.1</fo:block>
                                    </fo:list-item-label>
                                    <fo:list-item-body start-indent="body-start()">
                                       <fo:block>Introduction</fo:block>
                                    </fo:list-item-body>
                                 </fo:list-item>
                              </fo:list-block>
                           </fo:block>
                        </fo:block>
                     </fo:block>
                  </fo:block>
               </fo:block>
            </fo:block>
            <fo:block space-before.optimum="5pt"
                      space-before.minimum="5pt"
                      space-before.maximum="5pt">The <fo:inline color="inherit"
                          font-family="inherit"
                          letter-spacing="inherit"
                          hyphenate="inherit">???</fo:inline>
    framework specifies a model where bundles can use distributed services.
    The basic model for OSGi remote services is that a bundle can register
    services that are <fo:inline font-style="italic">exported</fo:inline> to a communication
    <fo:inline font-style="italic">Endpoint</fo:inline> and use services that are
    <fo:inline font-style="italic">imported</fo:inline> from a communication Endpoint. However,
    chapter <fo:inline color="inherit"
                          font-family="inherit"
                          letter-spacing="inherit"
                          hyphenate="inherit">???</fo:inline> does not explain
    <fo:inline font-style="italic">what</fo:inline> services are exported and/or imported; it leaves
    such decisions to the distribution provider. The distribution provider
    therefore performs multiple roles and cannot be leveraged by other bundles
    in scenarios that the distribution provider had not foreseen.</fo:block>
            <fo:block space-before.optimum="5pt"
                      space-before.minimum="5pt"
                      space-before.maximum="5pt">The primary role of the distribution provider is purely mechanical;
    it creates Endpoints and registers service proxies and enables their
    communication. The second role is about the policies around the desired
    topology. The third role is discovery. To establish a specific topology it
    is necessary to find out about exported services in other
    frameworks.</fo:block>
            <fo:block space-before.optimum="5pt"
                      space-before.minimum="5pt"
                      space-before.maximum="5pt">This specification therefore defines an API for the distribution
    provider and discovery of services in a network. A management agent can
    use this API to provide an actual distribution policy. This management
    agent, called the Topology Manager, can control the export and import of
    services delegating the intrinsic knowledge of the low level details of
    communication protocols, proxying of services, and discovering services in
    the network to services defined in this specification.</fo:block>
            <fo:block space-before.optimum="5pt"
                      space-before.minimum="5pt"
                      space-before.maximum="5pt">This specification is an extension of the Remote Service chapter.
    Though some aspects are repeated in this specification, a full
    understanding of the Remote Services chapter is required for full
    understanding of this document.</fo:block>
            <fo:block id="d61e108">
               <fo:block>
                  <fo:block>
                     <fo:block keep-together.within-column="always"
                               margin-left="0pt"
                               font-family="ProductusSemibold,ArialUnicodeMS">
                        <fo:block keep-with-next.within-column="always">
                           <fo:block xmlns:d="http://docbook.org/ns/docbook"
                                     xmlns:xlink="http://www.w3.org/1999/xlink"
                                     font-family="ProductusSemibold,ArialUnicodeMS"
                                     font-weight="normal"
                                     keep-with-next.within-column="always"
                                     space-before.minimum="0.8em"
                                     space-before.optimum="1.0em"
                                     space-before.maximum="1.2em"
                                     text-align="start"
                                     start-indent="0pt"
                                     hyphenate="false">
                              <fo:block font-size="12pt"
                                        line-height="14pt"
                                        space-before="8pt"
                                        space-after="5pt">
                                 <fo:list-block provisional-distance-between-starts="1in"
                                                provisional-label-separation="0.090in">
                                    <fo:list-item>
                                       <fo:list-item-label end-indent="label-end()" text-align="start">
                                          <fo:block>122.1.1</fo:block>
                                       </fo:list-item-label>
                                       <fo:list-item-body start-indent="body-start()">
                                          <fo:block>Essentials</fo:block>
                                       </fo:list-item-body>
                                    </fo:list-item>
                                 </fo:list-block>
                              </fo:block>
                           </fo:block>
                        </fo:block>
                     </fo:block>
                  </fo:block>
               </fo:block>
               <fo:list-block space-before.optimum="1em"
                              space-before.minimum="0.8em"
                              space-before.maximum="1.2em"
                              space-after.optimum="1em"
                              space-after.minimum="0.8em"
                              space-after.maximum="1.2em"
                              provisional-label-separation="0.2em"
                              provisional-distance-between-starts="12pt"
                              id="d61e110">
                  <fo:list-item space-before.optimum="2pt"
                                space-before.minimum="2pt"
                                space-before.maximum="2pt"
                                id="d61e111">
                     <fo:list-item-label end-indent="label-end()">
                        <fo:block>•</fo:block>
                     </fo:list-item-label>
                     <fo:list-item-body start-indent="body-start()">
                        <fo:block>
                           <fo:block>
                              <fo:inline font-style="italic">Simple</fo:inline> - Make it as simple as possible
          for a Topology Manager to implement distribution policies.</fo:block>
                        </fo:block>
                     </fo:list-item-body>
                  </fo:list-item>
                  <fo:list-item space-before.optimum="2pt"
                                space-before.minimum="2pt"
                                space-before.maximum="2pt"
                                id="d61e115">
                     <fo:list-item-label end-indent="label-end()">
                        <fo:block>•</fo:block>
                     </fo:list-item-label>
                     <fo:list-item-body start-indent="body-start()">
                        <fo:block>
                           <fo:block>
                              <fo:inline font-style="italic">Dynamic</fo:inline> - Discover available Endpoints
          dynamically, for example through a discovery protocol like <fo:basic-link xmlns:d="http://docbook.org/ns/docbook"
                                             xmlns:xlink="http://www.w3.org/1999/xlink"
                                             internal-destination="i1788834">
                                 <fo:inline color="inherit"
                                            font-family="inherit"
                                            letter-spacing="inherit"
                                            hyphenate="inherit">[3] <fo:inline font-style="italic">Service Location Protocol (SLP)</fo:inline>
                                 </fo:inline>
                              </fo:basic-link> or <fo:basic-link xmlns:d="http://docbook.org/ns/docbook"
                                             xmlns:xlink="http://www.w3.org/1999/xlink"
                                             internal-destination="i1789952">
                                 <fo:inline color="inherit"
                                            font-family="inherit"
                                            letter-spacing="inherit"
                                            hyphenate="inherit">[4] <fo:inline font-style="italic">JGroups</fo:inline>
                                 </fo:inline>
                              </fo:basic-link>.</fo:block>
                        </fo:block>
                     </fo:list-item-body>
                  </fo:list-item>
                  <fo:list-item space-before.optimum="2pt"
                                space-before.minimum="2pt"
                                space-before.maximum="2pt"
                                id="d61e123">
                     <fo:list-item-label end-indent="label-end()">
                        <fo:block>•</fo:block>
                     </fo:list-item-label>
                     <fo:list-item-body start-indent="body-start()">
                        <fo:block>
                           <fo:block>
                              <fo:inline font-style="italic">Inform</fo:inline> - Provide a mechanism to inform
          other parties about created and removed Endpoints.</fo:block>
                        </fo:block>
                     </fo:list-item-body>
                  </fo:list-item>
                  <fo:list-item space-before.optimum="2pt"
                                space-before.minimum="2pt"
                                space-before.maximum="2pt"
                                id="d61e127">
                     <fo:list-item-label end-indent="label-end()">
                        <fo:block>•</fo:block>
                     </fo:list-item-label>
                     <fo:list-item-body start-indent="body-start()">
                        <fo:block>
                           <fo:block>
                              <fo:inline font-style="italic">Configuration</fo:inline> - Allow bundles to describe
          Endpoints as a bundle resource that are provided to the Distribution
          Provider.</fo:block>
                        </fo:block>
                     </fo:list-item-body>
                  </fo:list-item>
                  <fo:list-item space-before.optimum="2pt"
                                space-before.minimum="2pt"
                                space-before.maximum="2pt"
                                id="d61e131">
                     <fo:list-item-label end-indent="label-end()">
                        <fo:block>•</fo:block>
                     </fo:list-item-label>
                     <fo:list-item-body start-indent="body-start()">
                        <fo:block>
                           <fo:block>
                              <fo:inline font-style="italic">Selective</fo:inline> - Not all parties are
          interested in all services. Endpoint registries must be able to
          express the scope of services they are interested in.</fo:block>
                        </fo:block>
                     </fo:list-item-body>
                  </fo:list-item>
                  <fo:list-item space-before.optimum="2pt"
                                space-before.minimum="2pt"
                                space-before.maximum="2pt"
                                id="d61e135">
                     <fo:list-item-label end-indent="label-end()">
                        <fo:block>•</fo:block>
                     </fo:list-item-label>
                     <fo:list-item-body start-indent="body-start()">
                        <fo:block>
                           <fo:block>
                              <fo:inline font-style="italic">Multiple</fo:inline> - Allow the collaboration of
          multiple Topology Managers, Remote Service Admin services, and
          Discovery Providers.</fo:block>
                        </fo:block>
                     </fo:list-item-body>
                  </fo:list-item>
                  <fo:list-item space-before.optimum="2pt"
                                space-before.minimum="2pt"
                                space-before.maximum="2pt"
                                id="d61e139">
                     <fo:list-item-label end-indent="label-end()">
                        <fo:block>•</fo:block>
                     </fo:list-item-label>
                     <fo:list-item-body start-indent="body-start()">
                        <fo:block>
                           <fo:block>
                              <fo:inline font-style="italic">Dynamic</fo:inline> - Allow the dynamic discovery of
          Endpoints.</fo:block>
                        </fo:block>
                     </fo:list-item-body>
                  </fo:list-item>
                  <fo:list-item space-before.optimum="2pt"
                                space-before.minimum="2pt"
                                space-before.maximum="2pt"
                                id="d61e143">
                     <fo:list-item-label end-indent="label-end()">
                        <fo:block>•</fo:block>
                     </fo:list-item-label>
                     <fo:list-item-body start-indent="body-start()">
                        <fo:block>
                           <fo:block>
                              <fo:inline font-style="italic">Federated</fo:inline> - Enable a global view of all
          available services in a distributed environment.</fo:block>
                        </fo:block>
                     </fo:list-item-body>
                  </fo:list-item>
               </fo:list-block>
            </fo:block>
            <fo:block id="d61e147">
               <fo:block>
                  <fo:block>
                     <fo:block keep-together.within-column="always"
                               margin-left="0pt"
                               font-family="ProductusSemibold,ArialUnicodeMS">
                        <fo:block keep-with-next.within-column="always">
                           <fo:block xmlns:d="http://docbook.org/ns/docbook"
                                     xmlns:xlink="http://www.w3.org/1999/xlink"
                                     font-family="ProductusSemibold,ArialUnicodeMS"
                                     font-weight="normal"
                                     keep-with-next.within-column="always"
                                     space-before.minimum="0.8em"
                                     space-before.optimum="1.0em"
                                     space-before.maximum="1.2em"
                                     text-align="start"
                                     start-indent="0pt"
                                     hyphenate="false">
                              <fo:block font-size="12pt"
                                        line-height="14pt"
                                        space-before="8pt"
                                        space-after="5pt">
                                 <fo:list-block provisional-distance-between-starts="1in"
                                                provisional-label-separation="0.090in">
                                    <fo:list-item>
                                       <fo:list-item-label end-indent="label-end()" text-align="start">
                                          <fo:block>122.1.2</fo:block>
                                       </fo:list-item-label>
                                       <fo:list-item-body start-indent="body-start()">
                                          <fo:block>Entities</fo:block>
                                       </fo:list-item-body>
                                    </fo:list-item>
                                 </fo:list-block>
                              </fo:block>
                           </fo:block>
                        </fo:block>
                     </fo:block>
                  </fo:block>
               </fo:block>
               <fo:list-block space-before.optimum="1em"
                              space-before.minimum="0.8em"
                              space-before.maximum="1.2em"
                              space-after.optimum="1em"
                              space-after.minimum="0.8em"
                              space-after.maximum="1.2em"
                              provisional-label-separation="0.2em"
                              provisional-distance-between-starts="12pt"
                              id="d61e149">
                  <fo:list-item space-before.optimum="2pt"
                                space-before.minimum="2pt"
                                space-before.maximum="2pt"
                                id="d61e150">
                     <fo:list-item-label end-indent="label-end()">
                        <fo:block>•</fo:block>
                     </fo:list-item-label>
                     <fo:list-item-body start-indent="body-start()">
                        <fo:block>
                           <fo:block>
                              <fo:inline font-style="italic">Remote Service Admin</fo:inline> - An implementation
          of this specification provides the mechanisms to import and export
          services through a set of configuration types. The Remote Service
          Admin service is a passive Distribution Provider, not taking any
          action to export or import itself.</fo:block>
                        </fo:block>
                     </fo:list-item-body>
                  </fo:list-item>
                  <fo:list-item space-before.optimum="2pt"
                                space-before.minimum="2pt"
                                space-before.maximum="2pt"
                                id="d61e154">
                     <fo:list-item-label end-indent="label-end()">
                        <fo:block>•</fo:block>
                     </fo:list-item-label>
                     <fo:list-item-body start-indent="body-start()">
                        <fo:block>
                           <fo:block>
                              <fo:inline font-style="italic">Topology Manager</fo:inline> - The Topology Manager
          provides the policy for importing and exporting services through the
          Remote Service Admin service.</fo:block>
                        </fo:block>
                     </fo:list-item-body>
                  </fo:list-item>
                  <fo:list-item space-before.optimum="2pt"
                                space-before.minimum="2pt"
                                space-before.maximum="2pt"
                                id="d61e158">
                     <fo:list-item-label end-indent="label-end()">
                        <fo:block>•</fo:block>
                     </fo:list-item-label>
                     <fo:list-item-body start-indent="body-start()">
                        <fo:block>
                           <fo:block>
                              <fo:inline font-style="italic">Endpoint</fo:inline> - An Endpoint is a
          communications access mechanism to a service in another framework, a
          (web) service, another process, or a queue or topic destination,
          etc., requiring some protocol for communications.</fo:block>
                        </fo:block>
                     </fo:list-item-body>
                  </fo:list-item>
                  <fo:list-item space-before.optimum="2pt"
                                space-before.minimum="2pt"
                                space-before.maximum="2pt"
                                id="d61e162">
                     <fo:list-item-label end-indent="label-end()">
                        <fo:block>•</fo:block>
                     </fo:list-item-label>
                     <fo:list-item-body start-indent="body-start()">
                        <fo:block>
                           <fo:block>
                              <fo:inline font-style="italic">Endpoint Description</fo:inline> - A properties based
          description of an Endpoint. Endpoint Descriptions can be exchanged
          between different frameworks to create connections to each other's
          services. Endpoint Descriptions can also be created to Endpoints not
          originating in an OSGi Framework.</fo:block>
                        </fo:block>
                     </fo:list-item-body>
                  </fo:list-item>
                  <fo:list-item space-before.optimum="2pt"
                                space-before.minimum="2pt"
                                space-before.maximum="2pt"
                                id="d61e166">
                     <fo:list-item-label end-indent="label-end()">
                        <fo:block>•</fo:block>
                     </fo:list-item-label>
                     <fo:list-item-body start-indent="body-start()">
                        <fo:block>
                           <fo:block>
                              <fo:inline font-style="italic">Endpoint Description Provider</fo:inline> - A party
          that can inform others about the existence of Endpoints.</fo:block>
                        </fo:block>
                     </fo:list-item-body>
                  </fo:list-item>
                  <fo:list-item space-before.optimum="2pt"
                                space-before.minimum="2pt"
                                space-before.maximum="2pt"
                                id="d61e170">
                     <fo:list-item-label end-indent="label-end()">
                        <fo:block>•</fo:block>
                     </fo:list-item-label>
                     <fo:list-item-body start-indent="body-start()">
                        <fo:block>
                           <fo:block>
                              <fo:inline font-style="italic">Endpoint Event Listener</fo:inline> – A listener
          service that receives events relating to Endpoints that match its
          scope. This Endpoint Event Listener is used symmetrically to
          implement a federated registry. The Topology Manager can use it to
          notify interested parties about created and removed Endpoints, as
          well as to receive notifications from other parties, potentially
          remote, about their available Endpoints.</fo:block>
                        </fo:block>
                     </fo:list-item-body>
                  </fo:list-item>
                  <fo:list-item space-before.optimum="2pt"
                                space-before.minimum="2pt"
                                space-before.maximum="2pt"
                                id="d61e174">
                     <fo:list-item-label end-indent="label-end()">
                        <fo:block>•</fo:block>
                     </fo:list-item-label>
                     <fo:list-item-body start-indent="body-start()">
                        <fo:block>
                           <fo:block>
                              <fo:inline font-style="italic">Endpoint Listener</fo:inline> – An older version of
          the Endpoint Event Listener defined by version <fo:inline font-family="ProductusOSGiBookc,ArialUnicodeMS"
                                         font-size="9pt"
                                         letter-spacing="0.08em">1.0</fo:inline> of
          this specification. The Endpoint Event Listener supersedes the
          Endpoint Listener, and should be used in preference where
          possible.</fo:block>
                        </fo:block>
                     </fo:list-item-body>
                  </fo:list-item>
                  <fo:list-item space-before.optimum="2pt"
                                space-before.minimum="2pt"
                                space-before.maximum="2pt"
                                id="d61e180">
                     <fo:list-item-label end-indent="label-end()">
                        <fo:block>•</fo:block>
                     </fo:list-item-label>
                     <fo:list-item-body start-indent="body-start()">
                        <fo:block>
                           <fo:block>
                              <fo:inline font-style="italic">Remote Service Admin Listener</fo:inline> - A
          listener service that is informed of all the primitive actions that
          the Remote Service Admin performs like importing and exporting as
          well as errors.</fo:block>
                        </fo:block>
                     </fo:list-item-body>
                  </fo:list-item>
                  <fo:list-item space-before.optimum="2pt"
                                space-before.minimum="2pt"
                                space-before.maximum="2pt"
                                id="d61e184">
                     <fo:list-item-label end-indent="label-end()">
                        <fo:block>•</fo:block>
                     </fo:list-item-label>
                     <fo:list-item-body start-indent="body-start()">
                        <fo:block>
                           <fo:block>
                              <fo:inline font-style="italic">Endpoint Configuration Extender</fo:inline> - A
          bundle that can detect configuration data describing an Endpoint
          Description in a bundle resource, using the extender pattern.</fo:block>
                        </fo:block>
                     </fo:list-item-body>
                  </fo:list-item>
                  <fo:list-item space-before.optimum="2pt"
                                space-before.minimum="2pt"
                                space-before.maximum="2pt"
                                id="d61e188">
                     <fo:list-item-label end-indent="label-end()">
                        <fo:block>•</fo:block>
                     </fo:list-item-label>
                     <fo:list-item-body start-indent="body-start()">
                        <fo:block>
                           <fo:block>
                              <fo:inline font-style="italic">Discovery</fo:inline> – An Endpoint Event Listener
          that detects the Endpoint Descriptions through some discovery
          protocol.</fo:block>
                        </fo:block>
                     </fo:list-item-body>
                  </fo:list-item>
                  <fo:list-item space-before.optimum="2pt"
                                space-before.minimum="2pt"
                                space-before.maximum="2pt"
                                id="d61e192">
                     <fo:list-item-label end-indent="label-end()">
                        <fo:block>•</fo:block>
                     </fo:list-item-label>
                     <fo:list-item-body start-indent="body-start()">
                        <fo:block>
                           <fo:block>
                              <fo:inline font-style="italic">Cluster</fo:inline> - A group of computing systems
          that closely work together, usually in a fast network.</fo:block>
                        </fo:block>
                     </fo:list-item-body>
                  </fo:list-item>
               </fo:list-block>
               <fo:block start-indent="0pt">
                  <fo:block space-before.minimum="0.5em"
                            space-before.optimum="1em"
                            space-before.maximum="2em"
                            space-after.minimum="0.5em"
                            space-after.optimum="1em"
                            space-after.maximum="2em"
                            keep-together.within-column="always"
                            id="i1706087">
                     <fo:block xmlns:d="http://docbook.org/ns/docbook"
                               xmlns:xlink="http://www.w3.org/1999/xlink"
                               space-before.optimum="5pt"
                               space-before.minimum="5pt"
                               space-before.maximum="5pt"
                               font-weight="normal"
                               font-size="9pt"
                               hyphenate="false"
                               space-after.minimum="0.4em"
                               space-after.optimum="0.6em"
                               space-after.maximum="0.8em"
                               start-indent="0pt"
                               font-family="Proforma-Book,ArialUnicodeMS"
                               font-style="italic"
                               keep-with-next.within-column="always">
                        <fo:list-block provisional-distance-between-starts="1in"
                                       provisional-label-separation="0.090in">
                           <fo:list-item>
                              <fo:list-item-label end-indent="label-end()" text-align="start">
                                 <fo:block>Figure 122.1</fo:block>
                              </fo:list-item-label>
                              <fo:list-item-body start-indent="body-start()">
                                 <fo:block>Remote Service Admin Entities</fo:block>
                              </fo:list-item-body>
                           </fo:list-item>
                        </fo:list-block>
                     </fo:block>
                     <fo:block id="d61e198" text-align="center">
                        <fo:external-graphic src="url(file:///home/stbischof/git/OSGI_MIGRATE/osgi_target/org.osgi.service.remoteserviceadmin/spec/org.osgi.spec.service.remoteserviceadmin/src/main/resources/spec/rsa-classes.svg)"
                                             width="auto"
                                             height="auto"
                                             content-width="7.000in"
                                             content-height="2.570in"
                                             text-align="center"/>
                     </fo:block>
                  </fo:block>
               </fo:block>
            </fo:block>
            <fo:block id="d61e201">
               <fo:block>
                  <fo:block>
                     <fo:block keep-together.within-column="always"
                               margin-left="0pt"
                               font-family="ProductusSemibold,ArialUnicodeMS">
                        <fo:block keep-with-next.within-column="always">
                           <fo:block xmlns:d="http://docbook.org/ns/docbook"
                                     xmlns:xlink="http://www.w3.org/1999/xlink"
                                     font-family="ProductusSemibold,ArialUnicodeMS"
                                     font-weight="normal"
                                     keep-with-next.within-column="always"
                                     space-before.minimum="0.8em"
                                     space-before.optimum="1.0em"
                                     space-before.maximum="1.2em"
                                     text-align="start"
                                     start-indent="0pt"
                                     hyphenate="false">
                              <fo:block font-size="12pt"
                                        line-height="14pt"
                                        space-before="8pt"
                                        space-after="5pt">
                                 <fo:list-block provisional-distance-between-starts="1in"
                                                provisional-label-separation="0.090in">
                                    <fo:list-item>
                                       <fo:list-item-label end-indent="label-end()" text-align="start">
                                          <fo:block>122.1.3</fo:block>
                                       </fo:list-item-label>
                                       <fo:list-item-body start-indent="body-start()">
                                          <fo:block>Synopsis</fo:block>
                                       </fo:list-item-body>
                                    </fo:list-item>
                                 </fo:list-block>
                              </fo:block>
                           </fo:block>
                        </fo:block>
                     </fo:block>
                  </fo:block>
               </fo:block>
               <fo:block space-before.optimum="5pt"
                         space-before.minimum="5pt"
                         space-before.maximum="5pt">Topology Managers are responsible for the distribution policies of
      a OSGi framework. To implement a policy, a Topology Manager must be
      aware of the environment, for this reason, it can register:</fo:block>
               <fo:list-block space-before.optimum="1em"
                              space-before.minimum="0.8em"
                              space-before.maximum="1.2em"
                              space-after.optimum="1em"
                              space-after.minimum="0.8em"
                              space-after.maximum="1.2em"
                              provisional-label-separation="0.2em"
                              provisional-distance-between-starts="12pt"
                              id="d61e204">
                  <fo:list-item space-before.optimum="2pt"
                                space-before.minimum="2pt"
                                space-before.maximum="2pt"
                                id="d61e205">
                     <fo:list-item-label end-indent="label-end()">
                        <fo:block>•</fo:block>
                     </fo:list-item-label>
                     <fo:list-item-body start-indent="body-start()">
                        <fo:block>
                           <fo:block>Service listeners to detect services that can be exported
          according to the Remote Services chapter.</fo:block>
                        </fo:block>
                     </fo:list-item-body>
                  </fo:list-item>
                  <fo:list-item space-before.optimum="2pt"
                                space-before.minimum="2pt"
                                space-before.maximum="2pt"
                                id="d61e207">
                     <fo:list-item-label end-indent="label-end()">
                        <fo:block>•</fo:block>
                     </fo:list-item-label>
                     <fo:list-item-body start-indent="body-start()">
                        <fo:block>
                           <fo:block>Listener and Find Hook services to detect bundles that have an
          interest in specific services that potentially could be
          imported.</fo:block>
                        </fo:block>
                     </fo:list-item-body>
                  </fo:list-item>
                  <fo:list-item space-before.optimum="2pt"
                                space-before.minimum="2pt"
                                space-before.maximum="2pt"
                                id="d61e209">
                     <fo:list-item-label end-indent="label-end()">
                        <fo:block>•</fo:block>
                     </fo:list-item-label>
                     <fo:list-item-body start-indent="body-start()">
                        <fo:block>
                           <fo:block>A Remote Service Admin Listener service to detect the activity
          of other Topology Managers.</fo:block>
                        </fo:block>
                     </fo:list-item-body>
                  </fo:list-item>
                  <fo:list-item space-before.optimum="2pt"
                                space-before.minimum="2pt"
                                space-before.maximum="2pt"
                                id="d61e211">
                     <fo:list-item-label end-indent="label-end()">
                        <fo:block>•</fo:block>
                     </fo:list-item-label>
                     <fo:list-item-body start-indent="body-start()">
                        <fo:block>
                           <fo:block>Endpoint Event Listener and Endpoint Listener services to
          detect Endpoints that are made available through discovery
          protocols, configuration data, or other means.</fo:block>
                        </fo:block>
                     </fo:list-item-body>
                  </fo:list-item>
               </fo:list-block>
               <fo:block space-before.optimum="5pt"
                         space-before.minimum="5pt"
                         space-before.maximum="5pt">Using this information, the manager implements a topology using
      the Remote Service Admin service. A Topology Manager that wants to
      export a service can create an <fo:inline font-style="italic">Export Registration</fo:inline>
      by providing one or more Remote Service Admin services a Service
      Reference plus a Map with the required properties. A Remote Service
      Admin service then creates a number of Endpoints based on the available
      configuration types and returns a collection of
      <fo:inline font-family="ProductusOSGiBookc,ArialUnicodeMS"
                             font-size="9pt"
                             letter-spacing="0.08em">ExportRegistration</fo:inline> objects. A collection is returned
      because a single service can be exported to multiple Endpoints depending
      on the available configuration type properties.</fo:block>
               <fo:block space-before.optimum="5pt"
                         space-before.minimum="5pt"
                         space-before.maximum="5pt">Each Export Registration is specific for the caller and represents
      an existing or newly created Endpoint. The Export Registration
      associates the exported Service Reference with an <fo:inline font-style="italic">Endpoint
      Description</fo:inline>. If there are problems with the export operation,
      the Remote Service Admin service reports these on the Export
      Registration objects. That is, not all the returned Export Registrations
      have to be valid.</fo:block>
               <fo:block space-before.optimum="5pt"
                         space-before.minimum="5pt"
                         space-before.maximum="5pt">An Endpoint Description is a property based description of an
      Endpoint. Some of these properties are defined in this specification,
      other properties are defined by configuration types. These configuration
      types must follow the same rules as the configuration types defined in
      the Remote Services chapter. Remote Service Admin services that support
      the configuration types in the Endpoint Description can import a service
      from that Endpoint solely based on that Endpoint Description.</fo:block>
               <fo:block space-before.optimum="5pt"
                         space-before.minimum="5pt"
                         space-before.maximum="5pt">In similar vein, the Topology Manager can import a service from a
      remote system by creating an Import Registration out of an Endpoint
      Description. The Remote Service Admin service then registers a service
      that is a proxy for the remote Endpoint and returns an
      <fo:inline font-family="ProductusOSGiBookc,ArialUnicodeMS"
                             font-size="9pt"
                             letter-spacing="0.08em">ImportRegistration</fo:inline> object. If there are problems with the
      import, the Remote Service Admin service that cannot be detected early,
      then the Remote Service Admin service reports these on the returned
      <fo:inline font-family="ProductusOSGiBookc,ArialUnicodeMS"
                             font-size="9pt"
                             letter-spacing="0.08em">ImportRegistration</fo:inline> object.</fo:block>
               <fo:block space-before.optimum="5pt"
                         space-before.minimum="5pt"
                         space-before.maximum="5pt">For introspection, the Remote Service Admin can list its current
      set of Import and Export References so that a Topology Manager can get
      the current state. The Remote Service Admin service also informs all
      Topology Managers and observers of the creation, deletion, and errors of
      Import and Export Registrations through the Remote Service Admin
      Listener service. Interested parties like the Topology Manager can
      register such a service and will be called back with the initial state
      as well as any subsequent changes.</fo:block>
               <fo:block space-before.optimum="5pt"
                         space-before.minimum="5pt"
                         space-before.maximum="5pt">An important aspect of the Topology Manager is the distributed
      nature of the scenarios it plays an orchestrating role in. A Topology
      Manager needs to be aware of Endpoints in the network, not just the ones
      provided by Remote Service Admin services in its local framework. The
      Endpoint Event Listener service is specified for this purpose. This
      service is provided for both directions, symmetrically. That is, it is
      used by the Topology Manager to inform any observers about the existence
      of Endpoints that are locally available, as well as for parties that
      represent a discovery mechanism. For example Endpoints available on
      other systems, Endpoint Descriptions embedded in resources in bundles,
      or Endpoint Descriptions that are available in some other form.</fo:block>
               <fo:block space-before.optimum="5pt"
                         space-before.minimum="5pt"
                         space-before.maximum="5pt">Endpoint Event Listener services are not always interested in the
      complete set of available Endpoints because this set can potentially be
      very large. For example, if a remote registry like <fo:basic-link xmlns:d="http://docbook.org/ns/docbook"
                                 xmlns:xlink="http://www.w3.org/1999/xlink"
                                 internal-destination="i1789020">
                     <fo:inline color="inherit"
                                font-family="inherit"
                                letter-spacing="inherit"
                                hyphenate="inherit">[5] <fo:inline font-style="italic">UDDI</fo:inline>
                     </fo:inline>
                  </fo:basic-link> is used then the number of Endpoints can run into
      the thousands or more. An Endpoint Event Listener service can therefore
      scope the set of Endpoints with an OSGi LDAP style filter. Parties that
      can provide information about Endpoints must only notify Endpoint Event
      Listener services when the Endpoint Description falls within the scope
      of the Endpoint Listener service. Parties that use some discovery
      mechanism can use the scope to trigger directed searches across the
      network.</fo:block>
               <fo:block id="d61e236">
                  <fo:block>
                     <fo:block>
                        <fo:block keep-together.within-column="always"
                                  margin-left="0pt"
                                  font-family="ProductusSemibold,ArialUnicodeMS">
                           <fo:block keep-with-next.within-column="always">
                              <fo:block xmlns:d="http://docbook.org/ns/docbook"
                                        xmlns:xlink="http://www.w3.org/1999/xlink"
                                        font-family="ProductusSemibold,ArialUnicodeMS"
                                        font-weight="normal"
                                        keep-with-next.within-column="always"
                                        space-before.minimum="0.8em"
                                        space-before.optimum="1.0em"
                                        space-before.maximum="1.2em"
                                        text-align="start"
                                        start-indent="0pt"
                                        hyphenate="false">
                                 <fo:block font-size="9pt"
                                           line-height="11pt"
                                           space-before="5pt"
                                           space-after="5pt">
                                    <fo:list-block provisional-distance-between-starts="1in"
                                                   provisional-label-separation="0.090in">
                                       <fo:list-item>
                                          <fo:list-item-label end-indent="label-end()" text-align="start">
                                             <fo:block>122.1.3.1</fo:block>
                                          </fo:list-item-label>
                                          <fo:list-item-body start-indent="body-start()">
                                             <fo:block>Endpoint Listener Services</fo:block>
                                          </fo:list-item-body>
                                       </fo:list-item>
                                    </fo:list-block>
                                 </fo:block>
                              </fo:block>
                           </fo:block>
                        </fo:block>
                     </fo:block>
                  </fo:block>
                  <fo:block space-before.optimum="5pt"
                            space-before.minimum="5pt"
                            space-before.maximum="5pt">The <fo:inline font-family="ProductusOSGiBookc,ArialUnicodeMS"
                                font-size="9pt"
                                letter-spacing="0.08em">1.0</fo:inline> version of this specification defined an
        Endpoint Listener service, which has an identical purpose and similar
        behaviors to an Endpoint Event Listener service. Unfortunately the
        design of the Endpoint Listener limited its extensibility, meaning
        that it had to be replaced in version <fo:inline font-family="ProductusOSGiBookc,ArialUnicodeMS"
                                font-size="9pt"
                                letter-spacing="0.08em">1.1</fo:inline> of this
        specification.</fo:block>
                  <fo:block space-before.optimum="5pt"
                            space-before.minimum="5pt"
                            space-before.maximum="5pt">In order to maintain backward compatible interoperability with
        Remote Service Admin <fo:inline font-family="ProductusOSGiBookc,ArialUnicodeMS"
                                font-size="9pt"
                                letter-spacing="0.08em">1.0</fo:inline> actors, Remote Service Admin
        <fo:inline font-family="ProductusOSGiBookc,ArialUnicodeMS"
                                font-size="9pt"
                                letter-spacing="0.08em">1.1</fo:inline> actors must continue to register Endpoint Listener
        services as well as Endpoint Event Listener services. They must also
        continue to call Endpoint Listener services as well as
        EndpointEventListener services.</fo:block>
               </fo:block>
            </fo:block>
         </fo:block>
         <fo:block id="d61e250">
            <fo:block>
               <fo:block>
                  <fo:block keep-together.within-column="always"
                            margin-left="0pt"
                            font-family="ProductusSemibold,ArialUnicodeMS">
                     <fo:block keep-with-next.within-column="always">
                        <fo:block xmlns:d="http://docbook.org/ns/docbook"
                                  xmlns:xlink="http://www.w3.org/1999/xlink"
                                  font-family="ProductusSemibold,ArialUnicodeMS"
                                  font-weight="normal"
                                  keep-with-next.within-column="always"
                                  space-before.minimum="0.8em"
                                  space-before.optimum="1.0em"
                                  space-before.maximum="1.2em"
                                  text-align="start"
                                  start-indent="0pt"
                                  hyphenate="false">
                           <fo:marker marker-class-name="section.head.marker">Actors</fo:marker>
                           <fo:block font-size="18pt"
                                     line-height="25pt"
                                     space-before="12.5pt"
                                     space-after="12pt">
                              <fo:list-block provisional-distance-between-starts="1in"
                                             provisional-label-separation="0.090in">
                                 <fo:list-item>
                                    <fo:list-item-label end-indent="label-end()" text-align="start">
                                       <fo:block>122.2</fo:block>
                                    </fo:list-item-label>
                                    <fo:list-item-body start-indent="body-start()">
                                       <fo:block>Actors</fo:block>
                                    </fo:list-item-body>
                                 </fo:list-item>
                              </fo:list-block>
                           </fo:block>
                        </fo:block>
                     </fo:block>
                  </fo:block>
               </fo:block>
            </fo:block>
            <fo:block space-before.optimum="5pt"
                      space-before.minimum="5pt"
                      space-before.maximum="5pt">The OSGi Remote Services specification is about the distribution of
    services. This specification does not outline the details of how the
    distribution provider knows the desired topology, this policy aspect is
    left up to implementations. In many situations, this is a desirable
    architecture because it provides freedom of implementation to the
    distribution provider. However, such an architecture does not enable a
    separation of the mechanisms and <fo:inline font-style="italic">policy</fo:inline>. Therefore,
    this Remote Service Admin specification provides an architecture that
    enables a separate bundle from the distribution provider to define the
    topology. It splits the responsibility of the Remote Service specification
    in a number of <fo:inline font-style="italic">roles</fo:inline>. These roles can all have
    different implementations but they can collaborate through the services
    defined in this specification. These roles are:</fo:block>
            <fo:list-block space-before.optimum="1em"
                           space-before.minimum="0.8em"
                           space-before.maximum="1.2em"
                           space-after.optimum="1em"
                           space-after.minimum="0.8em"
                           space-after.maximum="1.2em"
                           provisional-label-separation="0.2em"
                           provisional-distance-between-starts="12pt"
                           id="d61e258">
               <fo:list-item space-before.optimum="2pt"
                             space-before.minimum="2pt"
                             space-before.maximum="2pt"
                             id="d61e259">
                  <fo:list-item-label end-indent="label-end()">
                     <fo:block>•</fo:block>
                  </fo:list-item-label>
                  <fo:list-item-body start-indent="body-start()">
                     <fo:block>
                        <fo:block>
                           <fo:inline font-style="italic">Topology Manager</fo:inline>s - Topology Managers are
        the (anonymous) players that implement the policies for distributing
        services; they are closely aligned with the concept of an OSGi
        <fo:inline font-style="italic">management agent</fo:inline>. It is expected that Topology
        Managers will be developed for scenarios like import/export all
        applicable services, configuration based imports- and exports, and
        scenarios like fail-over, load-balancing, as well as standards like
        domain managers for the <fo:basic-link xmlns:d="http://docbook.org/ns/docbook"
                                          xmlns:xlink="http://www.w3.org/1999/xlink"
                                          internal-destination="i1789031">
                              <fo:inline color="inherit"
                                         font-family="inherit"
                                         letter-spacing="inherit"
                                         hyphenate="inherit">[6] <fo:inline font-style="italic">Service Component Architecture (SCA)</fo:inline>
                              </fo:inline>
                           </fo:basic-link>.</fo:block>
                     </fo:block>
                  </fo:list-item-body>
               </fo:list-item>
               <fo:list-item space-before.optimum="2pt"
                             space-before.minimum="2pt"
                             space-before.maximum="2pt"
                             id="d61e267">
                  <fo:list-item-label end-indent="label-end()">
                     <fo:block>•</fo:block>
                  </fo:list-item-label>
                  <fo:list-item-body start-indent="body-start()">
                     <fo:block>
                        <fo:block>
                           <fo:inline font-style="italic">Remote Service Admin</fo:inline> - The Remote Service
        Admin service provides the basic mechanism to import and export
        services. This service is policy free; it will not distribute services
        without explicitly being told so. A OSGi framework can host multiple
        Remote Service Admin services that, for example, support different
        configuration types.</fo:block>
                     </fo:block>
                  </fo:list-item-body>
               </fo:list-item>
               <fo:list-item space-before.optimum="2pt"
                             space-before.minimum="2pt"
                             space-before.maximum="2pt"
                             id="d61e271">
                  <fo:list-item-label end-indent="label-end()">
                     <fo:block>•</fo:block>
                  </fo:list-item-label>
                  <fo:list-item-body start-indent="body-start()">
                     <fo:block>
                        <fo:block>
                           <fo:inline font-style="italic">Discovery</fo:inline> - To implement a distribution
        policy, a Topology Manager must be aware of what Endpoints are
        available. This specification provides an abstraction of a
        <fo:inline font-style="italic">federated Endpoint registry</fo:inline>. This registry can be
        used to both publish as well as consume Endpoints from many different
        sources. The federated registry is defined for local services but is
        intended to be used with standard and proprietary service discovery
        protocols. The federated registry is implemented with the Endpoint
        Event Listener service.</fo:block>
                     </fo:block>
                  </fo:list-item-body>
               </fo:list-item>
            </fo:list-block>
            <fo:block space-before.optimum="5pt"
                      space-before.minimum="5pt"
                      space-before.maximum="5pt">These roles are depicted in <fo:basic-link xmlns:d="http://docbook.org/ns/docbook"
                              xmlns:xlink="http://www.w3.org/1999/xlink"
                              internal-destination="i1817848">
                  <fo:inline color="inherit"
                             font-family="inherit"
                             letter-spacing="inherit"
                             hyphenate="inherit">Figure 122.2 on page <fo:page-number-citation ref-id="i1817848"/>
                  </fo:inline>
               </fo:basic-link>.</fo:block>
            <fo:block space-before.minimum="0.5em"
                      space-before.optimum="1em"
                      space-before.maximum="2em"
                      space-after.minimum="0.5em"
                      space-after.optimum="1em"
                      space-after.maximum="2em"
                      keep-together.within-column="always"
                      id="i1817848">
               <fo:block xmlns:d="http://docbook.org/ns/docbook"
                         xmlns:xlink="http://www.w3.org/1999/xlink"
                         space-before.optimum="5pt"
                         space-before.minimum="5pt"
                         space-before.maximum="5pt"
                         font-weight="normal"
                         font-size="9pt"
                         hyphenate="false"
                         space-after.minimum="0.4em"
                         space-after.optimum="0.6em"
                         space-after.maximum="0.8em"
                         start-indent="0pt"
                         font-family="Proforma-Book,ArialUnicodeMS"
                         font-style="italic"
                         keep-with-next.within-column="always">
                  <fo:list-block provisional-distance-between-starts="1in"
                                 provisional-label-separation="0.090in">
                     <fo:list-item>
                        <fo:list-item-label end-indent="label-end()" text-align="start">
                           <fo:block>Figure 122.2</fo:block>
                        </fo:list-item-label>
                        <fo:list-item-body start-indent="body-start()">
                           <fo:block>Roles</fo:block>
                        </fo:list-item-body>
                     </fo:list-item>
                  </fo:list-block>
               </fo:block>
               <fo:block id="d61e283" text-align="center">
                  <fo:external-graphic src="url(file:///home/stbischof/git/OSGI_MIGRATE/osgi_target/org.osgi.service.remoteserviceadmin/spec/org.osgi.spec.service.remoteserviceadmin/src/main/resources/spec/roles.svg)"
                                       width="auto"
                                       height="auto"
                                       content-width="6.240in"
                                       content-height="1.194in"
                                       text-align="center"/>
               </fo:block>
            </fo:block>
         </fo:block>
         <fo:block id="d61e286">
            <fo:block>
               <fo:block>
                  <fo:block keep-together.within-column="always"
                            margin-left="0pt"
                            font-family="ProductusSemibold,ArialUnicodeMS">
                     <fo:block keep-with-next.within-column="always">
                        <fo:block xmlns:d="http://docbook.org/ns/docbook"
                                  xmlns:xlink="http://www.w3.org/1999/xlink"
                                  font-family="ProductusSemibold,ArialUnicodeMS"
                                  font-weight="normal"
                                  keep-with-next.within-column="always"
                                  space-before.minimum="0.8em"
                                  space-before.optimum="1.0em"
                                  space-before.maximum="1.2em"
                                  text-align="start"
                                  start-indent="0pt"
                                  hyphenate="false">
                           <fo:marker marker-class-name="section.head.marker">Topology Managers</fo:marker>
                           <fo:block font-size="18pt"
                                     line-height="25pt"
                                     space-before="12.5pt"
                                     space-after="12pt">
                              <fo:list-block provisional-distance-between-starts="1in"
                                             provisional-label-separation="0.090in">
                                 <fo:list-item>
                                    <fo:list-item-label end-indent="label-end()" text-align="start">
                                       <fo:block>122.3</fo:block>
                                    </fo:list-item-label>
                                    <fo:list-item-body start-indent="body-start()">
                                       <fo:block>Topology Managers</fo:block>
                                    </fo:list-item-body>
                                 </fo:list-item>
                              </fo:list-block>
                           </fo:block>
                        </fo:block>
                     </fo:block>
                  </fo:block>
               </fo:block>
            </fo:block>
            <fo:block space-before.optimum="5pt"
                      space-before.minimum="5pt"
                      space-before.maximum="5pt">Distributed processing has become mainstream because of the massive
    scale required for Internet applications. Only with distributed
    architectures is it possible to scale systems to <fo:inline font-style="italic">Internet
    size</fo:inline> with hundreds of millions of users. To allow a system to
    scale, servers are grouped in clusters where they can work in unison or
    geographically dispersed in even larger configurations. The distribution
    of the work-load is crucial for the amount of scalability provided by an
    architecture and often has domain specific dispatching techniques. For
    example, the hash of a user id can be used to select the correct profile
    database server. In this fast moving world it is very unlikely that a
    single architecture or distribution policy would be sufficient to satisfy
    many users. It is therefore that this specification separates the
    <fo:inline font-style="italic">how</fo:inline> from the <fo:inline font-style="italic">what</fo:inline>. The complex
    mechanics of importing and exporting services are managed by a Remote
    Service Admin service (the how) while the different policies are
    implemented by Topology Managers (the what). This separation of concerns
    enables the development of Topology Managers that can run on many
    different systems, providing high user functionality. For example, a
    Topology Manager could implement a fail-over policy where some strategic
    services are redirected when their connections fail. Other Topology
    Managers could use a discovery protocol like SLP to find out about other
    systems in a cluster and automatically configure the cluster.</fo:block>
            <fo:block space-before.optimum="5pt"
                      space-before.minimum="5pt"
                      space-before.maximum="5pt">The key value of this architecture is demonstrated by the example of
    an <fo:inline font-style="italic">SCA domain controller</fo:inline>. An SCA domain controller
    receives a description of a domain (a set of systems and modules) and must
    ensure that the proper connections are made between the participating SCA
    modules. By splitting the roles, an SCA domain manager can be developed
    that can run on any compatible Remote Service Admin service
    implementation.</fo:block>
            <fo:block id="i1812921">
               <fo:block>
                  <fo:block>
                     <fo:block keep-together.within-column="always"
                               margin-left="0pt"
                               font-family="ProductusSemibold,ArialUnicodeMS">
                        <fo:block keep-with-next.within-column="always">
                           <fo:block xmlns:d="http://docbook.org/ns/docbook"
                                     xmlns:xlink="http://www.w3.org/1999/xlink"
                                     font-family="ProductusSemibold,ArialUnicodeMS"
                                     font-weight="normal"
                                     keep-with-next.within-column="always"
                                     space-before.minimum="0.8em"
                                     space-before.optimum="1.0em"
                                     space-before.maximum="1.2em"
                                     text-align="start"
                                     start-indent="0pt"
                                     hyphenate="false">
                              <fo:block font-size="12pt"
                                        line-height="14pt"
                                        space-before="8pt"
                                        space-after="5pt">
                                 <fo:list-block provisional-distance-between-starts="1in"
                                                provisional-label-separation="0.090in">
                                    <fo:list-item>
                                       <fo:list-item-label end-indent="label-end()" text-align="start">
                                          <fo:block>122.3.1</fo:block>
                                       </fo:list-item-label>
                                       <fo:list-item-body start-indent="body-start()">
                                          <fo:block>Multiple Topology Managers</fo:block>
                                       </fo:list-item-body>
                                    </fo:list-item>
                                 </fo:list-block>
                              </fo:block>
                           </fo:block>
                        </fo:block>
                     </fo:block>
                  </fo:block>
               </fo:block>
               <fo:block space-before.optimum="5pt"
                         space-before.minimum="5pt"
                         space-before.maximum="5pt">There is no restriction on the number of Topology Managers, nor is
      there a restriction on the number of Remote Service Admin service
      implementations. It is up to the deployer of the OSGi framework to
      select the appropriate set of these service implementations. It is the
      responsibility of the Topology Managers to listen to the Remote Service
      Admin Listener and track Endpoints created and deleted by other Topology
      Managers and act appropriately.</fo:block>
            </fo:block>
            <fo:block id="service.remoteserviceadmin-example.policies">
               <fo:block>
                  <fo:block>
                     <fo:block keep-together.within-column="always"
                               margin-left="0pt"
                               font-family="ProductusSemibold,ArialUnicodeMS">
                        <fo:block keep-with-next.within-column="always">
                           <fo:block xmlns:d="http://docbook.org/ns/docbook"
                                     xmlns:xlink="http://www.w3.org/1999/xlink"
                                     font-family="ProductusSemibold,ArialUnicodeMS"
                                     font-weight="normal"
                                     keep-with-next.within-column="always"
                                     space-before.minimum="0.8em"
                                     space-before.optimum="1.0em"
                                     space-before.maximum="1.2em"
                                     text-align="start"
                                     start-indent="0pt"
                                     hyphenate="false">
                              <fo:block font-size="12pt"
                                        line-height="14pt"
                                        space-before="8pt"
                                        space-after="5pt">
                                 <fo:list-block provisional-distance-between-starts="1in"
                                                provisional-label-separation="0.090in">
                                    <fo:list-item>
                                       <fo:list-item-label end-indent="label-end()" text-align="start">
                                          <fo:block>122.3.2</fo:block>
                                       </fo:list-item-label>
                                       <fo:list-item-body start-indent="body-start()">
                                          <fo:block>Example Use Cases</fo:block>
                                       </fo:list-item-body>
                                    </fo:list-item>
                                 </fo:list-block>
                              </fo:block>
                           </fo:block>
                        </fo:block>
                     </fo:block>
                  </fo:block>
               </fo:block>
               <fo:block id="d61e305">
                  <fo:block>
                     <fo:block>
                        <fo:block keep-together.within-column="always"
                                  margin-left="0pt"
                                  font-family="ProductusSemibold,ArialUnicodeMS">
                           <fo:block keep-with-next.within-column="always">
                              <fo:block xmlns:d="http://docbook.org/ns/docbook"
                                        xmlns:xlink="http://www.w3.org/1999/xlink"
                                        font-family="ProductusSemibold,ArialUnicodeMS"
                                        font-weight="normal"
                                        keep-with-next.within-column="always"
                                        space-before.minimum="0.8em"
                                        space-before.optimum="1.0em"
                                        space-before.maximum="1.2em"
                                        text-align="start"
                                        start-indent="0pt"
                                        hyphenate="false">
                                 <fo:block font-size="9pt"
                                           line-height="11pt"
                                           space-before="5pt"
                                           space-after="5pt">
                                    <fo:list-block provisional-distance-between-starts="1in"
                                                   provisional-label-separation="0.090in">
                                       <fo:list-item>
                                          <fo:list-item-label end-indent="label-end()" text-align="start">
                                             <fo:block>122.3.2.1</fo:block>
                                          </fo:list-item-label>
                                          <fo:list-item-body start-indent="body-start()">
                                             <fo:block>Promiscuous Policy</fo:block>
                                          </fo:list-item-body>
                                       </fo:list-item>
                                    </fo:list-block>
                                 </fo:block>
                              </fo:block>
                           </fo:block>
                        </fo:block>
                     </fo:block>
                  </fo:block>
                  <fo:block space-before.optimum="5pt"
                            space-before.minimum="5pt"
                            space-before.maximum="5pt">A <fo:inline font-style="italic">cluster</fo:inline> is a set of machines that are
        connected in a network. The simplest policy for a Topology Manager is
        to share exported services in such a cluster. Such a policy is very
        easy to implement with the Remote Services Admin service. In the most
        basic form, this Topology Manager would use some multicast protocol to
        communicate with its peers. These peers would exchange
        <fo:inline font-family="ProductusOSGiBookc,ArialUnicodeMS"
                                font-size="9pt"
                                letter-spacing="0.08em">EndpointDescription</fo:inline> objects of exported services. Each
        Topology Manager would then import any exported service.</fo:block>
                  <fo:block space-before.optimum="5pt"
                            space-before.minimum="5pt"
                            space-before.maximum="5pt">This scenario can be improved by separating the promiscuous
        policy from the discovery. Instead of embedding the multicast
        protocol, a Topology manager could use the Endpoint Event Listener
        service. This service allows the discovery of remote services. At the
        same time, the Topology Manager could tell all other Endpoint Event
        Listener services about the services it has created, allowing them to
        be used by others in the network.</fo:block>
                  <fo:block space-before.optimum="5pt"
                            space-before.minimum="5pt"
                            space-before.maximum="5pt">Splitting the Topology Manager and discovery in two bundles
        allows different implementations of the discovery bundle, for example,
        to use different protocols. See <fo:basic-link xmlns:d="http://docbook.org/ns/docbook"
                                    xmlns:xlink="http://www.w3.org/1999/xlink"
                                    internal-destination="org.osgi.service.remoteserviceadmin.namespace.TopologyNamespace.PROMISCUOUS_POLICY">
                        <fo:inline color="blue"
                                   font-family="ProductusOSGiBookc,ArialUnicodeMS"
                                   letter-spacing="0.08em"
                                   hyphenate="false">PROMISCUOUS_POLICY</fo:inline>
                     </fo:basic-link>.</fo:block>
               </fo:block>
               <fo:block id="d61e318">
                  <fo:block>
                     <fo:block>
                        <fo:block keep-together.within-column="always"
                                  margin-left="0pt"
                                  font-family="ProductusSemibold,ArialUnicodeMS">
                           <fo:block keep-with-next.within-column="always">
                              <fo:block xmlns:d="http://docbook.org/ns/docbook"
                                        xmlns:xlink="http://www.w3.org/1999/xlink"
                                        font-family="ProductusSemibold,ArialUnicodeMS"
                                        font-weight="normal"
                                        keep-with-next.within-column="always"
                                        space-before.minimum="0.8em"
                                        space-before.optimum="1.0em"
                                        space-before.maximum="1.2em"
                                        text-align="start"
                                        start-indent="0pt"
                                        hyphenate="false">
                                 <fo:block font-size="9pt"
                                           line-height="11pt"
                                           space-before="5pt"
                                           space-after="5pt">
                                    <fo:list-block provisional-distance-between-starts="1in"
                                                   provisional-label-separation="0.090in">
                                       <fo:list-item>
                                          <fo:list-item-label end-indent="label-end()" text-align="start">
                                             <fo:block>122.3.2.2</fo:block>
                                          </fo:list-item-label>
                                          <fo:list-item-body start-indent="body-start()">
                                             <fo:block>Fail Over</fo:block>
                                          </fo:list-item-body>
                                       </fo:list-item>
                                    </fo:list-block>
                                 </fo:block>
                              </fo:block>
                           </fo:block>
                        </fo:block>
                     </fo:block>
                  </fo:block>
                  <fo:block space-before.optimum="5pt"
                            space-before.minimum="5pt"
                            space-before.maximum="5pt">A more elaborate scheme is a <fo:inline font-style="italic">fail-over
        policy</fo:inline>. In such a policy a service can be replaced by a
        service from another machine. There are many ways to implement such a
        policy, an simple example strategy is provided here for
        illustration.</fo:block>
                  <fo:block space-before.optimum="5pt"
                            space-before.minimum="5pt"
                            space-before.maximum="5pt">A Fail-Over Topology Manager is given a list of stateless
        services that require fail-over, for example through the <fo:inline color="inherit"
                                font-family="inherit"
                                letter-spacing="inherit"
                                hyphenate="inherit">???</fo:inline>. The Fail-Over Manager tracks the systems in
        the its cluster that provide such services. This tracking can use an
        embedded protocol or it can be based on the Endpoint Event Listener
        service model.</fo:block>
                  <fo:block space-before.optimum="5pt"
                            space-before.minimum="5pt"
                            space-before.maximum="5pt">In the Fail-Over policy, the fail-over manager only imports a
        single service and then tracks the error status of the imported
        service through the Remote Service Admin Listener service. If it
        detects the service is becoming unavailable, it closes the
        corresponding Import Registration and imports a service from an
        alternative system instead. In <fo:basic-link xmlns:d="http://docbook.org/ns/docbook"
                                    xmlns:xlink="http://www.w3.org/1999/xlink"
                                    internal-destination="i1819899">
                        <fo:inline color="inherit"
                                   font-family="inherit"
                                   letter-spacing="inherit"
                                   hyphenate="inherit">Figure 122.3</fo:inline>
                     </fo:basic-link>, there are 4
        systems in a cluster. The topology/fail-over manager ensures that
        there is always one of the services in system <fo:inline font-family="ProductusOSGiBookc,ArialUnicodeMS"
                                font-size="9pt"
                                letter-spacing="0.08em">A</fo:inline>, <fo:inline font-family="ProductusOSGiBookc,ArialUnicodeMS"
                                font-size="9pt"
                                letter-spacing="0.08em">
        B</fo:inline>, or <fo:inline font-family="ProductusOSGiBookc,ArialUnicodeMS"
                                font-size="9pt"
                                letter-spacing="0.08em">C</fo:inline> available in <fo:inline font-family="ProductusOSGiBookc,ArialUnicodeMS"
                                font-size="9pt"
                                letter-spacing="0.08em">D</fo:inline>.</fo:block>
                  <fo:block space-before.minimum="0.5em"
                            space-before.optimum="1em"
                            space-before.maximum="2em"
                            space-after.minimum="0.5em"
                            space-after.optimum="1em"
                            space-after.maximum="2em"
                            keep-together.within-column="always"
                            id="i1819899">
                     <fo:block xmlns:d="http://docbook.org/ns/docbook"
                               xmlns:xlink="http://www.w3.org/1999/xlink"
                               space-before.optimum="5pt"
                               space-before.minimum="5pt"
                               space-before.maximum="5pt"
                               font-weight="normal"
                               font-size="9pt"
                               hyphenate="false"
                               space-after.minimum="0.4em"
                               space-after.optimum="0.6em"
                               space-after.maximum="0.8em"
                               start-indent="0pt"
                               font-family="Proforma-Book,ArialUnicodeMS"
                               font-style="italic"
                               keep-with-next.within-column="always">
                        <fo:list-block provisional-distance-between-starts="1in"
                                       provisional-label-separation="0.090in">
                           <fo:list-item>
                              <fo:list-item-label end-indent="label-end()" text-align="start">
                                 <fo:block>Figure 122.3</fo:block>
                              </fo:list-item-label>
                              <fo:list-item-body start-indent="body-start()">
                                 <fo:block>Fail Over Scenario in a cluster</fo:block>
                              </fo:list-item-body>
                           </fo:list-item>
                        </fo:list-block>
                     </fo:block>
                     <fo:block id="d61e342" text-align="center">
                        <fo:external-graphic src="url(file:///home/stbischof/git/OSGI_MIGRATE/osgi_target/org.osgi.service.remoteserviceadmin/spec/org.osgi.spec.service.remoteserviceadmin/src/main/resources/spec/fail-over.svg)"
                                             width="auto"
                                             height="auto"
                                             content-width="4.901in"
                                             content-height="1.852in"
                                             text-align="center"/>
                     </fo:block>
                  </fo:block>
                  <fo:block space-before.optimum="5pt"
                            space-before.minimum="5pt"
                            space-before.maximum="5pt">There are many possible variations on this scenario. The
        managers could exchange load information, allowing the service switch
        to be influenced by the load of the target systems. The important
        aspect is that the Topology Manager can ignore the complex details of
        discovery protocols, communication protocols, and service proxying and
        instead focus on the topology. See <fo:basic-link xmlns:d="http://docbook.org/ns/docbook"
                                    xmlns:xlink="http://www.w3.org/1999/xlink"
                                    internal-destination="org.osgi.service.remoteserviceadmin.namespace.TopologyNamespace.FAIL_OVER_POLICY">
                        <fo:inline color="blue"
                                   font-family="ProductusOSGiBookc,ArialUnicodeMS"
                                   letter-spacing="0.08em"
                                   hyphenate="false">FAIL_OVER_POLICY</fo:inline>
                     </fo:basic-link>.</fo:block>
               </fo:block>
            </fo:block>
         </fo:block>
         <fo:block id="service.remoteserviceadmin.endpointdescription">
            <fo:block>
               <fo:block>
                  <fo:block keep-together.within-column="always"
                            margin-left="0pt"
                            font-family="ProductusSemibold,ArialUnicodeMS">
                     <fo:block keep-with-next.within-column="always">
                        <fo:block xmlns:d="http://docbook.org/ns/docbook"
                                  xmlns:xlink="http://www.w3.org/1999/xlink"
                                  font-family="ProductusSemibold,ArialUnicodeMS"
                                  font-weight="normal"
                                  keep-with-next.within-column="always"
                                  space-before.minimum="0.8em"
                                  space-before.optimum="1.0em"
                                  space-before.maximum="1.2em"
                                  text-align="start"
                                  start-indent="0pt"
                                  hyphenate="false">
                           <fo:marker marker-class-name="section.head.marker">Endpoint Description</fo:marker>
                           <fo:block font-size="18pt"
                                     line-height="25pt"
                                     space-before="12.5pt"
                                     space-after="12pt">
                              <fo:list-block provisional-distance-between-starts="1in"
                                             provisional-label-separation="0.090in">
                                 <fo:list-item>
                                    <fo:list-item-label end-indent="label-end()" text-align="start">
                                       <fo:block>122.4</fo:block>
                                    </fo:list-item-label>
                                    <fo:list-item-body start-indent="body-start()">
                                       <fo:block>Endpoint Description</fo:block>
                                    </fo:list-item-body>
                                 </fo:list-item>
                              </fo:list-block>
                           </fo:block>
                        </fo:block>
                     </fo:block>
                  </fo:block>
               </fo:block>
            </fo:block>
            <fo:block space-before.optimum="5pt"
                      space-before.minimum="5pt"
                      space-before.maximum="5pt">An <fo:inline font-style="italic">Endpoint</fo:inline> is a point of rendezvous of
    distribution providers. It is created by an exporting distribution
    provider or some other party, and is used by importing distribution
    providers to create a connection. An <fo:inline font-style="italic">Endpoint
    Description</fo:inline> describes an Endpoint in such a way that an
    importing Remote Service Admin service can create this connection if it
    recognizes the <fo:inline font-style="italic">configuration type</fo:inline> that is used for
    that Endpoint. The configuration type consists of a name and a set of
    properties associated with that name.</fo:block>
            <fo:block space-before.optimum="5pt"
                      space-before.minimum="5pt"
                      space-before.maximum="5pt">The core concept of the Endpoint Description is a Map of properties.
    The structure of this map is the same as service properties, and the
    defined properties are closely aligned with the properties of an imported
    service. An <fo:inline font-family="ProductusOSGiBookc,ArialUnicodeMS"
                          font-size="9pt"
                          letter-spacing="0.08em">EndpointDescription</fo:inline> object must only consist of
    the data types that are supported for service properties. This makes the
    property map serializable with many different mechanisms. The
    <fo:inline font-family="ProductusOSGiBookc,ArialUnicodeMS"
                          font-size="9pt"
                          letter-spacing="0.08em">EndpointDescription</fo:inline> class provides a convenient way to access
    the properties in a type safe way.</fo:block>
            <fo:block space-before.optimum="5pt"
                      space-before.minimum="5pt"
                      space-before.maximum="5pt">An Endpoint Description has case insensitive keys, just like the
    Service Reference's properties.</fo:block>
            <fo:block space-before.optimum="5pt"
                      space-before.minimum="5pt"
                      space-before.maximum="5pt">The properties map must contain all the prescribed service
    properties of the exported service after intents have been processed, as
    if the service was registered as an imported service. That is, the map
    must not contain any properties that start with
    <fo:inline font-family="ProductusOSGiBookc,ArialUnicodeMS"
                          font-size="9pt"
                          letter-spacing="0.08em">service.exported.*</fo:inline> but it must contain the
    <fo:inline font-family="ProductusOSGiBookc,ArialUnicodeMS"
                          font-size="9pt"
                          letter-spacing="0.08em">service.imported</fo:inline>.* variation of these properties. The
    Endpoint Description must reflect the imported service properties because
    this simplifies the use of filters from the service hooks. Filters applied
    to the Endpoint Description can then be the same filters as applied by a
    bundle to select an imported service from the service registry.</fo:block>
            <fo:block space-before.optimum="5pt"
                      space-before.minimum="5pt"
                      space-before.maximum="5pt">The properties that can be used in an Endpoint Description are
    listed in <fo:basic-link xmlns:d="http://docbook.org/ns/docbook"
                              xmlns:xlink="http://www.w3.org/1999/xlink"
                              internal-destination="service.remoteserviceadmin-endpoint.properties">
                  <fo:inline color="inherit"
                             font-family="inherit"
                             letter-spacing="inherit"
                             hyphenate="inherit">Table 122.1</fo:inline>
               </fo:basic-link>. The
    <fo:inline font-family="ProductusOSGiBookc,ArialUnicodeMS"
                          font-size="9pt"
                          letter-spacing="0.08em">RemoteConstants</fo:inline> class contains the constants for all of these
    property names.</fo:block>
            <fo:block xmlns:rx="http://www.renderx.com/XSL/Extensions"
                      space-before.minimum="0.5em"
                      space-before.optimum="1em"
                      space-before.maximum="2em"
                      space-after.minimum="0.5em"
                      space-after.optimum="1em"
                      space-after.maximum="2em"
                      keep-together.within-column="auto"
                      id="service.remoteserviceadmin-endpoint.properties">
               <fo:block xmlns:d="http://docbook.org/ns/docbook"
                         xmlns:xlink="http://www.w3.org/1999/xlink"
                         space-before.optimum="5pt"
                         space-before.minimum="5pt"
                         space-before.maximum="5pt"
                         font-weight="normal"
                         font-size="9pt"
                         hyphenate="false"
                         space-after.minimum="0.4em"
                         space-after.optimum="0.6em"
                         space-after.maximum="0.8em"
                         start-indent="0pt"
                         font-family="Proforma-Book,ArialUnicodeMS"
                         font-style="italic"
                         keep-with-next.within-column="always">
                  <fo:list-block provisional-distance-between-starts="1in"
                                 provisional-label-separation="0.090in">
                     <fo:list-item>
                        <fo:list-item-label end-indent="label-end()" text-align="start">
                           <fo:block>Table 122.1</fo:block>
                        </fo:list-item-label>
                        <fo:list-item-body start-indent="body-start()">
                           <fo:block>Endpoint Properties</fo:block>
                        </fo:list-item-body>
                     </fo:list-item>
                  </fo:list-block>
               </fo:block>
               <fo:table border-before-width.conditionality="retain"
                         border-collapse="collapse"
                         table-layout="fixed"
                         width="100%">
                  <fo:table-column column-number="1" column-width="proportional-column-width(2.5)"/>
                  <fo:table-column column-number="2" column-width="proportional-column-width(1)"/>
                  <fo:table-column column-number="3" column-width="proportional-column-width(4.5)"/>
                  <fo:table-header start-indent="0pt" end-indent="0pt">
                     <fo:table-row keep-together.within-column="always"
                                   keep-with-next.within-column="always"
                                   font-family="ProductusSemibold,ArialUnicodeMS">
                        <fo:table-cell padding-start="0pt"
                                       padding-end="4pt"
                                       padding-top="1pt"
                                       padding-bottom="1pt">
                           <fo:block>Endpoint Property Name</fo:block>
                        </fo:table-cell>
                        <fo:table-cell padding-start="0pt"
                                       padding-end="4pt"
                                       padding-top="1pt"
                                       padding-bottom="1pt">
                           <fo:block>Type</fo:block>
                        </fo:table-cell>
                        <fo:table-cell padding-start="0pt"
                                       padding-end="4pt"
                                       padding-top="1pt"
                                       padding-bottom="1pt">
                           <fo:block>Description</fo:block>
                        </fo:table-cell>
                     </fo:table-row>
                  </fo:table-header>
                  <fo:table-body start-indent="0pt" end-indent="0pt">
                     <fo:table-row keep-together.within-column="always">
                        <fo:table-cell padding-start="0pt"
                                       padding-end="4pt"
                                       padding-top="1pt"
                                       padding-bottom="1pt">
                           <fo:block>
                              <fo:inline font-family="ProductusOSGiBookc,ArialUnicodeMS"
                                         font-size="9pt"
                                         letter-spacing="0.08em">service.exported.*</fo:inline>
                           </fo:block>
                        </fo:table-cell>
                        <fo:table-cell padding-start="0pt"
                                       padding-end="4pt"
                                       padding-top="1pt"
                                       padding-bottom="1pt">
                           <fo:block>
                              <fo:block space-before.optimum="5pt"
                                        space-before.minimum="5pt"
                                        space-before.maximum="5pt"/>
                           </fo:block>
                        </fo:table-cell>
                        <fo:table-cell padding-start="0pt"
                                       padding-end="4pt"
                                       padding-top="1pt"
                                       padding-bottom="1pt">
                           <fo:block>
                              <fo:block space-before.optimum="5pt"
                                        space-before.minimum="5pt"
                                        space-before.maximum="5pt">Must not be set</fo:block>
                           </fo:block>
                        </fo:table-cell>
                     </fo:table-row>
                     <fo:table-row keep-together.within-column="always">
                        <fo:table-cell padding-start="0pt"
                                       padding-end="4pt"
                                       padding-top="1pt"
                                       padding-bottom="1pt">
                           <fo:block>
                              <fo:inline font-family="ProductusOSGiBookc,ArialUnicodeMS"
                                         font-size="9pt"
                                         letter-spacing="0.08em">service.imported</fo:inline>
                           </fo:block>
                        </fo:table-cell>
                        <fo:table-cell padding-start="0pt"
                                       padding-end="4pt"
                                       padding-top="1pt"
                                       padding-bottom="1pt">
                           <fo:block>
                              <fo:inline font-family="ProductusOSGiBookc,ArialUnicodeMS"
                                         font-size="9pt"
                                         letter-spacing="0.08em">*</fo:inline>
                           </fo:block>
                        </fo:table-cell>
                        <fo:table-cell padding-start="0pt"
                                       padding-end="4pt"
                                       padding-top="1pt"
                                       padding-bottom="1pt">
                           <fo:block>
                              <fo:block space-before.optimum="5pt"
                                        space-before.minimum="5pt"
                                        space-before.maximum="5pt">Must always be set to some value. See <fo:basic-link xmlns:d="http://docbook.org/ns/docbook"
                                                xmlns:xlink="http://www.w3.org/1999/xlink"
                                                internal-destination="org.osgi.service.remoteserviceadmin.RemoteConstants.SERVICE_IMPORTED">
                                    <fo:inline color="blue"
                                               font-family="ProductusOSGiBookc,ArialUnicodeMS"
                                               letter-spacing="0.08em"
                                               hyphenate="false">SERVICE_IMPORTED</fo:inline>
                                 </fo:basic-link>.</fo:block>
                           </fo:block>
                        </fo:table-cell>
                     </fo:table-row>
                     <fo:table-row keep-together.within-column="always">
                        <fo:table-cell padding-start="0pt"
                                       padding-end="4pt"
                                       padding-top="1pt"
                                       padding-bottom="1pt">
                           <fo:block>
                              <fo:inline font-family="ProductusOSGiBookc,ArialUnicodeMS"
                                         font-size="9pt"
                                         letter-spacing="0.08em">objectClass</fo:inline>
                           </fo:block>
                        </fo:table-cell>
                        <fo:table-cell padding-start="0pt"
                                       padding-end="4pt"
                                       padding-top="1pt"
                                       padding-bottom="1pt">
                           <fo:block>
                              <fo:inline font-family="ProductusOSGiBookc,ArialUnicodeMS"
                                         font-size="9pt"
                                         letter-spacing="0.08em">String[]</fo:inline>
                           </fo:block>
                        </fo:table-cell>
                        <fo:table-cell padding-start="0pt"
                                       padding-end="4pt"
                                       padding-top="1pt"
                                       padding-bottom="1pt">
                           <fo:block>
                              <fo:block space-before.optimum="5pt"
                                        space-before.minimum="5pt"
                                        space-before.maximum="5pt">Must be set to the value of
            <fo:inline font-family="ProductusOSGiBookc,ArialUnicodeMS"
                                            font-size="9pt"
                                            letter-spacing="0.08em">service.exported.interfaces</fo:inline>, of the exported service
            after expanding any wildcards. Though this property will be
            overridden by the framework for the corresponding service
            registration, it must be set in the Endpoint Description to
            simplify the filter matching. These interface names are available
            with the <fo:basic-link xmlns:d="http://docbook.org/ns/docbook"
                                                xmlns:xlink="http://www.w3.org/1999/xlink"
                                                internal-destination="org.osgi.service.remoteserviceadmin.EndpointDescription.getInterfaces--">
                                    <fo:inline color="blue"
                                               font-family="ProductusOSGiBookc,ArialUnicodeMS"
                                               letter-spacing="0.08em"
                                               hyphenate="false">getInterfaces()</fo:inline>
                                 </fo:basic-link> method.</fo:block>
                           </fo:block>
                        </fo:table-cell>
                     </fo:table-row>
                     <fo:table-row keep-together.within-column="always">
                        <fo:table-cell padding-start="0pt"
                                       padding-end="4pt"
                                       padding-top="1pt"
                                       padding-bottom="1pt">
                           <fo:block>
                              <fo:inline font-family="ProductusOSGiBookc,ArialUnicodeMS"
                                         font-size="9pt"
                                         letter-spacing="0.08em">service.intents</fo:inline>
                           </fo:block>
                        </fo:table-cell>
                        <fo:table-cell padding-start="0pt"
                                       padding-end="4pt"
                                       padding-top="1pt"
                                       padding-bottom="1pt">
                           <fo:block>
                              <fo:inline font-family="ProductusOSGiBookc,ArialUnicodeMS"
                                         font-size="9pt"
                                         letter-spacing="0.08em">String+</fo:inline>
                           </fo:block>
                        </fo:table-cell>
                        <fo:table-cell padding-start="0pt"
                                       padding-end="4pt"
                                       padding-top="1pt"
                                       padding-bottom="1pt">
                           <fo:block>
                              <fo:block space-before.optimum="5pt"
                                        space-before.minimum="5pt"
                                        space-before.maximum="5pt">Intents implemented by the exporting distribution
            provider and, if applicable, the exported service itself. Any
            qualified intents must have their expanded form present. These
            expanded intents are available with the <fo:basic-link xmlns:d="http://docbook.org/ns/docbook"
                                                xmlns:xlink="http://www.w3.org/1999/xlink"
                                                internal-destination="org.osgi.service.remoteserviceadmin.EndpointDescription.getIntents--">
                                    <fo:inline color="blue"
                                               font-family="ProductusOSGiBookc,ArialUnicodeMS"
                                               letter-spacing="0.08em"
                                               hyphenate="false">getIntents()</fo:inline>
                                 </fo:basic-link> method. See <fo:basic-link xmlns:d="http://docbook.org/ns/docbook"
                                                xmlns:xlink="http://www.w3.org/1999/xlink"
                                                internal-destination="org.osgi.service.remoteserviceadmin.RemoteConstants.SERVICE_INTENTS">
                                    <fo:inline color="blue"
                                               font-family="ProductusOSGiBookc,ArialUnicodeMS"
                                               letter-spacing="0.08em"
                                               hyphenate="false">SERVICE_INTENTS</fo:inline>
                                 </fo:basic-link>.</fo:block>
                           </fo:block>
                        </fo:table-cell>
                     </fo:table-row>
                     <fo:table-row keep-together.within-column="always">
                        <fo:table-cell padding-start="0pt"
                                       padding-end="4pt"
                                       padding-top="1pt"
                                       padding-bottom="1pt">
                           <fo:block>
                              <fo:inline font-family="ProductusOSGiBookc,ArialUnicodeMS"
                                         font-size="9pt"
                                         letter-spacing="0.08em">endpoint.service.id</fo:inline>
                           </fo:block>
                        </fo:table-cell>
                        <fo:table-cell padding-start="0pt"
                                       padding-end="4pt"
                                       padding-top="1pt"
                                       padding-bottom="1pt">
                           <fo:block>
                              <fo:inline font-family="ProductusOSGiBookc,ArialUnicodeMS"
                                         font-size="9pt"
                                         letter-spacing="0.08em">Long</fo:inline>
                           </fo:block>
                        </fo:table-cell>
                        <fo:table-cell padding-start="0pt"
                                       padding-end="4pt"
                                       padding-top="1pt"
                                       padding-bottom="1pt">
                           <fo:block>
                              <fo:block space-before.optimum="5pt"
                                        space-before.minimum="5pt"
                                        space-before.maximum="5pt">The service id of the exported service. Can be absent
            or 0 if the corresponding Endpoint is not for an OSGi service. The
            remote service id is available as <fo:basic-link xmlns:d="http://docbook.org/ns/docbook"
                                                xmlns:xlink="http://www.w3.org/1999/xlink"
                                                internal-destination="org.osgi.service.remoteserviceadmin.EndpointDescription.getServiceId--">
                                    <fo:inline color="blue"
                                               font-family="ProductusOSGiBookc,ArialUnicodeMS"
                                               letter-spacing="0.08em"
                                               hyphenate="false">getServiceId()</fo:inline>
                                 </fo:basic-link>. See also <fo:basic-link xmlns:d="http://docbook.org/ns/docbook"
                                                xmlns:xlink="http://www.w3.org/1999/xlink"
                                                internal-destination="org.osgi.service.remoteserviceadmin.RemoteConstants.ENDPOINT_SERVICE_ID">
                                    <fo:inline color="blue"
                                               font-family="ProductusOSGiBookc,ArialUnicodeMS"
                                               letter-spacing="0.08em"
                                               hyphenate="false">ENDPOINT_SERVICE_ID</fo:inline>
                                 </fo:basic-link>.</fo:block>
                           </fo:block>
                        </fo:table-cell>
                     </fo:table-row>
                     <fo:table-row keep-together.within-column="always">
                        <fo:table-cell padding-start="0pt"
                                       padding-end="4pt"
                                       padding-top="1pt"
                                       padding-bottom="1pt">
                           <fo:block>
                              <fo:inline font-family="ProductusOSGiBookc,ArialUnicodeMS"
                                         font-size="9pt"
                                         letter-spacing="0.08em">endpoint.framework.uuid</fo:inline>
                           </fo:block>
                        </fo:table-cell>
                        <fo:table-cell padding-start="0pt"
                                       padding-end="4pt"
                                       padding-top="1pt"
                                       padding-bottom="1pt">
                           <fo:block>
                              <fo:inline font-family="ProductusOSGiBookc,ArialUnicodeMS"
                                         font-size="9pt"
                                         letter-spacing="0.08em">String</fo:inline>
                           </fo:block>
                        </fo:table-cell>
                        <fo:table-cell padding-start="0pt"
                                       padding-end="4pt"
                                       padding-top="1pt"
                                       padding-bottom="1pt">
                           <fo:block>
                              <fo:block space-before.optimum="5pt"
                                        space-before.minimum="5pt"
                                        space-before.maximum="5pt">A universally unique id identifying the instance of
            the exporting framework. Can be absent if the corresponding
            Endpoint is not for an OSGi service. See <fo:basic-link xmlns:d="http://docbook.org/ns/docbook"
                                                xmlns:xlink="http://www.w3.org/1999/xlink"
                                                internal-destination="i1887500">
                                    <fo:inline color="inherit"
                                               font-family="inherit"
                                               letter-spacing="inherit"
                                               hyphenate="inherit">
                                       <fo:inline font-style="italic">Framework UUID</fo:inline> on page <fo:page-number-citation ref-id="i1887500"/>
                                    </fo:inline>
                                 </fo:basic-link>. The remote framework UUID is available with
            the <fo:basic-link xmlns:d="http://docbook.org/ns/docbook"
                                                xmlns:xlink="http://www.w3.org/1999/xlink"
                                                internal-destination="org.osgi.service.remoteserviceadmin.EndpointDescription.getFrameworkUUID--">
                                    <fo:inline color="blue"
                                               font-family="ProductusOSGiBookc,ArialUnicodeMS"
                                               letter-spacing="0.08em"
                                               hyphenate="false">getFrameworkUUID()</fo:inline>
                                 </fo:basic-link> method. See also <fo:basic-link xmlns:d="http://docbook.org/ns/docbook"
                                                xmlns:xlink="http://www.w3.org/1999/xlink"
                                                internal-destination="org.osgi.service.remoteserviceadmin.RemoteConstants.ENDPOINT_FRAMEWORK_UUID">
                                    <fo:inline color="blue"
                                               font-family="ProductusOSGiBookc,ArialUnicodeMS"
                                               letter-spacing="0.08em"
                                               hyphenate="false">ENDPOINT_FRAMEWORK_UUID</fo:inline>
                                 </fo:basic-link>.</fo:block>
                           </fo:block>
                        </fo:table-cell>
                     </fo:table-row>
                     <fo:table-row keep-together.within-column="always">
                        <fo:table-cell padding-start="0pt"
                                       padding-end="4pt"
                                       padding-top="1pt"
                                       padding-bottom="1pt">
                           <fo:block>
                              <fo:inline font-family="ProductusOSGiBookc,ArialUnicodeMS"
                                         font-size="9pt"
                                         letter-spacing="0.08em">endpoint.id</fo:inline>
                           </fo:block>
                        </fo:table-cell>
                        <fo:table-cell padding-start="0pt"
                                       padding-end="4pt"
                                       padding-top="1pt"
                                       padding-bottom="1pt">
                           <fo:block>
                              <fo:inline font-family="ProductusOSGiBookc,ArialUnicodeMS"
                                         font-size="9pt"
                                         letter-spacing="0.08em">String</fo:inline>
                           </fo:block>
                        </fo:table-cell>
                        <fo:table-cell padding-start="0pt"
                                       padding-end="4pt"
                                       padding-top="1pt"
                                       padding-bottom="1pt">
                           <fo:block>
                              <fo:block space-before.optimum="5pt"
                                        space-before.minimum="5pt"
                                        space-before.maximum="5pt">The Id for this Endpoint, can never be
            <fo:inline font-family="ProductusOSGiBookc,ArialUnicodeMS"
                                            font-size="9pt"
                                            letter-spacing="0.08em">null</fo:inline>. This information is available with the <fo:basic-link xmlns:d="http://docbook.org/ns/docbook"
                                                xmlns:xlink="http://www.w3.org/1999/xlink"
                                                internal-destination="org.osgi.service.remoteserviceadmin.EndpointDescription.getId--">
                                    <fo:inline color="blue"
                                               font-family="ProductusOSGiBookc,ArialUnicodeMS"
                                               letter-spacing="0.08em"
                                               hyphenate="false">getId()</fo:inline>
                                 </fo:basic-link>. See <fo:basic-link xmlns:d="http://docbook.org/ns/docbook"
                                                xmlns:xlink="http://www.w3.org/1999/xlink"
                                                internal-destination="i1887496">
                                    <fo:inline color="inherit"
                                               font-family="inherit"
                                               letter-spacing="inherit"
                                               hyphenate="inherit">
                                       <fo:inline font-style="italic">Endpoint Id</fo:inline> on page <fo:page-number-citation ref-id="i1887496"/>
                                    </fo:inline>
                                 </fo:basic-link> and also
            <fo:basic-link xmlns:d="http://docbook.org/ns/docbook"
                                                xmlns:xlink="http://www.w3.org/1999/xlink"
                                                internal-destination="org.osgi.service.remoteserviceadmin.RemoteConstants.ENDPOINT_ID">
                                    <fo:inline color="blue"
                                               font-family="ProductusOSGiBookc,ArialUnicodeMS"
                                               letter-spacing="0.08em"
                                               hyphenate="false">ENDPOINT_ID</fo:inline>
                                 </fo:basic-link>.</fo:block>
                           </fo:block>
                        </fo:table-cell>
                     </fo:table-row>
                     <fo:table-row keep-together.within-column="always">
                        <fo:table-cell padding-start="0pt"
                                       padding-end="4pt"
                                       padding-top="1pt"
                                       padding-bottom="1pt">
                           <fo:block>
                              <fo:block space-before.optimum="5pt"
                                        space-before.minimum="5pt"
                                        space-before.maximum="5pt">
                                 <fo:inline font-family="ProductusOSGiBookc,ArialUnicodeMS"
                                            font-size="9pt"
                                            letter-spacing="0.08em">endpoint.package.</fo:inline>
                              </fo:block>
                              <fo:block space-before.optimum="5pt"
                                        space-before.minimum="5pt"
                                        space-before.maximum="5pt">
                                 <fo:inline font-family="ProductusOSGiBookc,ArialUnicodeMS"
                                            font-size="9pt"
                                            letter-spacing="0.08em"> version.&lt;package-name&gt;</fo:inline>
                              </fo:block>
                           </fo:block>
                        </fo:table-cell>
                        <fo:table-cell padding-start="0pt"
                                       padding-end="4pt"
                                       padding-top="1pt"
                                       padding-bottom="1pt">
                           <fo:block>
                              <fo:inline font-family="ProductusOSGiBookc,ArialUnicodeMS"
                                         font-size="9pt"
                                         letter-spacing="0.08em">String</fo:inline>
                           </fo:block>
                        </fo:table-cell>
                        <fo:table-cell padding-start="0pt"
                                       padding-end="4pt"
                                       padding-top="1pt"
                                       padding-bottom="1pt">
                           <fo:block>
                              <fo:block space-before.optimum="5pt"
                                        space-before.minimum="5pt"
                                        space-before.maximum="5pt">The Java package version for the embedded
            &lt;package&gt;. For example, the property
            <fo:inline font-family="ProductusOSGiBookc,ArialUnicodeMS"
                                            font-size="9pt"
                                            letter-spacing="0.08em">endpoint.package.version.com.acme=1.3</fo:inline> describes the
            version for the <fo:inline font-family="ProductusOSGiBookc,ArialUnicodeMS"
                                            font-size="9pt"
                                            letter-spacing="0.08em">com.acme</fo:inline> package. The version for a
            package can be obtained with the <fo:basic-link xmlns:d="http://docbook.org/ns/docbook"
                                                xmlns:xlink="http://www.w3.org/1999/xlink"
                                                internal-destination="org.osgi.service.remoteserviceadmin.EndpointDescription.getPackageVersion-String-">
                                    <fo:inline color="blue"
                                               font-family="ProductusOSGiBookc,ArialUnicodeMS"
                                               letter-spacing="0.08em"
                                               hyphenate="false">getPackageVersion(String)</fo:inline>
                                 </fo:basic-link>.</fo:block>
                              <fo:block space-before.optimum="5pt"
                                        space-before.minimum="5pt"
                                        space-before.maximum="5pt">The version does not have to
            be set, if not set, the value must be assumed to be
            0.</fo:block>
                           </fo:block>
                        </fo:table-cell>
                     </fo:table-row>
                     <fo:table-row keep-together.within-column="always">
                        <fo:table-cell padding-start="0pt"
                                       padding-end="4pt"
                                       padding-top="1pt"
                                       padding-bottom="1pt">
                           <fo:block>
                              <fo:inline font-family="ProductusOSGiBookc,ArialUnicodeMS"
                                         font-size="9pt"
                                         letter-spacing="0.08em">service.imported.configs</fo:inline>
                           </fo:block>
                        </fo:table-cell>
                        <fo:table-cell padding-start="0pt"
                                       padding-end="4pt"
                                       padding-top="1pt"
                                       padding-bottom="1pt">
                           <fo:block>
                              <fo:inline font-family="ProductusOSGiBookc,ArialUnicodeMS"
                                         font-size="9pt"
                                         letter-spacing="0.08em">String+</fo:inline>
                           </fo:block>
                        </fo:table-cell>
                        <fo:table-cell padding-start="0pt"
                                       padding-end="4pt"
                                       padding-top="1pt"
                                       padding-bottom="1pt">
                           <fo:block>
                              <fo:block space-before.optimum="5pt"
                                        space-before.minimum="5pt"
                                        space-before.maximum="5pt">The configuration types that can be used to implement
            the corresponding Endpoint. This property maps to the
            corresponding property in the Remote Services chapter. This
            property can be obtained with the <fo:basic-link xmlns:d="http://docbook.org/ns/docbook"
                                                xmlns:xlink="http://www.w3.org/1999/xlink"
                                                internal-destination="org.osgi.service.remoteserviceadmin.EndpointDescription.getConfigurationTypes--">
                                    <fo:inline color="blue"
                                               font-family="ProductusOSGiBookc,ArialUnicodeMS"
                                               letter-spacing="0.08em"
                                               hyphenate="false">getConfigurationTypes()</fo:inline>
                                 </fo:basic-link> method.</fo:block>
                              <fo:block space-before.optimum="5pt"
                                        space-before.minimum="5pt"
                                        space-before.maximum="5pt">The Export
            Registration has all the possible configuration types, where the
            Import Registration reports the configuration type actually used.
            <fo:basic-link xmlns:d="http://docbook.org/ns/docbook"
                                                xmlns:xlink="http://www.w3.org/1999/xlink"
                                                internal-destination="org.osgi.service.remoteserviceadmin.RemoteConstants.SERVICE_IMPORTED_CONFIGS">
                                    <fo:inline color="blue"
                                               font-family="ProductusOSGiBookc,ArialUnicodeMS"
                                               letter-spacing="0.08em"
                                               hyphenate="false">SERVICE_IMPORTED_CONFIGS</fo:inline>
                                 </fo:basic-link>.</fo:block>
                           </fo:block>
                        </fo:table-cell>
                     </fo:table-row>
                     <fo:table-row keep-together.within-column="always">
                        <fo:table-cell padding-start="0pt"
                                       padding-end="4pt"
                                       padding-top="1pt"
                                       padding-bottom="1pt">
                           <fo:block>
                              <fo:inline font-family="ProductusOSGiBookc,ArialUnicodeMS"
                                         font-size="9pt"
                                         letter-spacing="0.08em">&lt;config&gt;.*</fo:inline>
                           </fo:block>
                        </fo:table-cell>
                        <fo:table-cell padding-start="0pt"
                                       padding-end="4pt"
                                       padding-top="1pt"
                                       padding-bottom="1pt">
                           <fo:block>
                              <fo:inline font-family="ProductusOSGiBookc,ArialUnicodeMS"
                                         font-size="9pt"
                                         letter-spacing="0.08em">*</fo:inline>
                           </fo:block>
                        </fo:table-cell>
                        <fo:table-cell padding-start="0pt"
                                       padding-end="4pt"
                                       padding-top="1pt"
                                       padding-bottom="1pt">
                           <fo:block>
                              <fo:block space-before.optimum="5pt"
                                        space-before.minimum="5pt"
                                        space-before.maximum="5pt">Where <fo:inline font-family="ProductusOSGiBookc,ArialUnicodeMS"
                                            font-size="9pt"
                                            letter-spacing="0.08em">&lt;config&gt;</fo:inline> is one of the
            configuration type names listed in
            <fo:inline font-family="ProductusOSGiBookc,ArialUnicodeMS"
                                            font-size="9pt"
                                            letter-spacing="0.08em">service.imported.configs</fo:inline>. The content of these
            properties must be valid for creating a connection to the Endpoint
            in another framework. That is, any locally readable URLs from
            bundles must be converted in such a form that they can be read by
            the importing framework. How this is done is configuration type
            specific.</fo:block>
                           </fo:block>
                        </fo:table-cell>
                     </fo:table-row>
                     <fo:table-row keep-together.within-column="always">
                        <fo:table-cell padding-start="0pt"
                                       padding-end="4pt"
                                       padding-top="1pt"
                                       padding-bottom="1pt">
                           <fo:block>
                              <fo:inline font-family="ProductusOSGiBookc,ArialUnicodeMS"
                                         font-size="9pt"
                                         letter-spacing="0.08em">*</fo:inline>
                           </fo:block>
                        </fo:table-cell>
                        <fo:table-cell padding-start="0pt"
                                       padding-end="4pt"
                                       padding-top="1pt"
                                       padding-bottom="1pt">
                           <fo:block>
                              <fo:inline font-family="ProductusOSGiBookc,ArialUnicodeMS"
                                         font-size="9pt"
                                         letter-spacing="0.08em">*</fo:inline>
                           </fo:block>
                        </fo:table-cell>
                        <fo:table-cell padding-start="0pt"
                                       padding-end="4pt"
                                       padding-top="1pt"
                                       padding-bottom="1pt">
                           <fo:block>
                              <fo:block space-before.optimum="5pt"
                                        space-before.minimum="5pt"
                                        space-before.maximum="5pt">All remaining public service properties must be
            present (that is, not starting with full stop (<fo:inline font-family="ProductusOSGiBookc,ArialUnicodeMS"
                                            font-size="9pt"
                                            letter-spacing="0.08em">'.'
            \u002E</fo:inline>)). If the values can not be marshaled by the
            Distribution Provider then they must be ignored.</fo:block>
                           </fo:block>
                        </fo:table-cell>
                     </fo:table-row>
                  </fo:table-body>
               </fo:table>
            </fo:block>
            <fo:block space-before.optimum="5pt"
                      space-before.minimum="5pt"
                      space-before.maximum="5pt">The <fo:inline font-family="ProductusOSGiBookc,ArialUnicodeMS"
                          font-size="9pt"
                          letter-spacing="0.08em">EndpointDescription</fo:inline> class has a number of
    constructors that make it convenient to instantiate it for different
    purposes:</fo:block>
            <fo:list-block space-before.optimum="1em"
                           space-before.minimum="0.8em"
                           space-before.maximum="1.2em"
                           space-after.optimum="1em"
                           space-after.minimum="0.8em"
                           space-after.maximum="1.2em"
                           provisional-label-separation="0.2em"
                           provisional-distance-between-starts="12pt"
                           id="d61e533">
               <fo:list-item space-before.optimum="2pt"
                             space-before.minimum="2pt"
                             space-before.maximum="2pt"
                             id="d61e534">
                  <fo:list-item-label end-indent="label-end()">
                     <fo:block>•</fo:block>
                  </fo:list-item-label>
                  <fo:list-item-body start-indent="body-start()">
                     <fo:block>
                        <fo:block>
                           <fo:basic-link xmlns:d="http://docbook.org/ns/docbook"
                                          xmlns:xlink="http://www.w3.org/1999/xlink"
                                          internal-destination="org.osgi.service.remoteserviceadmin.EndpointDescription.EndpointDescription-Map-">
                              <fo:inline color="blue"
                                         font-family="ProductusOSGiBookc,ArialUnicodeMS"
                                         letter-spacing="0.08em"
                                         hyphenate="false">EndpointDescription(Map)</fo:inline>
                           </fo:basic-link> - Instantiate the Endpoint Description from a
        <fo:inline font-family="ProductusOSGiBookc,ArialUnicodeMS"
                                      font-size="9pt"
                                      letter-spacing="0.08em">Map</fo:inline> object.</fo:block>
                     </fo:block>
                  </fo:list-item-body>
               </fo:list-item>
               <fo:list-item space-before.optimum="2pt"
                             space-before.minimum="2pt"
                             space-before.maximum="2pt"
                             id="d61e540">
                  <fo:list-item-label end-indent="label-end()">
                     <fo:block>•</fo:block>
                  </fo:list-item-label>
                  <fo:list-item-body start-indent="body-start()">
                     <fo:block>
                        <fo:block>
                           <fo:basic-link xmlns:d="http://docbook.org/ns/docbook"
                                          xmlns:xlink="http://www.w3.org/1999/xlink"
                                          internal-destination="org.osgi.service.remoteserviceadmin.EndpointDescription.EndpointDescription-ServiceReference-Map-">
                              <fo:inline color="blue"
                                         font-family="ProductusOSGiBookc,ArialUnicodeMS"
                                         letter-spacing="0.08em"
                                         hyphenate="false">EndpointDescription(ServiceReference,Map)</fo:inline>
                           </fo:basic-link> - Instantiate an Endpoint Description based on
        a Service Reference and a Map. The base properties of this Endpoint
        Description are the Service Reference properties but the properties in
        the given Map must override any of their case variants in the Service
        Reference. This allows the construction of an Endpoint Description
        from an exportable service while still allowing overrides of specific
        properties by the Topology Manager.</fo:block>
                     </fo:block>
                  </fo:list-item-body>
               </fo:list-item>
            </fo:list-block>
            <fo:block space-before.optimum="5pt"
                      space-before.minimum="5pt"
                      space-before.maximum="5pt">The Endpoint Description must use the allowed properties as given in
    <fo:basic-link xmlns:d="http://docbook.org/ns/docbook"
                              xmlns:xlink="http://www.w3.org/1999/xlink"
                              internal-destination="service.remoteserviceadmin-endpoint.properties">
                  <fo:inline color="inherit"
                             font-family="inherit"
                             letter-spacing="inherit"
                             hyphenate="inherit">Table 122.1 on page <fo:page-number-citation ref-id="service.remoteserviceadmin-endpoint.properties"/>
                  </fo:inline>
               </fo:basic-link>. The Endpoint Description must
    automatically skip any <fo:inline font-family="ProductusOSGiBookc,ArialUnicodeMS"
                          font-size="9pt"
                          letter-spacing="0.08em">service.exported.*</fo:inline> properties.</fo:block>
            <fo:block space-before.optimum="5pt"
                      space-before.minimum="5pt"
                      space-before.maximum="5pt">The Endpoint Description provides the following methods to access
    the properties in a more convenient way:</fo:block>
            <fo:list-block space-before.optimum="1em"
                           space-before.minimum="0.8em"
                           space-before.maximum="1.2em"
                           space-after.optimum="1em"
                           space-after.minimum="0.8em"
                           space-after.maximum="1.2em"
                           provisional-label-separation="0.2em"
                           provisional-distance-between-starts="12pt"
                           id="d61e552">
               <fo:list-item space-before.optimum="2pt"
                             space-before.minimum="2pt"
                             space-before.maximum="2pt"
                             id="d61e553">
                  <fo:list-item-label end-indent="label-end()">
                     <fo:block>•</fo:block>
                  </fo:list-item-label>
                  <fo:list-item-body start-indent="body-start()">
                     <fo:block>
                        <fo:block>
                           <fo:basic-link xmlns:d="http://docbook.org/ns/docbook"
                                          xmlns:xlink="http://www.w3.org/1999/xlink"
                                          internal-destination="org.osgi.service.remoteserviceadmin.EndpointDescription.getInterfaces--">
                              <fo:inline color="blue"
                                         font-family="ProductusOSGiBookc,ArialUnicodeMS"
                                         letter-spacing="0.08em"
                                         hyphenate="false">getInterfaces()</fo:inline>
                           </fo:basic-link> - Answers a list of Java interface names.
        These are the interfaces under which the services must be registered.
        These interface names can also be found at the
        <fo:inline font-family="ProductusOSGiBookc,ArialUnicodeMS"
                                      font-size="9pt"
                                      letter-spacing="0.08em">objectClass</fo:inline> property. A service can only be imported when
        there is at least one Java interface name available.</fo:block>
                     </fo:block>
                  </fo:list-item-body>
               </fo:list-item>
               <fo:list-item space-before.optimum="2pt"
                             space-before.minimum="2pt"
                             space-before.maximum="2pt"
                             id="d61e559">
                  <fo:list-item-label end-indent="label-end()">
                     <fo:block>•</fo:block>
                  </fo:list-item-label>
                  <fo:list-item-body start-indent="body-start()">
                     <fo:block>
                        <fo:block>
                           <fo:basic-link xmlns:d="http://docbook.org/ns/docbook"
                                          xmlns:xlink="http://www.w3.org/1999/xlink"
                                          internal-destination="org.osgi.service.remoteserviceadmin.EndpointDescription.getConfigurationTypes--">
                              <fo:inline color="blue"
                                         font-family="ProductusOSGiBookc,ArialUnicodeMS"
                                         letter-spacing="0.08em"
                                         hyphenate="false">getConfigurationTypes()</fo:inline>
                           </fo:basic-link> - Answer the configuration types that are used
        for exporting this Endpoint. The configuration types are associated
        with a number of properties.</fo:block>
                     </fo:block>
                  </fo:list-item-body>
               </fo:list-item>
               <fo:list-item space-before.optimum="2pt"
                             space-before.minimum="2pt"
                             space-before.maximum="2pt"
                             id="d61e563">
                  <fo:list-item-label end-indent="label-end()">
                     <fo:block>•</fo:block>
                  </fo:list-item-label>
                  <fo:list-item-body start-indent="body-start()">
                     <fo:block>
                        <fo:block>
                           <fo:basic-link xmlns:d="http://docbook.org/ns/docbook"
                                          xmlns:xlink="http://www.w3.org/1999/xlink"
                                          internal-destination="org.osgi.service.remoteserviceadmin.EndpointDescription.getId--">
                              <fo:inline color="blue"
                                         font-family="ProductusOSGiBookc,ArialUnicodeMS"
                                         letter-spacing="0.08em"
                                         hyphenate="false">getId()</fo:inline>
                           </fo:basic-link> - Returns an Id uniquely identifying an
        Endpoint. The syntax of this Id should be defined in the specification
        for the associated configuration type. Two Endpoint Descriptions with
        the same Id describe the same Endpoint.</fo:block>
                     </fo:block>
                  </fo:list-item-body>
               </fo:list-item>
               <fo:list-item space-before.optimum="2pt"
                             space-before.minimum="2pt"
                             space-before.maximum="2pt"
                             id="d61e567">
                  <fo:list-item-label end-indent="label-end()">
                     <fo:block>•</fo:block>
                  </fo:list-item-label>
                  <fo:list-item-body start-indent="body-start()">
                     <fo:block>
                        <fo:block>
                           <fo:basic-link xmlns:d="http://docbook.org/ns/docbook"
                                          xmlns:xlink="http://www.w3.org/1999/xlink"
                                          internal-destination="org.osgi.service.remoteserviceadmin.EndpointDescription.getFrameworkUUID--">
                              <fo:inline color="blue"
                                         font-family="ProductusOSGiBookc,ArialUnicodeMS"
                                         letter-spacing="0.08em"
                                         hyphenate="false">getFrameworkUUID()</fo:inline>
                           </fo:basic-link> - Get a Universally Unique Identifier (UUID)
        for the framework instance that has created the Endpoint, <fo:basic-link xmlns:d="http://docbook.org/ns/docbook"
                                          xmlns:xlink="http://www.w3.org/1999/xlink"
                                          internal-destination="i1887500">
                              <fo:inline color="inherit"
                                         font-family="inherit"
                                         letter-spacing="inherit"
                                         hyphenate="inherit">
                                 <fo:inline font-style="italic">Framework UUID</fo:inline> on page <fo:page-number-citation ref-id="i1887500"/>
                              </fo:inline>
                           </fo:basic-link>.</fo:block>
                     </fo:block>
                  </fo:list-item-body>
               </fo:list-item>
               <fo:list-item space-before.optimum="2pt"
                             space-before.minimum="2pt"
                             space-before.maximum="2pt"
                             id="d61e573">
                  <fo:list-item-label end-indent="label-end()">
                     <fo:block>•</fo:block>
                  </fo:list-item-label>
                  <fo:list-item-body start-indent="body-start()">
                     <fo:block>
                        <fo:block>
                           <fo:basic-link xmlns:d="http://docbook.org/ns/docbook"
                                          xmlns:xlink="http://www.w3.org/1999/xlink"
                                          internal-destination="org.osgi.service.remoteserviceadmin.EndpointDescription.getServiceId--">
                              <fo:inline color="blue"
                                         font-family="ProductusOSGiBookc,ArialUnicodeMS"
                                         letter-spacing="0.08em"
                                         hyphenate="false">getServiceId()</fo:inline>
                           </fo:basic-link> - Get the service id for the framework
        instance that has created the Endpoint. If there is no service on the
        remote side the value must be 0.</fo:block>
                     </fo:block>
                  </fo:list-item-body>
               </fo:list-item>
               <fo:list-item space-before.optimum="2pt"
                             space-before.minimum="2pt"
                             space-before.maximum="2pt"
                             id="d61e577">
                  <fo:list-item-label end-indent="label-end()">
                     <fo:block>•</fo:block>
                  </fo:list-item-label>
                  <fo:list-item-body start-indent="body-start()">
                     <fo:block>
                        <fo:block>
                           <fo:basic-link xmlns:d="http://docbook.org/ns/docbook"
                                          xmlns:xlink="http://www.w3.org/1999/xlink"
                                          internal-destination="org.osgi.service.remoteserviceadmin.EndpointDescription.getPackageVersion-String-">
                              <fo:inline color="blue"
                                         font-family="ProductusOSGiBookc,ArialUnicodeMS"
                                         letter-spacing="0.08em"
                                         hyphenate="false">getPackageVersion(String)</fo:inline>
                           </fo:basic-link> - Get the version for the given
        package.</fo:block>
                     </fo:block>
                  </fo:list-item-body>
               </fo:list-item>
               <fo:list-item space-before.optimum="2pt"
                             space-before.minimum="2pt"
                             space-before.maximum="2pt"
                             id="d61e581">
                  <fo:list-item-label end-indent="label-end()">
                     <fo:block>•</fo:block>
                  </fo:list-item-label>
                  <fo:list-item-body start-indent="body-start()">
                     <fo:block>
                        <fo:block>
                           <fo:basic-link xmlns:d="http://docbook.org/ns/docbook"
                                          xmlns:xlink="http://www.w3.org/1999/xlink"
                                          internal-destination="org.osgi.service.remoteserviceadmin.EndpointDescription.getIntents--">
                              <fo:inline color="blue"
                                         font-family="ProductusOSGiBookc,ArialUnicodeMS"
                                         letter-spacing="0.08em"
                                         hyphenate="false">getIntents()</fo:inline>
                           </fo:basic-link> - Get the list of specified intents.</fo:block>
                     </fo:block>
                  </fo:list-item-body>
               </fo:list-item>
               <fo:list-item space-before.optimum="2pt"
                             space-before.minimum="2pt"
                             space-before.maximum="2pt"
                             id="d61e585">
                  <fo:list-item-label end-indent="label-end()">
                     <fo:block>•</fo:block>
                  </fo:list-item-label>
                  <fo:list-item-body start-indent="body-start()">
                     <fo:block>
                        <fo:block>
                           <fo:basic-link xmlns:d="http://docbook.org/ns/docbook"
                                          xmlns:xlink="http://www.w3.org/1999/xlink"
                                          internal-destination="org.osgi.service.remoteserviceadmin.EndpointDescription.getProperties--">
                              <fo:inline color="blue"
                                         font-family="ProductusOSGiBookc,ArialUnicodeMS"
                                         letter-spacing="0.08em"
                                         hyphenate="false">getProperties()</fo:inline>
                           </fo:basic-link> - Get all the properties.</fo:block>
                     </fo:block>
                  </fo:list-item-body>
               </fo:list-item>
            </fo:list-block>
            <fo:block space-before.optimum="5pt"
                      space-before.minimum="5pt"
                      space-before.maximum="5pt">Two Endpoint Descriptions are deemed equal when their Endpoint Id is
    equal. The Endpoint Id is a mandatory property of an Endpoint Description,
    it is further described at <fo:basic-link xmlns:d="http://docbook.org/ns/docbook"
                              xmlns:xlink="http://www.w3.org/1999/xlink"
                              internal-destination="i1887496">
                  <fo:inline color="inherit"
                             font-family="inherit"
                             letter-spacing="inherit"
                             hyphenate="inherit">
                     <fo:inline font-style="italic">Endpoint Id</fo:inline> on page <fo:page-number-citation ref-id="i1887496"/>
                  </fo:inline>
               </fo:basic-link>. The hash code is
    therefore also based on the Endpoint Id.</fo:block>
            <fo:block id="d61e593">
               <fo:block>
                  <fo:block>
                     <fo:block keep-together.within-column="always"
                               margin-left="0pt"
                               font-family="ProductusSemibold,ArialUnicodeMS">
                        <fo:block keep-with-next.within-column="always">
                           <fo:block xmlns:d="http://docbook.org/ns/docbook"
                                     xmlns:xlink="http://www.w3.org/1999/xlink"
                                     font-family="ProductusSemibold,ArialUnicodeMS"
                                     font-weight="normal"
                                     keep-with-next.within-column="always"
                                     space-before.minimum="0.8em"
                                     space-before.optimum="1.0em"
                                     space-before.maximum="1.2em"
                                     text-align="start"
                                     start-indent="0pt"
                                     hyphenate="false">
                              <fo:block font-size="12pt"
                                        line-height="14pt"
                                        space-before="8pt"
                                        space-after="5pt">
                                 <fo:list-block provisional-distance-between-starts="1in"
                                                provisional-label-separation="0.090in">
                                    <fo:list-item>
                                       <fo:list-item-label end-indent="label-end()" text-align="start">
                                          <fo:block>122.4.1</fo:block>
                                       </fo:list-item-label>
                                       <fo:list-item-body start-indent="body-start()">
                                          <fo:block>Validity</fo:block>
                                       </fo:list-item-body>
                                    </fo:list-item>
                                 </fo:list-block>
                              </fo:block>
                           </fo:block>
                        </fo:block>
                     </fo:block>
                  </fo:block>
               </fo:block>
               <fo:block space-before.optimum="5pt"
                         space-before.minimum="5pt"
                         space-before.maximum="5pt">A valid Endpoint Description must at least satisfy the following
      assertions:</fo:block>
               <fo:list-block space-before.optimum="1em"
                              space-before.minimum="0.8em"
                              space-before.maximum="1.2em"
                              space-after.optimum="1em"
                              space-after.minimum="0.8em"
                              space-after.maximum="1.2em"
                              provisional-label-separation="0.2em"
                              provisional-distance-between-starts="12pt"
                              id="d61e596">
                  <fo:list-item space-before.optimum="2pt"
                                space-before.minimum="2pt"
                                space-before.maximum="2pt"
                                id="d61e597">
                     <fo:list-item-label end-indent="label-end()">
                        <fo:block>•</fo:block>
                     </fo:list-item-label>
                     <fo:list-item-body start-indent="body-start()">
                        <fo:block>
                           <fo:block>It must have a non-<fo:inline font-family="ProductusOSGiBookc,ArialUnicodeMS"
                                         font-size="9pt"
                                         letter-spacing="0.08em">null</fo:inline> Id that uniquely
          identifies the Endpoint</fo:block>
                        </fo:block>
                     </fo:list-item-body>
                  </fo:list-item>
                  <fo:list-item space-before.optimum="2pt"
                                space-before.minimum="2pt"
                                space-before.maximum="2pt"
                                id="d61e602">
                     <fo:list-item-label end-indent="label-end()">
                        <fo:block>•</fo:block>
                     </fo:list-item-label>
                     <fo:list-item-body start-indent="body-start()">
                        <fo:block>
                           <fo:block>It must at least have one Java interface name</fo:block>
                        </fo:block>
                     </fo:list-item-body>
                  </fo:list-item>
                  <fo:list-item space-before.optimum="2pt"
                                space-before.minimum="2pt"
                                space-before.maximum="2pt"
                                id="d61e604">
                     <fo:list-item-label end-indent="label-end()">
                        <fo:block>•</fo:block>
                     </fo:list-item-label>
                     <fo:list-item-body start-indent="body-start()">
                        <fo:block>
                           <fo:block>It must at least have one configuration type set</fo:block>
                        </fo:block>
                     </fo:list-item-body>
                  </fo:list-item>
                  <fo:list-item space-before.optimum="2pt"
                                space-before.minimum="2pt"
                                space-before.maximum="2pt"
                                id="d61e606">
                     <fo:list-item-label end-indent="label-end()">
                        <fo:block>•</fo:block>
                     </fo:list-item-label>
                     <fo:list-item-body start-indent="body-start()">
                        <fo:block>
                           <fo:block>Any version for the packages must have a valid version
          syntax.</fo:block>
                        </fo:block>
                     </fo:list-item-body>
                  </fo:list-item>
               </fo:list-block>
            </fo:block>
            <fo:block id="d61e608">
               <fo:block>
                  <fo:block>
                     <fo:block keep-together.within-column="always"
                               margin-left="0pt"
                               font-family="ProductusSemibold,ArialUnicodeMS">
                        <fo:block keep-with-next.within-column="always">
                           <fo:block xmlns:d="http://docbook.org/ns/docbook"
                                     xmlns:xlink="http://www.w3.org/1999/xlink"
                                     font-family="ProductusSemibold,ArialUnicodeMS"
                                     font-weight="normal"
                                     keep-with-next.within-column="always"
                                     space-before.minimum="0.8em"
                                     space-before.optimum="1.0em"
                                     space-before.maximum="1.2em"
                                     text-align="start"
                                     start-indent="0pt"
                                     hyphenate="false">
                              <fo:block font-size="12pt"
                                        line-height="14pt"
                                        space-before="8pt"
                                        space-after="5pt">
                                 <fo:list-block provisional-distance-between-starts="1in"
                                                provisional-label-separation="0.090in">
                                    <fo:list-item>
                                       <fo:list-item-label end-indent="label-end()" text-align="start">
                                          <fo:block>122.4.2</fo:block>
                                       </fo:list-item-label>
                                       <fo:list-item-body start-indent="body-start()">
                                          <fo:block>Mutability</fo:block>
                                       </fo:list-item-body>
                                    </fo:list-item>
                                 </fo:list-block>
                              </fo:block>
                           </fo:block>
                        </fo:block>
                     </fo:block>
                  </fo:block>
               </fo:block>
               <fo:block space-before.optimum="5pt"
                         space-before.minimum="5pt"
                         space-before.maximum="5pt">An <fo:inline font-family="ProductusOSGiBookc,ArialUnicodeMS"
                             font-size="9pt"
                             letter-spacing="0.08em">EndpointDescription</fo:inline> object is immutable and with
      all final fields. It can be freely used between different
      threads.</fo:block>
            </fo:block>
            <fo:block id="i1887496">
               <fo:block>
                  <fo:block>
                     <fo:block keep-together.within-column="always"
                               margin-left="0pt"
                               font-family="ProductusSemibold,ArialUnicodeMS">
                        <fo:block keep-with-next.within-column="always">
                           <fo:block xmlns:d="http://docbook.org/ns/docbook"
                                     xmlns:xlink="http://www.w3.org/1999/xlink"
                                     font-family="ProductusSemibold,ArialUnicodeMS"
                                     font-weight="normal"
                                     keep-with-next.within-column="always"
                                     space-before.minimum="0.8em"
                                     space-before.optimum="1.0em"
                                     space-before.maximum="1.2em"
                                     text-align="start"
                                     start-indent="0pt"
                                     hyphenate="false">
                              <fo:block font-size="12pt"
                                        line-height="14pt"
                                        space-before="8pt"
                                        space-after="5pt">
                                 <fo:list-block provisional-distance-between-starts="1in"
                                                provisional-label-separation="0.090in">
                                    <fo:list-item>
                                       <fo:list-item-label end-indent="label-end()" text-align="start">
                                          <fo:block>122.4.3</fo:block>
                                       </fo:list-item-label>
                                       <fo:list-item-body start-indent="body-start()">
                                          <fo:block>Endpoint Id</fo:block>
                                       </fo:list-item-body>
                                    </fo:list-item>
                                 </fo:list-block>
                              </fo:block>
                           </fo:block>
                        </fo:block>
                     </fo:block>
                  </fo:block>
               </fo:block>
               <fo:block space-before.optimum="5pt"
                         space-before.minimum="5pt"
                         space-before.maximum="5pt">An Endpoint Id is an opaque unique identifier for an Endpoint.
      This uniqueness must at least hold for the entire network in which the
      Endpoint is used. There is no syntax defined for this string except that
      white space at the beginning and ending must be ignored. The actual
      syntax for this Endpoint Id must be defined by the actual configuration
      type.</fo:block>
               <fo:block space-before.optimum="5pt"
                         space-before.minimum="5pt"
                         space-before.maximum="5pt">Two Endpoint Descriptions are deemed identical when their Endpoint
      Id is equal. The Endpoint Ids must be compared as string compares with
      leading and trailing spaces removed. The Endpoint Description class must
      use the <fo:inline font-family="ProductusOSGiBookc,ArialUnicodeMS"
                             font-size="9pt"
                             letter-spacing="0.08em">String</fo:inline> class' hash Code from the Endpoint Id as its
      own <fo:inline font-family="ProductusOSGiBookc,ArialUnicodeMS"
                             font-size="9pt"
                             letter-spacing="0.08em">hashCode</fo:inline>.</fo:block>
               <fo:block space-before.optimum="5pt"
                         space-before.minimum="5pt"
                         space-before.maximum="5pt">The simplest way to ensure that a growth in the number of
      EndpointDescriptions and/or the size of the connected group does not
      violate the required uniqueness of Endpoint Ids is for implementations
      to make their Endpoint Ids globally unique. This protects against
      clashes regardless of changes to the connected group.</fo:block>
               <fo:block space-before.optimum="5pt"
                         space-before.minimum="5pt"
                         space-before.maximum="5pt">Whilst globally unique identifiers (GUIDs) are a simple solution
      to the Endpoint Id uniqueness problem, they are not easy to implement in
      all environments. In some systems they can be prohibitively expensive to
      create, or of insufficient entropy to be genuinely unique. Some
      distribution providers may therefore choose not to use random
      GUIDs.</fo:block>
               <fo:block space-before.optimum="5pt"
                         space-before.minimum="5pt"
                         space-before.maximum="5pt">In the case where no globally unique value is used the following
      actions are recommended (although not required).</fo:block>
               <fo:list-block space-before.optimum="1em"
                              space-before.minimum="0.8em"
                              space-before.maximum="1.2em"
                              space-after.optimum="1em"
                              space-after.minimum="0.8em"
                              space-after.maximum="1.2em"
                              provisional-label-separation="0.2em"
                              provisional-distance-between-starts="12pt"
                              id="d61e626">
                  <fo:list-item space-before.optimum="2pt"
                                space-before.minimum="2pt"
                                space-before.maximum="2pt"
                                id="d61e627">
                     <fo:list-item-label end-indent="label-end()">
                        <fo:block>•</fo:block>
                     </fo:list-item-label>
                     <fo:list-item-body start-indent="body-start()">
                        <fo:block>
                           <fo:block>Distribution Providers protect against intra-framework clashes
          using some known value unique to the service, for example the
          service id.</fo:block>
                        </fo:block>
                     </fo:list-item-body>
                  </fo:list-item>
                  <fo:list-item space-before.optimum="2pt"
                                space-before.minimum="2pt"
                                space-before.maximum="2pt"
                                id="d61e629">
                     <fo:list-item-label end-indent="label-end()">
                        <fo:block>•</fo:block>
                     </fo:list-item-label>
                     <fo:list-item-body start-indent="body-start()">
                        <fo:block>
                           <fo:block>Distribution Providers protect against inter-provider
          collisions within a single framework by using some unique value,
          such as the distribution provider's bundle id. The distribution
          provider bundle's symbolic name is insufficient, as there may be
          multiple versions of the same distribution provider installed within
          a single framework.</fo:block>
                        </fo:block>
                     </fo:list-item-body>
                  </fo:list-item>
                  <fo:list-item space-before.optimum="2pt"
                                space-before.minimum="2pt"
                                space-before.maximum="2pt"
                                id="d61e631">
                     <fo:list-item-label end-indent="label-end()">
                        <fo:block>•</fo:block>
                     </fo:list-item-label>
                     <fo:list-item-body start-indent="body-start()">
                        <fo:block>
                           <fo:block>Distribution Providers protect against inter-framework
          collisions using some value unique to the framework, such as the
          framework UUID.</fo:block>
                        </fo:block>
                     </fo:list-item-body>
                  </fo:list-item>
               </fo:list-block>
            </fo:block>
            <fo:block id="i1887500">
               <fo:block>
                  <fo:block>
                     <fo:block keep-together.within-column="always"
                               margin-left="0pt"
                               font-family="ProductusSemibold,ArialUnicodeMS">
                        <fo:block keep-with-next.within-column="always">
                           <fo:block xmlns:d="http://docbook.org/ns/docbook"
                                     xmlns:xlink="http://www.w3.org/1999/xlink"
                                     font-family="ProductusSemibold,ArialUnicodeMS"
                                     font-weight="normal"
                                     keep-with-next.within-column="always"
                                     space-before.minimum="0.8em"
                                     space-before.optimum="1.0em"
                                     space-before.maximum="1.2em"
                                     text-align="start"
                                     start-indent="0pt"
                                     hyphenate="false">
                              <fo:block font-size="12pt"
                                        line-height="14pt"
                                        space-before="8pt"
                                        space-after="5pt">
                                 <fo:list-block provisional-distance-between-starts="1in"
                                                provisional-label-separation="0.090in">
                                    <fo:list-item>
                                       <fo:list-item-label end-indent="label-end()" text-align="start">
                                          <fo:block>122.4.4</fo:block>
                                       </fo:list-item-label>
                                       <fo:list-item-body start-indent="body-start()">
                                          <fo:block>Framework UUID</fo:block>
                                       </fo:list-item-body>
                                    </fo:list-item>
                                 </fo:list-block>
                              </fo:block>
                           </fo:block>
                        </fo:block>
                     </fo:block>
                  </fo:block>
               </fo:block>
               <fo:block space-before.optimum="5pt"
                         space-before.minimum="5pt"
                         space-before.maximum="5pt">Each framework registers its services with a service id that is
      only unique for that specific framework. The OSGi framework is not a
      singleton, making it possible that a single VM process holds multiple
      OSGi frameworks. Therefore, to identify an OSGi service uniquely it is
      necessary to identify the framework that has registered it. This
      identifier is a <fo:inline font-style="italic">Universally Unique IDentifier</fo:inline>
      (UUID) that is set for each framework. This UUID is contained in the
      following framework property:</fo:block>
               <fo:block space-before.minimum="0.8em"
                         space-before.optimum="1em"
                         space-before.maximum="1.2em"
                         space-after.minimum="0.8em"
                         space-after.optimum="1em"
                         space-after.maximum="1.2em"
                         hyphenate="false"
                         wrap-option="no-wrap"
                         white-space-collapse="false"
                         white-space-treatment="preserve"
                         linefeed-treatment="preserve"
                         text-align="start"
                         font-family="ProductusOSGiMonoc,ArialUnicodeMS"
                         font-size="9pt"
                         letter-spacing="-.0em"
                         space-before="5pt"
                         space-after="3pt"
                         space-after.conditionality="retain"
                         start-indent="inherit"
                         line-height="11pt"
                         id="d61e639">org.osgi.framework.uuid</fo:block>
               <fo:block space-before.optimum="5pt"
                         space-before.minimum="5pt"
                         space-before.maximum="5pt">If an Endpoint Description has no associated OSGi service then the
      UUID of that Endpoint Description must not be set and its service id
      must be 0.</fo:block>
               <fo:block space-before.optimum="5pt"
                         space-before.minimum="5pt"
                         space-before.maximum="5pt">A local Endpoint Description will have its framework UUID set to
      the local framework. This makes it straightforward to filter for
      Endpoint Descriptions that are describing local Endpoints or that
      describe remote Endpoints. For example, a manager can take the filter
      from a listener and ensure that it is only getting remote Endpoint
      Descriptions:</fo:block>
               <fo:block space-before.minimum="0.8em"
                         space-before.optimum="1em"
                         space-before.maximum="1.2em"
                         space-after.minimum="0.8em"
                         space-after.optimum="1em"
                         space-after.maximum="1.2em"
                         hyphenate="false"
                         wrap-option="no-wrap"
                         white-space-collapse="false"
                         white-space-treatment="preserve"
                         linefeed-treatment="preserve"
                         text-align="start"
                         font-family="ProductusOSGiMonoc,ArialUnicodeMS"
                         font-size="9pt"
                         letter-spacing="-.0em"
                         space-before="5pt"
                         space-after="3pt"
                         space-after.conditionality="retain"
                         start-indent="inherit"
                         line-height="11pt"
                         id="d61e642">(&amp;
  (!
    (service.remote.framework.uuid
       =72dc5fd9-5f8f-4f8f-9821-9ebb433a5b72)
  )
  (objectClass=org.osgi.service.log.LogService)
)</fo:block>
               <fo:block space-before.optimum="5pt"
                         space-before.minimum="5pt"
                         space-before.maximum="5pt">Where <fo:inline font-family="ProductusOSGiBookc,ArialUnicodeMS"
                             font-size="9pt"
                             letter-spacing="0.08em">72dc5fd9-5f8f-4f8f-9821-9ebb433a5b72</fo:inline> is the
      UUID of the local framework. A discovery bundle can register the
      following filter in its scope to receive all locally generated
      Endpoints:</fo:block>
               <fo:block space-before.minimum="0.8em"
                         space-before.optimum="1em"
                         space-before.maximum="1.2em"
                         space-after.minimum="0.8em"
                         space-after.optimum="1em"
                         space-after.maximum="1.2em"
                         hyphenate="false"
                         wrap-option="no-wrap"
                         white-space-collapse="false"
                         white-space-treatment="preserve"
                         linefeed-treatment="preserve"
                         text-align="start"
                         font-family="ProductusOSGiMonoc,ArialUnicodeMS"
                         font-size="9pt"
                         letter-spacing="-.0em"
                         space-before="5pt"
                         space-after="3pt"
                         space-after.conditionality="retain"
                         start-indent="inherit"
                         line-height="11pt"
                         id="d61e647">(service.remote.framework.uuid
       =72dc5fd9-5f8f-4f8f-9821-9ebb433a5b72)</fo:block>
            </fo:block>
            <fo:block id="i1887526">
               <fo:block>
                  <fo:block>
                     <fo:block keep-together.within-column="always"
                               margin-left="0pt"
                               font-family="ProductusSemibold,ArialUnicodeMS">
                        <fo:block keep-with-next.within-column="always">
                           <fo:block xmlns:d="http://docbook.org/ns/docbook"
                                     xmlns:xlink="http://www.w3.org/1999/xlink"
                                     font-family="ProductusSemibold,ArialUnicodeMS"
                                     font-weight="normal"
                                     keep-with-next.within-column="always"
                                     space-before.minimum="0.8em"
                                     space-before.optimum="1.0em"
                                     space-before.maximum="1.2em"
                                     text-align="start"
                                     start-indent="0pt"
                                     hyphenate="false">
                              <fo:block font-size="12pt"
                                        line-height="14pt"
                                        space-before="8pt"
                                        space-after="5pt">
                                 <fo:list-block provisional-distance-between-starts="1in"
                                                provisional-label-separation="0.090in">
                                    <fo:list-item>
                                       <fo:list-item-label end-indent="label-end()" text-align="start">
                                          <fo:block>122.4.5</fo:block>
                                       </fo:list-item-label>
                                       <fo:list-item-body start-indent="body-start()">
                                          <fo:block>Resource Containment</fo:block>
                                       </fo:list-item-body>
                                    </fo:list-item>
                                 </fo:list-block>
                              </fo:block>
                           </fo:block>
                        </fo:block>
                     </fo:block>
                  </fo:block>
               </fo:block>
               <fo:block space-before.optimum="5pt"
                         space-before.minimum="5pt"
                         space-before.maximum="5pt">Configuration types can use URLs to point to local resources
      describing in detail the Endpoint parameters for specific protocols.
      However, the purpose of an Endpoint Description is to describe an
      Endpoint to a remote system. This implies that there is some marshaling
      process that will transfer the Endpoint Description to another process.
      This other process is unlikely to be able to access resource URLs. Local
      bundle resource URLs are only usable in the framework that originates
      them but even HTTP based URLs can easily run into problems due to
      firewalls or lack of routing.</fo:block>
               <fo:block space-before.optimum="5pt"
                         space-before.minimum="5pt"
                         space-before.maximum="5pt">Therefore, the properties for a configuration type should be
      stored in such a way that the receiving process can access them. One way
      to achieve this is to contain the configuration properties completely in
      the Endpoint Description and ensure they only use the basic data types
      that the remote services chapter in the core requires every Distribution
      Provider to support.</fo:block>
               <fo:block space-before.optimum="5pt"
                         space-before.minimum="5pt"
                         space-before.maximum="5pt">The Endpoint Description XML format provides an <fo:inline font-family="ProductusOSGiBookc,ArialUnicodeMS"
                             font-size="9pt"
                             letter-spacing="0.08em">xml</fo:inline>
      element that is specifically added to make it easy to embed XML based
      configuration documents. The XML Schema is defined in <fo:basic-link xmlns:d="http://docbook.org/ns/docbook"
                                 xmlns:xlink="http://www.w3.org/1999/xlink"
                                 internal-destination="i1889341">
                     <fo:inline color="inherit"
                                font-family="inherit"
                                letter-spacing="inherit"
                                hyphenate="inherit">
                        <fo:inline font-style="italic">Endpoint Description Extender Format</fo:inline> on page <fo:page-number-citation ref-id="i1889341"/>
                     </fo:inline>
                  </fo:basic-link>.</fo:block>
            </fo:block>
         </fo:block>
         <fo:block id="service.remoteserviceadmin-rsa.service">
            <fo:block>
               <fo:block>
                  <fo:block keep-together.within-column="always"
                            margin-left="0pt"
                            font-family="ProductusSemibold,ArialUnicodeMS">
                     <fo:block keep-with-next.within-column="always">
                        <fo:block xmlns:d="http://docbook.org/ns/docbook"
                                  xmlns:xlink="http://www.w3.org/1999/xlink"
                                  font-family="ProductusSemibold,ArialUnicodeMS"
                                  font-weight="normal"
                                  keep-with-next.within-column="always"
                                  space-before.minimum="0.8em"
                                  space-before.optimum="1.0em"
                                  space-before.maximum="1.2em"
                                  text-align="start"
                                  start-indent="0pt"
                                  hyphenate="false">
                           <fo:marker marker-class-name="section.head.marker">Remote Service Admin</fo:marker>
                           <fo:block font-size="18pt"
                                     line-height="25pt"
                                     space-before="12.5pt"
                                     space-after="12pt">
                              <fo:list-block provisional-distance-between-starts="1in"
                                             provisional-label-separation="0.090in">
                                 <fo:list-item>
                                    <fo:list-item-label end-indent="label-end()" text-align="start">
                                       <fo:block>122.5</fo:block>
                                    </fo:list-item-label>
                                    <fo:list-item-body start-indent="body-start()">
                                       <fo:block>Remote Service Admin</fo:block>
                                    </fo:list-item-body>
                                 </fo:list-item>
                              </fo:list-block>
                           </fo:block>
                        </fo:block>
                     </fo:block>
                  </fo:block>
               </fo:block>
            </fo:block>
            <fo:block space-before.optimum="5pt"
                      space-before.minimum="5pt"
                      space-before.maximum="5pt">The Remote Service Admin service abstracts the core functionality of
    a distribution provider: exporting a service to an Endpoint and importing
    services from an Endpoint. However, in contrast with the distribution
    provider of the Remote Services specification, the Remote Service Admin
    service must be told explicitly what services to import and export.</fo:block>
            <fo:block id="d61e661">
               <fo:block>
                  <fo:block>
                     <fo:block keep-together.within-column="always"
                               margin-left="0pt"
                               font-family="ProductusSemibold,ArialUnicodeMS">
                        <fo:block keep-with-next.within-column="always">
                           <fo:block xmlns:d="http://docbook.org/ns/docbook"
                                     xmlns:xlink="http://www.w3.org/1999/xlink"
                                     font-family="ProductusSemibold,ArialUnicodeMS"
                                     font-weight="normal"
                                     keep-with-next.within-column="always"
                                     space-before.minimum="0.8em"
                                     space-before.optimum="1.0em"
                                     space-before.maximum="1.2em"
                                     text-align="start"
                                     start-indent="0pt"
                                     hyphenate="false">
                              <fo:block font-size="12pt"
                                        line-height="14pt"
                                        space-before="8pt"
                                        space-after="5pt">
                                 <fo:list-block provisional-distance-between-starts="1in"
                                                provisional-label-separation="0.090in">
                                    <fo:list-item>
                                       <fo:list-item-label end-indent="label-end()" text-align="start">
                                          <fo:block>122.5.1</fo:block>
                                       </fo:list-item-label>
                                       <fo:list-item-body start-indent="body-start()">
                                          <fo:block>Exporting</fo:block>
                                       </fo:list-item-body>
                                    </fo:list-item>
                                 </fo:list-block>
                              </fo:block>
                           </fo:block>
                        </fo:block>
                     </fo:block>
                  </fo:block>
               </fo:block>
               <fo:block space-before.optimum="5pt"
                         space-before.minimum="5pt"
                         space-before.maximum="5pt">An exportable service can be exported with the <fo:basic-link xmlns:d="http://docbook.org/ns/docbook"
                                 xmlns:xlink="http://www.w3.org/1999/xlink"
                                 internal-destination="org.osgi.service.remoteserviceadmin.RemoteServiceAdmin.exportService-ServiceReference-Map-">
                     <fo:inline color="blue"
                                font-family="ProductusOSGiBookc,ArialUnicodeMS"
                                letter-spacing="0.08em"
                                hyphenate="false">exportService(ServiceReference,Map)</fo:inline>
                  </fo:basic-link> method. This method creates a number of
      Endpoints by inspecting the merged properties from the Service Reference
      and the given Map. Any property in the Map overrides the Service
      Reference properties, regardless of case. That is, if the map contains a
      key then it will override any case variant of this key in the Service
      Reference. However, if the Map contains the <fo:inline font-family="ProductusOSGiBookc,ArialUnicodeMS"
                             font-size="9pt"
                             letter-spacing="0.08em">objectClass</fo:inline> or
      <fo:inline font-family="ProductusOSGiBookc,ArialUnicodeMS"
                             font-size="9pt"
                             letter-spacing="0.08em">service.id</fo:inline> property key in any case variant, then these
      properties must not override the Service Reference's value.</fo:block>
               <fo:block space-before.optimum="5pt"
                         space-before.minimum="5pt"
                         space-before.maximum="5pt">The Remote Service Admin service must interpret the merged
      properties according to the Remote Services chapter. This means that it
      must look at the following properties (as defined in chapter <fo:inline color="inherit"
                             font-family="inherit"
                             letter-spacing="inherit"
                             hyphenate="inherit">???</fo:inline> ):</fo:block>
               <fo:list-block space-before.optimum="1em"
                              space-before.minimum="0.8em"
                              space-before.maximum="1.2em"
                              space-after.optimum="1em"
                              space-after.minimum="0.8em"
                              space-after.maximum="1.2em"
                              provisional-label-separation="0.2em"
                              provisional-distance-between-starts="12pt"
                              id="d61e675">
                  <fo:list-item space-before.optimum="2pt"
                                space-before.minimum="2pt"
                                space-before.maximum="2pt"
                                id="d61e676">
                     <fo:list-item-label end-indent="label-end()">
                        <fo:block>•</fo:block>
                     </fo:list-item-label>
                     <fo:list-item-body start-indent="body-start()">
                        <fo:block>
                           <fo:block>
                              <fo:inline font-family="ProductusOSGiBookc,ArialUnicodeMS"
                                         font-size="9pt"
                                         letter-spacing="0.08em">service.exported.configs</fo:inline> - <fo:inline font-family="ProductusOSGiBookc,ArialUnicodeMS"
                                         font-size="9pt"
                                         letter-spacing="0.08em">(String+
          )</fo:inline> A list of configuration types that should be used to export
          this service. Each configuration type represents the configuration
          parameters for an Endpoint. A Remote Service Admin service should
          create an Endpoint for each configuration type that it supports and
          ignore the types it does not recognize. If this property is not set,
          then the Remote Service Admin implementation must choose a
          convenient configuration type that then must be reported on the
          Endpoint Description with the <fo:inline font-family="ProductusOSGiBookc,ArialUnicodeMS"
                                         font-size="9pt"
                                         letter-spacing="0.08em">service.imported.configs</fo:inline>
          associated with the returned Export Registration.</fo:block>
                        </fo:block>
                     </fo:list-item-body>
                  </fo:list-item>
                  <fo:list-item space-before.optimum="2pt"
                                space-before.minimum="2pt"
                                space-before.maximum="2pt"
                                id="d61e684">
                     <fo:list-item-label end-indent="label-end()">
                        <fo:block>•</fo:block>
                     </fo:list-item-label>
                     <fo:list-item-body start-indent="body-start()">
                        <fo:block>
                           <fo:block>
                              <fo:inline font-family="ProductusOSGiBookc,ArialUnicodeMS"
                                         font-size="9pt"
                                         letter-spacing="0.08em">service.exported.intents</fo:inline> - (
          <fo:inline font-family="ProductusOSGiBookc,ArialUnicodeMS"
                                         font-size="9pt"
                                         letter-spacing="0.08em">String+)</fo:inline> A list of intents that the Remote Service
          Admin service must implement to distribute the given service.</fo:block>
                        </fo:block>
                     </fo:list-item-body>
                  </fo:list-item>
                  <fo:list-item space-before.optimum="2pt"
                                space-before.minimum="2pt"
                                space-before.maximum="2pt"
                                id="d61e690">
                     <fo:list-item-label end-indent="label-end()">
                        <fo:block>•</fo:block>
                     </fo:list-item-label>
                     <fo:list-item-body start-indent="body-start()">
                        <fo:block>
                           <fo:block>
                              <fo:inline font-family="ProductusOSGiBookc,ArialUnicodeMS"
                                         font-size="9pt"
                                         letter-spacing="0.08em">service.exported.intents.extra</fo:inline> -
          <fo:inline font-family="ProductusOSGiBookc,ArialUnicodeMS"
                                         font-size="9pt"
                                         letter-spacing="0.08em">(String+)</fo:inline> This property is merged with the
          <fo:inline font-family="ProductusOSGiBookc,ArialUnicodeMS"
                                         font-size="9pt"
                                         letter-spacing="0.08em">service.exported.intents</fo:inline> property.</fo:block>
                        </fo:block>
                     </fo:list-item-body>
                  </fo:list-item>
                  <fo:list-item space-before.optimum="2pt"
                                space-before.minimum="2pt"
                                space-before.maximum="2pt"
                                id="d61e698">
                     <fo:list-item-label end-indent="label-end()">
                        <fo:block>•</fo:block>
                     </fo:list-item-label>
                     <fo:list-item-body start-indent="body-start()">
                        <fo:block>
                           <fo:block>
                              <fo:inline font-family="ProductusOSGiBookc,ArialUnicodeMS"
                                         font-size="9pt"
                                         letter-spacing="0.08em">service.exported.interfaces</fo:inline> -
          <fo:inline font-family="ProductusOSGiBookc,ArialUnicodeMS"
                                         font-size="9pt"
                                         letter-spacing="0.08em">(String+)</fo:inline> This property must be set; it marks this
          service for export and defines the interfaces. The list members must
          all be contained in the types listed in the <fo:inline font-family="ProductusOSGiBookc,ArialUnicodeMS"
                                         font-size="9pt"
                                         letter-spacing="0.08em">objectClass</fo:inline>
          service property from the Service Reference. The single value of an
          asterisk (<fo:inline font-family="ProductusOSGiBookc,ArialUnicodeMS"
                                         font-size="9pt"
                                         letter-spacing="0.08em">'*' \u002A</fo:inline>) indicates all interfaces in the
          registration's <fo:inline font-family="ProductusOSGiBookc,ArialUnicodeMS"
                                         font-size="9pt"
                                         letter-spacing="0.08em">objectClass</fo:inline> property and ignore the
          classes. Being able to set this property outside the Service
          Reference implies that the Topology Manager can export any
          registered service, also services not specifically marked to be
          exported.</fo:block>
                        </fo:block>
                     </fo:list-item-body>
                  </fo:list-item>
                  <fo:list-item space-before.optimum="2pt"
                                space-before.minimum="2pt"
                                space-before.maximum="2pt"
                                id="d61e710">
                     <fo:list-item-label end-indent="label-end()">
                        <fo:block>•</fo:block>
                     </fo:list-item-label>
                     <fo:list-item-body start-indent="body-start()">
                        <fo:block>
                           <fo:block>
                              <fo:inline font-family="ProductusOSGiBookc,ArialUnicodeMS"
                                         font-size="9pt"
                                         letter-spacing="0.08em">service.intents</fo:inline> - <fo:inline font-family="ProductusOSGiBookc,ArialUnicodeMS"
                                         font-size="9pt"
                                         letter-spacing="0.08em">(String+)</fo:inline> A list
          of intents that this service has implemented.</fo:block>
                        </fo:block>
                     </fo:list-item-body>
                  </fo:list-item>
               </fo:list-block>
               <fo:block space-before.optimum="5pt"
                         space-before.minimum="5pt"
                         space-before.maximum="5pt">A Topology Manager cannot remove properties, <fo:inline font-family="ProductusOSGiBookc,ArialUnicodeMS"
                             font-size="9pt"
                             letter-spacing="0.08em">null</fo:inline> is
      invalid as a property value.</fo:block>
               <fo:block space-before.optimum="5pt"
                         space-before.minimum="5pt"
                         space-before.maximum="5pt">The Remote Service Admin returns a collection of
      <fo:inline font-family="ProductusOSGiBookc,ArialUnicodeMS"
                             font-size="9pt"
                             letter-spacing="0.08em">ExportRegistration</fo:inline> objects. This collection must contain an
      entry for each configuration type the Remote Service Admin has
      recognized. Unrecognized configuration types must be ignored. Recognized
      configuration types which require intents that are not supported by the
      Remote Service Admin must also be ignored. However, it is possible that
      this list contains <fo:inline font-style="italic">invalid registrations</fo:inline>, see <fo:basic-link xmlns:d="http://docbook.org/ns/docbook"
                                 xmlns:xlink="http://www.w3.org/1999/xlink"
                                 internal-destination="i1791501">
                     <fo:inline color="inherit"
                                font-family="inherit"
                                letter-spacing="inherit"
                                hyphenate="inherit">
                        <fo:inline font-style="italic">Invalid Registrations</fo:inline> on page <fo:page-number-citation ref-id="i1791501"/>
                     </fo:inline>
                  </fo:basic-link>.</fo:block>
               <fo:block space-before.optimum="5pt"
                         space-before.minimum="5pt"
                         space-before.maximum="5pt">If a Service was already exported then the Remote Service Admin
      must still return a new <fo:inline font-family="ProductusOSGiBookc,ArialUnicodeMS"
                             font-size="9pt"
                             letter-spacing="0.08em">ExportRegistration</fo:inline> object that is
      linked with the earlier registrations. That is, an Endpoint can be
      shared between multiple Export Registrations. The Remote Service Admin
      service must ensure that the corresponding Endpoint remains available as
      long as there is at least one open Export Registration for that
      Endpoint.</fo:block>
               <fo:block space-before.optimum="5pt"
                         space-before.minimum="5pt"
                         space-before.maximum="5pt">For each successful creation of an export registration, the Remote
      Service Admin service must publish an <fo:basic-link xmlns:d="http://docbook.org/ns/docbook"
                                 xmlns:xlink="http://www.w3.org/1999/xlink"
                                 internal-destination="org.osgi.service.remoteserviceadmin.RemoteServiceAdminEvent.EXPORT_REGISTRATION">
                     <fo:inline color="blue"
                                font-family="ProductusOSGiBookc,ArialUnicodeMS"
                                letter-spacing="0.08em"
                                hyphenate="false">EXPORT_REGISTRATION</fo:inline>
                  </fo:basic-link> event, see <fo:basic-link xmlns:d="http://docbook.org/ns/docbook"
                                 xmlns:xlink="http://www.w3.org/1999/xlink"
                                 internal-destination="i1736220">
                     <fo:inline color="inherit"
                                font-family="inherit"
                                letter-spacing="inherit"
                                hyphenate="inherit">
                        <fo:inline font-style="italic">Events</fo:inline> on page <fo:page-number-citation ref-id="i1736220"/>
                     </fo:inline>
                  </fo:basic-link>. This
      event must be emitted, even if the Endpoint already existed and is thus
      shared with another Export Registration. If the creation of an Endpoint
      runs into an error, an <fo:basic-link xmlns:d="http://docbook.org/ns/docbook"
                                 xmlns:xlink="http://www.w3.org/1999/xlink"
                                 internal-destination="org.osgi.service.remoteserviceadmin.RemoteServiceAdminEvent.EXPORT_ERROR">
                     <fo:inline color="blue"
                                font-family="ProductusOSGiBookc,ArialUnicodeMS"
                                letter-spacing="0.08em"
                                hyphenate="false">EXPORT_ERROR</fo:inline>
                  </fo:basic-link> event must be emitted.</fo:block>
               <fo:block space-before.optimum="5pt"
                         space-before.minimum="5pt"
                         space-before.maximum="5pt">Each valid Export Registration corresponds to an Endpoint for the
      given service. This Endpoint must remain active until all of the Export
      Registrations are closed that share this Endpoint.</fo:block>
               <fo:block space-before.optimum="5pt"
                         space-before.minimum="5pt"
                         space-before.maximum="5pt">The Endpoint can now be published so that other processes or
      systems can import this Endpoint. To aid with this import, the Export
      Registration has a <fo:basic-link xmlns:d="http://docbook.org/ns/docbook"
                                 xmlns:xlink="http://www.w3.org/1999/xlink"
                                 internal-destination="org.osgi.service.remoteserviceadmin.ExportRegistration.getExportReference--">
                     <fo:inline color="blue"
                                font-family="ProductusOSGiBookc,ArialUnicodeMS"
                                letter-spacing="0.08em"
                                hyphenate="false">getExportReference()</fo:inline>
                  </fo:basic-link> method that returns an <fo:basic-link xmlns:d="http://docbook.org/ns/docbook"
                                 xmlns:xlink="http://www.w3.org/1999/xlink"
                                 internal-destination="org.osgi.service.remoteserviceadmin.ExportReference">
                     <fo:inline color="blue"
                                font-family="ProductusOSGiBookc,ArialUnicodeMS"
                                letter-spacing="0.08em"
                                hyphenate="false">ExportReference</fo:inline>
                  </fo:basic-link> object. This reference provides the following
      information:</fo:block>
               <fo:list-block space-before.optimum="1em"
                              space-before.minimum="0.8em"
                              space-before.maximum="1.2em"
                              space-after.optimum="1em"
                              space-after.minimum="0.8em"
                              space-after.maximum="1.2em"
                              provisional-label-separation="0.2em"
                              provisional-distance-between-starts="12pt"
                              id="d61e747">
                  <fo:list-item space-before.optimum="2pt"
                                space-before.minimum="2pt"
                                space-before.maximum="2pt"
                                id="d61e748">
                     <fo:list-item-label end-indent="label-end()">
                        <fo:block>•</fo:block>
                     </fo:list-item-label>
                     <fo:list-item-body start-indent="body-start()">
                        <fo:block>
                           <fo:block>
                              <fo:basic-link xmlns:d="http://docbook.org/ns/docbook"
                                             xmlns:xlink="http://www.w3.org/1999/xlink"
                                             internal-destination="org.osgi.service.remoteserviceadmin.ExportReference.getExportedEndpoint--">
                                 <fo:inline color="blue"
                                            font-family="ProductusOSGiBookc,ArialUnicodeMS"
                                            letter-spacing="0.08em"
                                            hyphenate="false">getExportedEndpoint()</fo:inline>
                              </fo:basic-link> - This is the associated Endpoint
          Description. This Endpoint Description is a properties based
          description of an Endpoint. The property keys and their semantics
          are outlined in <fo:basic-link xmlns:d="http://docbook.org/ns/docbook"
                                             xmlns:xlink="http://www.w3.org/1999/xlink"
                                             internal-destination="service.remoteserviceadmin.endpointdescription">
                                 <fo:inline color="inherit"
                                            font-family="inherit"
                                            letter-spacing="inherit"
                                            hyphenate="inherit">
                                    <fo:inline font-style="italic">Endpoint Description</fo:inline> on page <fo:page-number-citation ref-id="service.remoteserviceadmin.endpointdescription"/>
                                 </fo:inline>
                              </fo:basic-link>. It can
          be used to inform other systems of the availability of an
          Endpoint.</fo:block>
                        </fo:block>
                     </fo:list-item-body>
                  </fo:list-item>
                  <fo:list-item space-before.optimum="2pt"
                                space-before.minimum="2pt"
                                space-before.maximum="2pt"
                                id="d61e754">
                     <fo:list-item-label end-indent="label-end()">
                        <fo:block>•</fo:block>
                     </fo:list-item-label>
                     <fo:list-item-body start-indent="body-start()">
                        <fo:block>
                           <fo:block>
                              <fo:basic-link xmlns:d="http://docbook.org/ns/docbook"
                                             xmlns:xlink="http://www.w3.org/1999/xlink"
                                             internal-destination="org.osgi.service.remoteserviceadmin.ExportReference.getExportedService--">
                                 <fo:inline color="blue"
                                            font-family="ProductusOSGiBookc,ArialUnicodeMS"
                                            letter-spacing="0.08em"
                                            hyphenate="false">getExportedService()</fo:inline>
                              </fo:basic-link> - The Service Reference to the exported
          service.</fo:block>
                        </fo:block>
                     </fo:list-item-body>
                  </fo:list-item>
               </fo:list-block>
               <fo:block space-before.optimum="5pt"
                         space-before.minimum="5pt"
                         space-before.maximum="5pt">Both methods must return <fo:inline font-family="ProductusOSGiBookc,ArialUnicodeMS"
                             font-size="9pt"
                             letter-spacing="0.08em">null</fo:inline> when the associated
      Export Registration is closed.</fo:block>
               <fo:block space-before.optimum="5pt"
                         space-before.minimum="5pt"
                         space-before.maximum="5pt">A Distribution Provider that recognizes the configuration type in
      an Endpoint can create a connection to an Endpoint on other systems as
      long as firewalls and networks permit. The Endpoint Description can
      therefore be communicated to other systems to announce the availability
      of an Endpoint. The Topology Manager can optionally announce the
      availability of an Endpoint to the Endpoint Event Listener services, see
      <fo:basic-link xmlns:d="http://docbook.org/ns/docbook"
                                 xmlns:xlink="http://www.w3.org/1999/xlink"
                                 internal-destination="i1751493">
                     <fo:inline color="inherit"
                                font-family="inherit"
                                letter-spacing="inherit"
                                hyphenate="inherit">
                        <fo:inline font-style="italic">Discovery</fo:inline> on page <fo:page-number-citation ref-id="i1751493"/>
                     </fo:inline>
                  </fo:basic-link>. The decision to announce the availability of
      an Endpoint is one of the policies that is provided by a specific
      Topology Manager.</fo:block>
               <fo:block space-before.optimum="5pt"
                         space-before.minimum="5pt"
                         space-before.maximum="5pt">The Export Registrations remain open until:</fo:block>
               <fo:list-block space-before.optimum="1em"
                              space-before.minimum="0.8em"
                              space-before.maximum="1.2em"
                              space-after.optimum="1em"
                              space-after.minimum="0.8em"
                              space-after.maximum="1.2em"
                              provisional-label-separation="0.2em"
                              provisional-distance-between-starts="12pt"
                              id="d61e768">
                  <fo:list-item space-before.optimum="2pt"
                                space-before.minimum="2pt"
                                space-before.maximum="2pt"
                                id="d61e769">
                     <fo:list-item-label end-indent="label-end()">
                        <fo:block>•</fo:block>
                     </fo:list-item-label>
                     <fo:list-item-body start-indent="body-start()">
                        <fo:block>
                           <fo:block>Explicitly closed by the Topology Manager, or</fo:block>
                        </fo:block>
                     </fo:list-item-body>
                  </fo:list-item>
                  <fo:list-item space-before.optimum="2pt"
                                space-before.minimum="2pt"
                                space-before.maximum="2pt"
                                id="d61e771">
                     <fo:list-item-label end-indent="label-end()">
                        <fo:block>•</fo:block>
                     </fo:list-item-label>
                     <fo:list-item-body start-indent="body-start()">
                        <fo:block>
                           <fo:block>The Remote Service Admin service is no longer used by the
          Topology Manager that created the Export Registration.</fo:block>
                        </fo:block>
                     </fo:list-item-body>
                  </fo:list-item>
               </fo:list-block>
               <fo:block space-before.optimum="5pt"
                         space-before.minimum="5pt"
                         space-before.maximum="5pt">If the Remote Service Admin service can no longer maintain the
      corresponding Endpoint due to failures than these should be reported
      through the events. However, the registrations should remain open until
      explicitly closed by the Topology Manager.</fo:block>
               <fo:block space-before.optimum="5pt"
                         space-before.minimum="5pt"
                         space-before.maximum="5pt">See <fo:basic-link xmlns:d="http://docbook.org/ns/docbook"
                                 xmlns:xlink="http://www.w3.org/1999/xlink"
                                 internal-destination="i1736585">
                     <fo:inline color="inherit"
                                font-family="inherit"
                                letter-spacing="inherit"
                                hyphenate="inherit">
                        <fo:inline font-style="italic">Registration Life Cycle</fo:inline> on page <fo:page-number-citation ref-id="i1736585"/>
                     </fo:inline>
                  </fo:basic-link> for more information.</fo:block>
               <fo:block space-before.optimum="5pt"
                         space-before.minimum="5pt"
                         space-before.maximum="5pt">The Export Registrations are not permanent; persistence is in the
      realm of the Topology Manager.</fo:block>
            </fo:block>
            <fo:block id="d61e779">
               <fo:block>
                  <fo:block>
                     <fo:block keep-together.within-column="always"
                               margin-left="0pt"
                               font-family="ProductusSemibold,ArialUnicodeMS">
                        <fo:block keep-with-next.within-column="always">
                           <fo:block xmlns:d="http://docbook.org/ns/docbook"
                                     xmlns:xlink="http://www.w3.org/1999/xlink"
                                     font-family="ProductusSemibold,ArialUnicodeMS"
                                     font-weight="normal"
                                     keep-with-next.within-column="always"
                                     space-before.minimum="0.8em"
                                     space-before.optimum="1.0em"
                                     space-before.maximum="1.2em"
                                     text-align="start"
                                     start-indent="0pt"
                                     hyphenate="false">
                              <fo:block font-size="12pt"
                                        line-height="14pt"
                                        space-before="8pt"
                                        space-after="5pt">
                                 <fo:list-block provisional-distance-between-starts="1in"
                                                provisional-label-separation="0.090in">
                                    <fo:list-item>
                                       <fo:list-item-label end-indent="label-end()" text-align="start">
                                          <fo:block>122.5.2</fo:block>
                                       </fo:list-item-label>
                                       <fo:list-item-body start-indent="body-start()">
                                          <fo:block>Importing</fo:block>
                                       </fo:list-item-body>
                                    </fo:list-item>
                                 </fo:list-block>
                              </fo:block>
                           </fo:block>
                        </fo:block>
                     </fo:block>
                  </fo:block>
               </fo:block>
               <fo:block space-before.optimum="5pt"
                         space-before.minimum="5pt"
                         space-before.maximum="5pt">To import a service, a Topology Manager must have an Endpoint
      Description that describes the Endpoint the imported service should
      connect to. With this Endpoint Description, a Remote Service Admin
      service can then import the corresponding Endpoint. A Topology Manager
      can obtain these Endpoint Descriptions through internal configuration;
      it can use the discovery model enabled by the Endpoint Event Listener
      service, see <fo:basic-link xmlns:d="http://docbook.org/ns/docbook"
                                 xmlns:xlink="http://www.w3.org/1999/xlink"
                                 internal-destination="i1751493">
                     <fo:inline color="inherit"
                                font-family="inherit"
                                letter-spacing="inherit"
                                hyphenate="inherit">
                        <fo:inline font-style="italic">Discovery</fo:inline> on page <fo:page-number-citation ref-id="i1751493"/>
                     </fo:inline>
                  </fo:basic-link>, or some alternate means.</fo:block>
               <fo:block space-before.optimum="5pt"
                         space-before.minimum="5pt"
                         space-before.maximum="5pt">A service can be imported with the Remote Service Admin <fo:basic-link xmlns:d="http://docbook.org/ns/docbook"
                                 xmlns:xlink="http://www.w3.org/1999/xlink"
                                 internal-destination="org.osgi.service.remoteserviceadmin.RemoteServiceAdmin.importService-EndpointDescription-">
                     <fo:inline color="blue"
                                font-family="ProductusOSGiBookc,ArialUnicodeMS"
                                letter-spacing="0.08em"
                                hyphenate="false">importService(EndpointDescription)</fo:inline>
                  </fo:basic-link> method. This method takes an Endpoint
      Description and picks one of the embedded configuration types to
      establish a connection with the corresponding Endpoint to create a local
      service proxy. This proxy can then be mapped to either a remote OSGi
      service or an alternative, for example a web service. In certain cases
      the service proxy can be lazy, only verifying the reachability of the
      Endpoint when it is actually invoked for the first time. This implies
      that a service proxy can block when invoked until the proper
      communication setup has taken place.</fo:block>
               <fo:block space-before.optimum="5pt"
                         space-before.minimum="5pt"
                         space-before.maximum="5pt">If the Remote Service Admin service does not recognize any of the
      configuration types then it must return <fo:inline font-family="ProductusOSGiBookc,ArialUnicodeMS"
                             font-size="9pt"
                             letter-spacing="0.08em">null</fo:inline>. If there are
      multiple configuration types recognized then the Remote Service Admin is
      free to select any one of the recognized types.</fo:block>
               <fo:block space-before.optimum="5pt"
                         space-before.minimum="5pt"
                         space-before.maximum="5pt">The Remote Service Admin service must ensure that service
      properties are according to the Remote Services chapter for an imported
      service. This means that it must register the following
      properties:</fo:block>
               <fo:list-block space-before.optimum="1em"
                              space-before.minimum="0.8em"
                              space-before.maximum="1.2em"
                              space-after.optimum="1em"
                              space-after.minimum="0.8em"
                              space-after.maximum="1.2em"
                              provisional-label-separation="0.2em"
                              provisional-distance-between-starts="12pt"
                              id="d61e794">
                  <fo:list-item space-before.optimum="2pt"
                                space-before.minimum="2pt"
                                space-before.maximum="2pt"
                                id="d61e795">
                     <fo:list-item-label end-indent="label-end()">
                        <fo:block>•</fo:block>
                     </fo:list-item-label>
                     <fo:list-item-body start-indent="body-start()">
                        <fo:block>
                           <fo:block>
                              <fo:inline font-family="ProductusOSGiBookc,ArialUnicodeMS"
                                         font-size="9pt"
                                         letter-spacing="0.08em">service.imported</fo:inline> - <fo:inline font-family="ProductusOSGiBookc,ArialUnicodeMS"
                                         font-size="9pt"
                                         letter-spacing="0.08em">(*)</fo:inline> Must be set
          to any value.</fo:block>
                        </fo:block>
                     </fo:list-item-body>
                  </fo:list-item>
                  <fo:list-item space-before.optimum="2pt"
                                space-before.minimum="2pt"
                                space-before.maximum="2pt"
                                id="d61e801">
                     <fo:list-item-label end-indent="label-end()">
                        <fo:block>•</fo:block>
                     </fo:list-item-label>
                     <fo:list-item-body start-indent="body-start()">
                        <fo:block>
                           <fo:block>
                              <fo:inline font-family="ProductusOSGiBookc,ArialUnicodeMS"
                                         font-size="9pt"
                                         letter-spacing="0.08em">service.imported.configs</fo:inline> - <fo:inline font-family="ProductusOSGiBookc,ArialUnicodeMS"
                                         font-size="9pt"
                                         letter-spacing="0.08em">(String+)</fo:inline>
          The configuration information used to import this service. Any
          associated properties for this configuration types must be properly
          mapped to the importing system. For example, a URL in these
          properties must point to a valid resource when used in the importing
          framework, see <fo:basic-link xmlns:d="http://docbook.org/ns/docbook"
                                             xmlns:xlink="http://www.w3.org/1999/xlink"
                                             internal-destination="i1887526">
                                 <fo:inline color="inherit"
                                            font-family="inherit"
                                            letter-spacing="inherit"
                                            hyphenate="inherit">
                                    <fo:inline font-style="italic">Resource Containment</fo:inline> on page <fo:page-number-citation ref-id="i1887526"/>
                                 </fo:inline>
                              </fo:basic-link>. Multiple configuration
          types can be listed if they are synonyms for exactly the same
          Endpoint that is used to export this service.</fo:block>
                        </fo:block>
                     </fo:list-item-body>
                  </fo:list-item>
                  <fo:list-item space-before.optimum="2pt"
                                space-before.minimum="2pt"
                                space-before.maximum="2pt"
                                id="d61e809">
                     <fo:list-item-label end-indent="label-end()">
                        <fo:block>•</fo:block>
                     </fo:list-item-label>
                     <fo:list-item-body start-indent="body-start()">
                        <fo:block>
                           <fo:block>
                              <fo:inline font-family="ProductusOSGiBookc,ArialUnicodeMS"
                                         font-size="9pt"
                                         letter-spacing="0.08em">service.intents</fo:inline> - <fo:inline font-family="ProductusOSGiBookc,ArialUnicodeMS"
                                         font-size="9pt"
                                         letter-spacing="0.08em">(String+)</fo:inline> The
          Remote Service Admin must set this property to convey the combined
          intents of:</fo:block>
                           <fo:list-block provisional-label-separation="0.2em"
                                          provisional-distance-between-starts="12pt"
                                          id="d61e815">
                              <fo:list-item space-before.optimum="2pt"
                                            space-before.minimum="2pt"
                                            space-before.maximum="2pt"
                                            id="d61e816">
                                 <fo:list-item-label end-indent="label-end()">
                                    <fo:block>•</fo:block>
                                 </fo:list-item-label>
                                 <fo:list-item-body start-indent="body-start()">
                                    <fo:block>
                                       <fo:block>The exporting service, and</fo:block>
                                    </fo:block>
                                 </fo:list-item-body>
                              </fo:list-item>
                              <fo:list-item space-before.optimum="2pt"
                                            space-before.minimum="2pt"
                                            space-before.maximum="2pt"
                                            id="d61e818">
                                 <fo:list-item-label end-indent="label-end()">
                                    <fo:block>•</fo:block>
                                 </fo:list-item-label>
                                 <fo:list-item-body start-indent="body-start()">
                                    <fo:block>
                                       <fo:block>The intents that the exporting distribution provider adds,
              and</fo:block>
                                    </fo:block>
                                 </fo:list-item-body>
                              </fo:list-item>
                              <fo:list-item space-before.optimum="2pt"
                                            space-before.minimum="2pt"
                                            space-before.maximum="2pt"
                                            id="d61e820">
                                 <fo:list-item-label end-indent="label-end()">
                                    <fo:block>•</fo:block>
                                 </fo:list-item-label>
                                 <fo:list-item-body start-indent="body-start()">
                                    <fo:block>
                                       <fo:block>The intents that the importing distribution provider
              adds.</fo:block>
                                    </fo:block>
                                 </fo:list-item-body>
                              </fo:list-item>
                           </fo:list-block>
                        </fo:block>
                     </fo:list-item-body>
                  </fo:list-item>
                  <fo:list-item space-before.optimum="2pt"
                                space-before.minimum="2pt"
                                space-before.maximum="2pt"
                                id="d61e822">
                     <fo:list-item-label end-indent="label-end()">
                        <fo:block>•</fo:block>
                     </fo:list-item-label>
                     <fo:list-item-body start-indent="body-start()">
                        <fo:block>
                           <fo:block>Any additional properties listed in the Endpoint Description
          that should not be excluded. See <fo:basic-link xmlns:d="http://docbook.org/ns/docbook"
                                             xmlns:xlink="http://www.w3.org/1999/xlink"
                                             internal-destination="service.remoteserviceadmin.endpointdescription">
                                 <fo:inline color="inherit"
                                            font-family="inherit"
                                            letter-spacing="inherit"
                                            hyphenate="inherit">
                                    <fo:inline font-style="italic">Endpoint Description</fo:inline> on page <fo:page-number-citation ref-id="service.remoteserviceadmin.endpointdescription"/>
                                 </fo:inline>
                              </fo:basic-link> for more
          details about the properties in the Endpoint Description.</fo:block>
                        </fo:block>
                     </fo:list-item-body>
                  </fo:list-item>
               </fo:list-block>
               <fo:block space-before.optimum="5pt"
                         space-before.minimum="5pt"
                         space-before.maximum="5pt">A Remote Service Admin service must strictly follow the rules for
      importing a service as outlined in the Remote Services chapter.</fo:block>
               <fo:block space-before.optimum="5pt"
                         space-before.minimum="5pt"
                         space-before.maximum="5pt">The Remote Service Admin must return an
      <fo:inline font-family="ProductusOSGiBookc,ArialUnicodeMS"
                             font-size="9pt"
                             letter-spacing="0.08em">ImportRegistration</fo:inline> object or <fo:inline font-family="ProductusOSGiBookc,ArialUnicodeMS"
                             font-size="9pt"
                             letter-spacing="0.08em">null</fo:inline>. Even if an
      Import Registration is returned, it can still be an <fo:inline font-style="italic">invalid
      registration</fo:inline>, see <fo:basic-link xmlns:d="http://docbook.org/ns/docbook"
                                 xmlns:xlink="http://www.w3.org/1999/xlink"
                                 internal-destination="i1791501">
                     <fo:inline color="inherit"
                                font-family="inherit"
                                letter-spacing="inherit"
                                hyphenate="inherit">
                        <fo:inline font-style="italic">Invalid Registrations</fo:inline> on page <fo:page-number-citation ref-id="i1791501"/>
                     </fo:inline>
                  </fo:basic-link> if the setup of
      the connection failed asynchronously. The Import Registration must
      always be a new object. Each valid Import Registration corresponds to a
      proxy service, potentially shared, that was created for the given
      Endpoint. The issues around proxying are described in <fo:basic-link xmlns:d="http://docbook.org/ns/docbook"
                                 xmlns:xlink="http://www.w3.org/1999/xlink"
                                 internal-destination="i1742961">
                     <fo:inline color="inherit"
                                font-family="inherit"
                                letter-spacing="inherit"
                                hyphenate="inherit">
                        <fo:inline font-style="italic">Proxying</fo:inline> on page <fo:page-number-citation ref-id="i1742961"/>
                     </fo:inline>
                  </fo:basic-link>.</fo:block>
               <fo:block space-before.optimum="5pt"
                         space-before.minimum="5pt"
                         space-before.maximum="5pt">For each successful creation of an import registration, the Remote
      Service Admin service must publish an <fo:basic-link xmlns:d="http://docbook.org/ns/docbook"
                                 xmlns:xlink="http://www.w3.org/1999/xlink"
                                 internal-destination="org.osgi.service.remoteserviceadmin.RemoteServiceAdminEvent.IMPORT_REGISTRATION">
                     <fo:inline color="blue"
                                font-family="ProductusOSGiBookc,ArialUnicodeMS"
                                letter-spacing="0.08em"
                                hyphenate="false">IMPORT_REGISTRATION</fo:inline>
                  </fo:basic-link> event, if there is an error it must publish an
      <fo:basic-link xmlns:d="http://docbook.org/ns/docbook"
                                 xmlns:xlink="http://www.w3.org/1999/xlink"
                                 internal-destination="org.osgi.service.remoteserviceadmin.RemoteServiceAdminEvent.IMPORT_ERROR">
                     <fo:inline color="blue"
                                font-family="ProductusOSGiBookc,ArialUnicodeMS"
                                letter-spacing="0.08em"
                                hyphenate="false">IMPORT_ERROR</fo:inline>
                  </fo:basic-link>, see <fo:basic-link xmlns:d="http://docbook.org/ns/docbook"
                                 xmlns:xlink="http://www.w3.org/1999/xlink"
                                 internal-destination="i1736220">
                     <fo:inline color="inherit"
                                font-family="inherit"
                                letter-spacing="inherit"
                                hyphenate="inherit">
                        <fo:inline font-style="italic">Events</fo:inline> on page <fo:page-number-citation ref-id="i1736220"/>
                     </fo:inline>
                  </fo:basic-link>.</fo:block>
               <fo:block space-before.optimum="5pt"
                         space-before.minimum="5pt"
                         space-before.maximum="5pt">For more information see <fo:basic-link xmlns:d="http://docbook.org/ns/docbook"
                                 xmlns:xlink="http://www.w3.org/1999/xlink"
                                 internal-destination="i1736585">
                     <fo:inline color="inherit"
                                font-family="inherit"
                                letter-spacing="inherit"
                                hyphenate="inherit">
                        <fo:inline font-style="italic">Registration Life Cycle</fo:inline> on page <fo:page-number-citation ref-id="i1736585"/>
                     </fo:inline>
                  </fo:basic-link>.</fo:block>
               <fo:block space-before.optimum="5pt"
                         space-before.minimum="5pt"
                         space-before.maximum="5pt">The Import Registration provides access to an <fo:basic-link xmlns:d="http://docbook.org/ns/docbook"
                                 xmlns:xlink="http://www.w3.org/1999/xlink"
                                 internal-destination="org.osgi.service.remoteserviceadmin.ImportReference">
                     <fo:inline color="blue"
                                font-family="ProductusOSGiBookc,ArialUnicodeMS"
                                letter-spacing="0.08em"
                                hyphenate="false">ImportReference</fo:inline>
                  </fo:basic-link> object with the <fo:basic-link xmlns:d="http://docbook.org/ns/docbook"
                                 xmlns:xlink="http://www.w3.org/1999/xlink"
                                 internal-destination="org.osgi.service.remoteserviceadmin.ImportRegistration.getImportReference--">
                     <fo:inline color="blue"
                                font-family="ProductusOSGiBookc,ArialUnicodeMS"
                                letter-spacing="0.08em"
                                hyphenate="false">getImportReference()</fo:inline>
                  </fo:basic-link>. This object has the following methods:</fo:block>
               <fo:list-block space-before.optimum="1em"
                              space-before.minimum="0.8em"
                              space-before.maximum="1.2em"
                              space-after.optimum="1em"
                              space-after.minimum="0.8em"
                              space-after.maximum="1.2em"
                              provisional-label-separation="0.2em"
                              provisional-distance-between-starts="12pt"
                              id="d61e859">
                  <fo:list-item space-before.optimum="2pt"
                                space-before.minimum="2pt"
                                space-before.maximum="2pt"
                                id="d61e860">
                     <fo:list-item-label end-indent="label-end()">
                        <fo:block>•</fo:block>
                     </fo:list-item-label>
                     <fo:list-item-body start-indent="body-start()">
                        <fo:block>
                           <fo:block>
                              <fo:basic-link xmlns:d="http://docbook.org/ns/docbook"
                                             xmlns:xlink="http://www.w3.org/1999/xlink"
                                             internal-destination="org.osgi.service.remoteserviceadmin.ImportReference.getImportedEndpoint--">
                                 <fo:inline color="blue"
                                            font-family="ProductusOSGiBookc,ArialUnicodeMS"
                                            letter-spacing="0.08em"
                                            hyphenate="false">getImportedEndpoint()</fo:inline>
                              </fo:basic-link> - Provides the Endpoint Description for this
          imported service.</fo:block>
                        </fo:block>
                     </fo:list-item-body>
                  </fo:list-item>
                  <fo:list-item space-before.optimum="2pt"
                                space-before.minimum="2pt"
                                space-before.maximum="2pt"
                                id="d61e864">
                     <fo:list-item-label end-indent="label-end()">
                        <fo:block>•</fo:block>
                     </fo:list-item-label>
                     <fo:list-item-body start-indent="body-start()">
                        <fo:block>
                           <fo:block>
                              <fo:basic-link xmlns:d="http://docbook.org/ns/docbook"
                                             xmlns:xlink="http://www.w3.org/1999/xlink"
                                             internal-destination="org.osgi.service.remoteserviceadmin.ImportReference.getImportedService--">
                                 <fo:inline color="blue"
                                            font-family="ProductusOSGiBookc,ArialUnicodeMS"
                                            letter-spacing="0.08em"
                                            hyphenate="false">getImportedService()</fo:inline>
                              </fo:basic-link> - Provides the Service Reference for the
          service proxy.</fo:block>
                        </fo:block>
                     </fo:list-item-body>
                  </fo:list-item>
               </fo:list-block>
               <fo:block space-before.optimum="5pt"
                         space-before.minimum="5pt"
                         space-before.maximum="5pt">The Import Registration will remain open as long as:</fo:block>
               <fo:list-block space-before.optimum="1em"
                              space-before.minimum="0.8em"
                              space-before.maximum="1.2em"
                              space-after.optimum="1em"
                              space-after.minimum="0.8em"
                              space-after.maximum="1.2em"
                              provisional-label-separation="0.2em"
                              provisional-distance-between-starts="12pt"
                              id="d61e869">
                  <fo:list-item space-before.optimum="2pt"
                                space-before.minimum="2pt"
                                space-before.maximum="2pt"
                                id="d61e870">
                     <fo:list-item-label end-indent="label-end()">
                        <fo:block>•</fo:block>
                     </fo:list-item-label>
                     <fo:list-item-body start-indent="body-start()">
                        <fo:block>
                           <fo:block>The corresponding remote Endpoint remains available,
          and</fo:block>
                        </fo:block>
                     </fo:list-item-body>
                  </fo:list-item>
                  <fo:list-item space-before.optimum="2pt"
                                space-before.minimum="2pt"
                                space-before.maximum="2pt"
                                id="d61e872">
                     <fo:list-item-label end-indent="label-end()">
                        <fo:block>•</fo:block>
                     </fo:list-item-label>
                     <fo:list-item-body start-indent="body-start()">
                        <fo:block>
                           <fo:block>The Remote Service Admin service is still in use by the
          Topology Manager that created the Import Registration.</fo:block>
                        </fo:block>
                     </fo:list-item-body>
                  </fo:list-item>
               </fo:list-block>
               <fo:block space-before.optimum="5pt"
                         space-before.minimum="5pt"
                         space-before.maximum="5pt">That is, the Import Registrations are not permanent, any
      persistence is in the realm of the Topology Manager. See <fo:basic-link xmlns:d="http://docbook.org/ns/docbook"
                                 xmlns:xlink="http://www.w3.org/1999/xlink"
                                 internal-destination="i1736585">
                     <fo:inline color="inherit"
                                font-family="inherit"
                                letter-spacing="inherit"
                                hyphenate="inherit">
                        <fo:inline font-style="italic">Registration Life Cycle</fo:inline> on page <fo:page-number-citation ref-id="i1736585"/>
                     </fo:inline>
                  </fo:basic-link> for more details.</fo:block>
            </fo:block>
            <fo:block id="d61e878">
               <fo:block>
                  <fo:block>
                     <fo:block keep-together.within-column="always"
                               margin-left="0pt"
                               font-family="ProductusSemibold,ArialUnicodeMS">
                        <fo:block keep-with-next.within-column="always">
                           <fo:block xmlns:d="http://docbook.org/ns/docbook"
                                     xmlns:xlink="http://www.w3.org/1999/xlink"
                                     font-family="ProductusSemibold,ArialUnicodeMS"
                                     font-weight="normal"
                                     keep-with-next.within-column="always"
                                     space-before.minimum="0.8em"
                                     space-before.optimum="1.0em"
                                     space-before.maximum="1.2em"
                                     text-align="start"
                                     start-indent="0pt"
                                     hyphenate="false">
                              <fo:block font-size="12pt"
                                        line-height="14pt"
                                        space-before="8pt"
                                        space-after="5pt">
                                 <fo:list-block provisional-distance-between-starts="1in"
                                                provisional-label-separation="0.090in">
                                    <fo:list-item>
                                       <fo:list-item-label end-indent="label-end()" text-align="start">
                                          <fo:block>122.5.3</fo:block>
                                       </fo:list-item-label>
                                       <fo:list-item-body start-indent="body-start()">
                                          <fo:block>Updates</fo:block>
                                       </fo:list-item-body>
                                    </fo:list-item>
                                 </fo:list-block>
                              </fo:block>
                           </fo:block>
                        </fo:block>
                     </fo:block>
                  </fo:block>
               </fo:block>
               <fo:block space-before.optimum="5pt"
                         space-before.minimum="5pt"
                         space-before.maximum="5pt">Services Registrations are dynamic and service properties may
      change during the lifetime of a service. Remote services must mirror
      these dynamics without making it appear as though the service has become
      unavailable. This requires that the exporting distribution provider and
      the importing distribution provider support the changing of service
      properties.</fo:block>
               <fo:block space-before.optimum="5pt"
                         space-before.minimum="5pt"
                         space-before.maximum="5pt">There are two types of service properties:</fo:block>
               <fo:list-block space-before.optimum="1em"
                              space-before.minimum="0.8em"
                              space-before.maximum="1.2em"
                              space-after.optimum="1em"
                              space-after.minimum="0.8em"
                              space-after.maximum="1.2em"
                              provisional-label-separation="0.2em"
                              provisional-distance-between-starts="12pt"
                              id="d61e882">
                  <fo:list-item space-before.optimum="2pt"
                                space-before.minimum="2pt"
                                space-before.maximum="2pt"
                                id="d61e883">
                     <fo:list-item-label end-indent="label-end()">
                        <fo:block>•</fo:block>
                     </fo:list-item-label>
                     <fo:list-item-body start-indent="body-start()">
                        <fo:block>
                           <fo:block>Properties that are intended to be consumed by the
          distribution provider, such as: the exported interfaces and
          configuration types, exported intents and configuration type
          specific properties. These properties are typically prefixed with
          <fo:inline font-family="ProductusOSGiBookc,ArialUnicodeMS"
                                         font-size="9pt"
                                         letter-spacing="0.08em">'service.'</fo:inline> or <fo:inline font-family="ProductusOSGiBookc,ArialUnicodeMS"
                                         font-size="9pt"
                                         letter-spacing="0.08em">'endpoint.'</fo:inline> see <fo:basic-link xmlns:d="http://docbook.org/ns/docbook"
                                             xmlns:xlink="http://www.w3.org/1999/xlink"
                                             internal-destination="service.remoteserviceadmin-endpoint.properties">
                                 <fo:inline color="inherit"
                                            font-family="inherit"
                                            letter-spacing="inherit"
                                            hyphenate="inherit">Table 122.1 on page <fo:page-number-citation ref-id="service.remoteserviceadmin-endpoint.properties"/>
                                 </fo:inline>
                              </fo:basic-link>.</fo:block>
                        </fo:block>
                     </fo:list-item-body>
                  </fo:list-item>
                  <fo:list-item space-before.optimum="2pt"
                                space-before.minimum="2pt"
                                space-before.maximum="2pt"
                                id="d61e892">
                     <fo:list-item-label end-indent="label-end()">
                        <fo:block>•</fo:block>
                     </fo:list-item-label>
                     <fo:list-item-body start-indent="body-start()">
                        <fo:block>
                           <fo:block>Service properties not intended for the distribution provider.
          These are typically used to communicate information to the consumer
          of the service and are often specific to the domain of the
          service.</fo:block>
                        </fo:block>
                     </fo:list-item-body>
                  </fo:list-item>
               </fo:list-block>
               <fo:block space-before.optimum="5pt"
                         space-before.minimum="5pt"
                         space-before.maximum="5pt">The following methods to support the updating of service
      properties on Export Registrations and the propagation of these updates
      to the remote proxies via Import Registrations.</fo:block>
               <fo:list-block space-before.optimum="1em"
                              space-before.minimum="0.8em"
                              space-before.maximum="1.2em"
                              space-after.optimum="1em"
                              space-after.minimum="0.8em"
                              space-after.maximum="1.2em"
                              provisional-label-separation="0.2em"
                              provisional-distance-between-starts="12pt"
                              id="d61e895">
                  <fo:list-item space-before.optimum="2pt"
                                space-before.minimum="2pt"
                                space-before.maximum="2pt"
                                id="d61e896">
                     <fo:list-item-label end-indent="label-end()">
                        <fo:block>•</fo:block>
                     </fo:list-item-label>
                     <fo:list-item-body start-indent="body-start()">
                        <fo:block>
                           <fo:block>ExportRegistration.<fo:basic-link xmlns:d="http://docbook.org/ns/docbook"
                                             xmlns:xlink="http://www.w3.org/1999/xlink"
                                             internal-destination="org.osgi.service.remoteserviceadmin.ExportRegistration.update-Map-">
                                 <fo:inline color="blue"
                                            font-family="ProductusOSGiBookc,ArialUnicodeMS"
                                            letter-spacing="0.08em"
                                            hyphenate="false">update(Map)</fo:inline>
                              </fo:basic-link> - Allows the Topology Manager to update an
          existing export registration it created after receiving a
          notification of changed properties on the remoted service.</fo:block>
                        </fo:block>
                     </fo:list-item-body>
                  </fo:list-item>
                  <fo:list-item space-before.optimum="2pt"
                                space-before.minimum="2pt"
                                space-before.maximum="2pt"
                                id="d61e901">
                     <fo:list-item-label end-indent="label-end()">
                        <fo:block>•</fo:block>
                     </fo:list-item-label>
                     <fo:list-item-body start-indent="body-start()">
                        <fo:block>
                           <fo:block>ImportRegistration.<fo:basic-link xmlns:d="http://docbook.org/ns/docbook"
                                             xmlns:xlink="http://www.w3.org/1999/xlink"
                                             internal-destination="org.osgi.service.remoteserviceadmin.ImportRegistration.update-EndpointDescription-">
                                 <fo:inline color="blue"
                                            font-family="ProductusOSGiBookc,ArialUnicodeMS"
                                            letter-spacing="0.08em"
                                            hyphenate="false">update(EndpointDescription)</fo:inline>
                              </fo:basic-link> - Allows the Topology Manager to update the
          import registration representing a remote service after the remote
          service properties have been updated. Typically the topology manager
          is notified of such change via the Discovery mechanism.</fo:block>
                        </fo:block>
                     </fo:list-item-body>
                  </fo:list-item>
               </fo:list-block>
               <fo:block space-before.optimum="5pt"
                         space-before.minimum="5pt"
                         space-before.maximum="5pt">The distribution provider must support the updates of service
      properties <fo:inline font-style="italic">not</fo:inline> intended for the distribution
      provider, where supported property values are as defined in the
      <fo:inline font-style="italic">Filter Syntax</fo:inline> of <fo:inline color="inherit"
                             font-family="inherit"
                             letter-spacing="inherit"
                             hyphenate="inherit">???</fo:inline>. Distribution providers may support updates to
      a wider set of properties or data types, but these may fail with other
      implementations.</fo:block>
            </fo:block>
            <fo:block id="d61e914">
               <fo:block>
                  <fo:block>
                     <fo:block keep-together.within-column="always"
                               margin-left="0pt"
                               font-family="ProductusSemibold,ArialUnicodeMS">
                        <fo:block keep-with-next.within-column="always">
                           <fo:block xmlns:d="http://docbook.org/ns/docbook"
                                     xmlns:xlink="http://www.w3.org/1999/xlink"
                                     font-family="ProductusSemibold,ArialUnicodeMS"
                                     font-weight="normal"
                                     keep-with-next.within-column="always"
                                     space-before.minimum="0.8em"
                                     space-before.optimum="1.0em"
                                     space-before.maximum="1.2em"
                                     text-align="start"
                                     start-indent="0pt"
                                     hyphenate="false">
                              <fo:block font-size="12pt"
                                        line-height="14pt"
                                        space-before="8pt"
                                        space-after="5pt">
                                 <fo:list-block provisional-distance-between-starts="1in"
                                                provisional-label-separation="0.090in">
                                    <fo:list-item>
                                       <fo:list-item-label end-indent="label-end()" text-align="start">
                                          <fo:block>122.5.4</fo:block>
                                       </fo:list-item-label>
                                       <fo:list-item-body start-indent="body-start()">
                                          <fo:block>Reflection</fo:block>
                                       </fo:list-item-body>
                                    </fo:list-item>
                                 </fo:list-block>
                              </fo:block>
                           </fo:block>
                        </fo:block>
                     </fo:block>
                  </fo:block>
               </fo:block>
               <fo:block space-before.optimum="5pt"
                         space-before.minimum="5pt"
                         space-before.maximum="5pt">The Remote Service Admin service provides the following methods to
      get the list of the current exported and imported services:</fo:block>
               <fo:list-block space-before.optimum="1em"
                              space-before.minimum="0.8em"
                              space-before.maximum="1.2em"
                              space-after.optimum="1em"
                              space-after.minimum="0.8em"
                              space-after.maximum="1.2em"
                              provisional-label-separation="0.2em"
                              provisional-distance-between-starts="12pt"
                              id="d61e917">
                  <fo:list-item space-before.optimum="2pt"
                                space-before.minimum="2pt"
                                space-before.maximum="2pt"
                                id="d61e918">
                     <fo:list-item-label end-indent="label-end()">
                        <fo:block>•</fo:block>
                     </fo:list-item-label>
                     <fo:list-item-body start-indent="body-start()">
                        <fo:block>
                           <fo:block>
                              <fo:basic-link xmlns:d="http://docbook.org/ns/docbook"
                                             xmlns:xlink="http://www.w3.org/1999/xlink"
                                             internal-destination="org.osgi.service.remoteserviceadmin.RemoteServiceAdmin.getExportedServices--">
                                 <fo:inline color="blue"
                                            font-family="ProductusOSGiBookc,ArialUnicodeMS"
                                            letter-spacing="0.08em"
                                            hyphenate="false">getExportedServices()</fo:inline>
                              </fo:basic-link> - List the Export References for services
          that are exported by this Remote Service Admin service as directed
          by any of the Topology Managers.</fo:block>
                        </fo:block>
                     </fo:list-item-body>
                  </fo:list-item>
                  <fo:list-item space-before.optimum="2pt"
                                space-before.minimum="2pt"
                                space-before.maximum="2pt"
                                id="d61e922">
                     <fo:list-item-label end-indent="label-end()">
                        <fo:block>•</fo:block>
                     </fo:list-item-label>
                     <fo:list-item-body start-indent="body-start()">
                        <fo:block>
                           <fo:block>
                              <fo:basic-link xmlns:d="http://docbook.org/ns/docbook"
                                             xmlns:xlink="http://www.w3.org/1999/xlink"
                                             internal-destination="org.osgi.service.remoteserviceadmin.RemoteServiceAdmin.getImportedEndpoints--">
                                 <fo:inline color="blue"
                                            font-family="ProductusOSGiBookc,ArialUnicodeMS"
                                            letter-spacing="0.08em"
                                            hyphenate="false">getImportedEndpoints()</fo:inline>
                              </fo:basic-link> - List the Import References for services
          that have been imported by this Remote Service Admin service as
          directed by any of the Topology Managers.</fo:block>
                        </fo:block>
                     </fo:list-item-body>
                  </fo:list-item>
               </fo:list-block>
            </fo:block>
            <fo:block id="i1736585">
               <fo:block>
                  <fo:block>
                     <fo:block keep-together.within-column="always"
                               margin-left="0pt"
                               font-family="ProductusSemibold,ArialUnicodeMS">
                        <fo:block keep-with-next.within-column="always">
                           <fo:block xmlns:d="http://docbook.org/ns/docbook"
                                     xmlns:xlink="http://www.w3.org/1999/xlink"
                                     font-family="ProductusSemibold,ArialUnicodeMS"
                                     font-weight="normal"
                                     keep-with-next.within-column="always"
                                     space-before.minimum="0.8em"
                                     space-before.optimum="1.0em"
                                     space-before.maximum="1.2em"
                                     text-align="start"
                                     start-indent="0pt"
                                     hyphenate="false">
                              <fo:block font-size="12pt"
                                        line-height="14pt"
                                        space-before="8pt"
                                        space-after="5pt">
                                 <fo:list-block provisional-distance-between-starts="1in"
                                                provisional-label-separation="0.090in">
                                    <fo:list-item>
                                       <fo:list-item-label end-indent="label-end()" text-align="start">
                                          <fo:block>122.5.5</fo:block>
                                       </fo:list-item-label>
                                       <fo:list-item-body start-indent="body-start()">
                                          <fo:block>Registration Life Cycle</fo:block>
                                       </fo:list-item-body>
                                    </fo:list-item>
                                 </fo:list-block>
                              </fo:block>
                           </fo:block>
                        </fo:block>
                     </fo:block>
                  </fo:block>
               </fo:block>
               <fo:block space-before.optimum="5pt"
                         space-before.minimum="5pt"
                         space-before.maximum="5pt">All registrations obtained through a Remote Service Admin service
      are life cycle bound to the Topology Manager that created it. That is,
      if a Topology Manager ungets its Remote Service Admin service, all
      registrations obtained through this service must automatically be
      closed. This model ensures that all registrations are properly closed if
      either the Remote Service Admin or the Topology Manager stops because in
      both cases the framework performs the unget automatically. Such behavior
      can be achieved by implementing the Remote Service Admin service as a
      Service Factory.</fo:block>
            </fo:block>
            <fo:block id="i1791501">
               <fo:block>
                  <fo:block>
                     <fo:block keep-together.within-column="always"
                               margin-left="0pt"
                               font-family="ProductusSemibold,ArialUnicodeMS">
                        <fo:block keep-with-next.within-column="always">
                           <fo:block xmlns:d="http://docbook.org/ns/docbook"
                                     xmlns:xlink="http://www.w3.org/1999/xlink"
                                     font-family="ProductusSemibold,ArialUnicodeMS"
                                     font-weight="normal"
                                     keep-with-next.within-column="always"
                                     space-before.minimum="0.8em"
                                     space-before.optimum="1.0em"
                                     space-before.maximum="1.2em"
                                     text-align="start"
                                     start-indent="0pt"
                                     hyphenate="false">
                              <fo:block font-size="12pt"
                                        line-height="14pt"
                                        space-before="8pt"
                                        space-after="5pt">
                                 <fo:list-block provisional-distance-between-starts="1in"
                                                provisional-label-separation="0.090in">
                                    <fo:list-item>
                                       <fo:list-item-label end-indent="label-end()" text-align="start">
                                          <fo:block>122.5.6</fo:block>
                                       </fo:list-item-label>
                                       <fo:list-item-body start-indent="body-start()">
                                          <fo:block>Invalid Registrations</fo:block>
                                       </fo:list-item-body>
                                    </fo:list-item>
                                 </fo:list-block>
                              </fo:block>
                           </fo:block>
                        </fo:block>
                     </fo:block>
                  </fo:block>
               </fo:block>
               <fo:block space-before.optimum="5pt"
                         space-before.minimum="5pt"
                         space-before.maximum="5pt">The Remote Service Admin service is explicitly allowed to return
      <fo:inline font-style="italic">invalid</fo:inline> Import and Export Registrations. First, in
      a communications stack it can take time to discover that there are
      issues, allowing the registration to return before it has completed can
      potentially save time. Second, it allows the Topology Manager to
      discover problems with the configuration information. Without the
      invalid Export Registrations, the Topology Manager would have to scan
      the log or associate the Remote Service Admin Events with a specific
      import/export method call, something that can be difficult to do.</fo:block>
               <fo:block space-before.optimum="5pt"
                         space-before.minimum="5pt"
                         space-before.maximum="5pt">If the registration is invalid, the <fo:basic-link xmlns:d="http://docbook.org/ns/docbook"
                                 xmlns:xlink="http://www.w3.org/1999/xlink"
                                 internal-destination="org.osgi.service.remoteserviceadmin.ExportRegistration.getException--">
                     <fo:inline color="blue"
                                font-family="ProductusOSGiBookc,ArialUnicodeMS"
                                letter-spacing="0.08em"
                                hyphenate="false">getException()</fo:inline>
                  </fo:basic-link> method must return a <fo:inline font-family="ProductusOSGiBookc,ArialUnicodeMS"
                             font-size="9pt"
                             letter-spacing="0.08em">Throwable</fo:inline>
      object. If the registration has initialized correctly, this method will
      return <fo:inline font-family="ProductusOSGiBookc,ArialUnicodeMS"
                             font-size="9pt"
                             letter-spacing="0.08em">null</fo:inline>. The <fo:basic-link xmlns:d="http://docbook.org/ns/docbook"
                                 xmlns:xlink="http://www.w3.org/1999/xlink"
                                 internal-destination="org.osgi.service.remoteserviceadmin.ExportRegistration.getExportReference--">
                     <fo:inline color="blue"
                                font-family="ProductusOSGiBookc,ArialUnicodeMS"
                                letter-spacing="0.08em"
                                hyphenate="false">getExportReference()</fo:inline>
                  </fo:basic-link> and <fo:basic-link xmlns:d="http://docbook.org/ns/docbook"
                                 xmlns:xlink="http://www.w3.org/1999/xlink"
                                 internal-destination="org.osgi.service.remoteserviceadmin.ImportRegistration.getImportReference--">
                     <fo:inline color="blue"
                                font-family="ProductusOSGiBookc,ArialUnicodeMS"
                                letter-spacing="0.08em"
                                hyphenate="false">getImportReference()</fo:inline>
                  </fo:basic-link> methods must throw an Illegal State Exception
      when the registration is invalid. A Remote Service Admin service is
      allowed to block for a reasonable amount of time when any of these
      methods is called, including the <fo:inline font-family="ProductusOSGiBookc,ArialUnicodeMS"
                             font-size="9pt"
                             letter-spacing="0.08em">getException</fo:inline> method, to
      finish initialization.</fo:block>
               <fo:block space-before.optimum="5pt"
                         space-before.minimum="5pt"
                         space-before.maximum="5pt">An invalid registration can be considered as never having been
      opened, it is therefore not necessary to close it; however, closing an
      invalid or closed registration must be a dummy operation and never throw
      an Exception. However, a failed registration must generate a
      corresponding error event.</fo:block>
            </fo:block>
            <fo:block id="i1742961">
               <fo:block>
                  <fo:block>
                     <fo:block keep-together.within-column="always"
                               margin-left="0pt"
                               font-family="ProductusSemibold,ArialUnicodeMS">
                        <fo:block keep-with-next.within-column="always">
                           <fo:block xmlns:d="http://docbook.org/ns/docbook"
                                     xmlns:xlink="http://www.w3.org/1999/xlink"
                                     font-family="ProductusSemibold,ArialUnicodeMS"
                                     font-weight="normal"
                                     keep-with-next.within-column="always"
                                     space-before.minimum="0.8em"
                                     space-before.optimum="1.0em"
                                     space-before.maximum="1.2em"
                                     text-align="start"
                                     start-indent="0pt"
                                     hyphenate="false">
                              <fo:block font-size="12pt"
                                        line-height="14pt"
                                        space-before="8pt"
                                        space-after="5pt">
                                 <fo:list-block provisional-distance-between-starts="1in"
                                                provisional-label-separation="0.090in">
                                    <fo:list-item>
                                       <fo:list-item-label end-indent="label-end()" text-align="start">
                                          <fo:block>122.5.7</fo:block>
                                       </fo:list-item-label>
                                       <fo:list-item-body start-indent="body-start()">
                                          <fo:block>Proxying</fo:block>
                                       </fo:list-item-body>
                                    </fo:list-item>
                                 </fo:list-block>
                              </fo:block>
                           </fo:block>
                        </fo:block>
                     </fo:block>
                  </fo:block>
               </fo:block>
               <fo:block space-before.optimum="5pt"
                         space-before.minimum="5pt"
                         space-before.maximum="5pt">It is the responsibility of the Remote Service Admin service to
      properly proxy an imported service. This specification does not mandate
      the technique used to proxy an Endpoint as a service in the OSGi
      framework. The OSGi Remote Services specification allows a distribution
      provider to limit what it can proxy.</fo:block>
               <fo:block space-before.optimum="5pt"
                         space-before.minimum="5pt"
                         space-before.maximum="5pt">One of the primary aspects of a proxy is to ensure class space
      consistency between the exporting bundle and importing bundles. This can
      require the generation of a proxy-per-bundle to match the proper class
      spaces. It is the responsibility of the Remote Service Admin to ensure
      that no Class Cast Exceptions occur.</fo:block>
               <fo:block space-before.optimum="5pt"
                         space-before.minimum="5pt"
                         space-before.maximum="5pt">A common technique to achieve maximum class space compatibility is
      to use a Service Factory. A Service Factory provides the calling bundle
      when it first gets the service, making it straightforward to verify the
      package version of the interface that the calling bundle uses. Knowing
      the bundle that requests the service allows the creation of specialized
      proxies for each bundle. The interface class(es) for the proxy can then
      be loaded directly from the bundle, ensuring class compatibility.
      Interfaces should be loadable by the bundle otherwise that bundle can
      not use the interface in its code. If an interface cannot be loaded then
      it can be skipped. A dedicated class loader can then be created that has
      visibility to all these interfaces and is used to define the proxy
      class. This design ensures proper visibility and consistency.
      Implementations can optimize this model by sharing compatible class
      loaders between bundles.</fo:block>
               <fo:block space-before.optimum="5pt"
                         space-before.minimum="5pt"
                         space-before.maximum="5pt">The proxy will have to call arbitrary methods on arbitrary
      services. This has a large number of security implications, see <fo:basic-link xmlns:d="http://docbook.org/ns/docbook"
                                 xmlns:xlink="http://www.w3.org/1999/xlink"
                                 internal-destination="i1789427">
                     <fo:inline color="inherit"
                                font-family="inherit"
                                letter-spacing="inherit"
                                hyphenate="inherit">
                        <fo:inline font-style="italic">Security</fo:inline> on page <fo:page-number-citation ref-id="i1789427"/>
                     </fo:inline>
                  </fo:basic-link>.</fo:block>
            </fo:block>
         </fo:block>
         <fo:block id="i1751493">
            <fo:block>
               <fo:block>
                  <fo:block keep-together.within-column="always"
                            margin-left="0pt"
                            font-family="ProductusSemibold,ArialUnicodeMS">
                     <fo:block keep-with-next.within-column="always">
                        <fo:block xmlns:d="http://docbook.org/ns/docbook"
                                  xmlns:xlink="http://www.w3.org/1999/xlink"
                                  font-family="ProductusSemibold,ArialUnicodeMS"
                                  font-weight="normal"
                                  keep-with-next.within-column="always"
                                  space-before.minimum="0.8em"
                                  space-before.optimum="1.0em"
                                  space-before.maximum="1.2em"
                                  text-align="start"
                                  start-indent="0pt"
                                  hyphenate="false">
                           <fo:marker marker-class-name="section.head.marker">Discovery</fo:marker>
                           <fo:block font-size="18pt"
                                     line-height="25pt"
                                     space-before="12.5pt"
                                     space-after="12pt">
                              <fo:list-block provisional-distance-between-starts="1in"
                                             provisional-label-separation="0.090in">
                                 <fo:list-item>
                                    <fo:list-item-label end-indent="label-end()" text-align="start">
                                       <fo:block>122.6</fo:block>
                                    </fo:list-item-label>
                                    <fo:list-item-body start-indent="body-start()">
                                       <fo:block>Discovery</fo:block>
                                    </fo:list-item-body>
                                 </fo:list-item>
                              </fo:list-block>
                           </fo:block>
                        </fo:block>
                     </fo:block>
                  </fo:block>
               </fo:block>
            </fo:block>
            <fo:block space-before.optimum="5pt"
                      space-before.minimum="5pt"
                      space-before.maximum="5pt">The topology of the distributed system is decided by the Topology
    Manager. However, in a distributed environment, the Topology Manager needs
    to <fo:inline font-style="italic">discover</fo:inline> Endpoints in other frameworks. There is a
    very large number of ways how a Topology Manager could learn about other
    Endpoints, ranging from static configuration, a centralized
    administration, all the way to fully dynamic discovery protocols like the
    Service Location Protocol (SLP) or JGroups. To support the required
    flexibility, this specification defines an <fo:inline font-style="italic">Endpoint Event
    Listener</fo:inline> service that allows the dissemination of Endpoint
    information. This service provides a symmetric solution because the
    problem is symmetric: it is used by a Topology Manager to announce changes
    in its local topology as well as find out about other Endpoint
    Descriptions. Where those other Endpoint Descriptions come from can vary
    widely. This design is depicted in <fo:basic-link xmlns:d="http://docbook.org/ns/docbook"
                              xmlns:xlink="http://www.w3.org/1999/xlink"
                              internal-destination="i1753219">
                  <fo:inline color="inherit"
                             font-family="inherit"
                             letter-spacing="inherit"
                             hyphenate="inherit">Figure 122.4 on page <fo:page-number-citation ref-id="i1753219"/>
                  </fo:inline>
               </fo:basic-link>.</fo:block>
            <fo:block space-before.minimum="0.5em"
                      space-before.optimum="1em"
                      space-before.maximum="2em"
                      space-after.minimum="0.5em"
                      space-after.optimum="1em"
                      space-after.maximum="2em"
                      keep-together.within-column="always"
                      id="i1753219">
               <fo:block xmlns:d="http://docbook.org/ns/docbook"
                         xmlns:xlink="http://www.w3.org/1999/xlink"
                         space-before.optimum="5pt"
                         space-before.minimum="5pt"
                         space-before.maximum="5pt"
                         font-weight="normal"
                         font-size="9pt"
                         hyphenate="false"
                         space-after.minimum="0.4em"
                         space-after.optimum="0.6em"
                         space-after.maximum="0.8em"
                         start-indent="0pt"
                         font-family="Proforma-Book,ArialUnicodeMS"
                         font-style="italic"
                         keep-with-next.within-column="always">
                  <fo:list-block provisional-distance-between-starts="1in"
                                 provisional-label-separation="0.090in">
                     <fo:list-item>
                        <fo:list-item-label end-indent="label-end()" text-align="start">
                           <fo:block>Figure 122.4</fo:block>
                        </fo:list-item-label>
                        <fo:list-item-body start-indent="body-start()">
                           <fo:block>Examples</fo:block>
                        </fo:list-item-body>
                     </fo:list-item>
                  </fo:list-block>
               </fo:block>
               <fo:block id="d61e972" text-align="center">
                  <fo:external-graphic src="url(file:///home/stbischof/git/OSGI_MIGRATE/osgi_target/org.osgi.service.remoteserviceadmin/spec/org.osgi.spec.service.remoteserviceadmin/src/main/resources/spec/topology-example.svg)"
                                       width="auto"
                                       height="auto"
                                       content-width="7.000in"
                                       content-height="2.532in"
                                       text-align="center"/>
               </fo:block>
            </fo:block>
            <fo:block space-before.optimum="5pt"
                      space-before.minimum="5pt"
                      space-before.maximum="5pt">The design of the Endpoint Event Listener allows a federated
    registry of Endpoint Descriptions. Any party that is interested in
    Endpoint Descriptions should register an Endpoint Event Listener service.
    This will signal that it is interested in topology information to any
    <fo:inline font-style="italic">Endpoint Description Providers</fo:inline>. Each Endpoint Event
    Listener service must be registered with a service property that holds a
    set of filter strings to indicate the <fo:inline font-style="italic">scope</fo:inline> of its
    interest. These filters must match an Endpoint Description before the
    corresponding Endpoint Event Listener service is notified of the
    availability of an Endpoint Description. Scoping is intended to limit the
    delivery of unnecessary Endpoint Descriptions as well as signal the need
    for specific Endpoints.</fo:block>
            <fo:block space-before.optimum="5pt"
                      space-before.minimum="5pt"
                      space-before.maximum="5pt">In addition to providing an Endpoint Event Listener actors must
    provide an Endpoint Listener. This may, or may not, be the same service
    object as the Endpoint Event Listener. Registering an Endpoint Listener in
    addition to an Endpoint Event Listener ensures that Endpoint announcements
    from version <fo:inline font-family="ProductusOSGiBookc,ArialUnicodeMS"
                          font-size="9pt"
                          letter-spacing="0.08em">1.0</fo:inline> actors will continue to be visible. If a
    service object is advertised as both an Endpoint Listener
    <fo:inline font-style="italic">and</fo:inline> an Endpoint Event Listener then version
    <fo:inline font-family="ProductusOSGiBookc,ArialUnicodeMS"
                          font-size="9pt"
                          letter-spacing="0.08em">1.1</fo:inline> actors must use the Endpoint Event Listener interface of
    the service in preference, and not call it as an Endpoint Listener. For
    this reason the Endpoint Listener interface is marked as
    <fo:inline font-family="ProductusOSGiBookc,ArialUnicodeMS"
                          font-size="9pt"
                          letter-spacing="0.08em">Deprecated</fo:inline>. The reason that the Endpoint Event Listener
    interface should be preferred is that it supports more advanced
    notification types, such as modification events.</fo:block>
            <fo:block space-before.optimum="5pt"
                      space-before.minimum="5pt"
                      space-before.maximum="5pt">A Topology Manager has knowledge of its local Endpoints and is
    likely to be only interested in remote Endpoints. It can therefore set the
    scope to only match remote Endpoint Descriptions. See <fo:basic-link xmlns:d="http://docbook.org/ns/docbook"
                              xmlns:xlink="http://www.w3.org/1999/xlink"
                              internal-destination="i1887500">
                  <fo:inline color="inherit"
                             font-family="inherit"
                             letter-spacing="inherit"
                             hyphenate="inherit">
                     <fo:inline font-style="italic">Framework UUID</fo:inline> on page <fo:page-number-citation ref-id="i1887500"/>
                  </fo:inline>
               </fo:basic-link> for how to limit the scope to local or remote
    Endpoints. At the same time, a Topology manager should inform any locally
    registered Endpoint Event Listener and Endpoint Listener services about
    Endpoints that it has created or deleted.</fo:block>
            <fo:block space-before.optimum="5pt"
                      space-before.minimum="5pt"
                      space-before.maximum="5pt">This architecture allows many different use cases. For example, a
    bundle could display a map of the topology by registering an Endpoint
    Event Listener with a scope for local Endpoints. Another example is the
    use of SLP to announce local Endpoints to a network and to discover remote
    Endpoints from other parties on this network.</fo:block>
            <fo:block space-before.optimum="5pt"
                      space-before.minimum="5pt"
                      space-before.maximum="5pt">An instance of this design is shown in <fo:basic-link xmlns:d="http://docbook.org/ns/docbook"
                              xmlns:xlink="http://www.w3.org/1999/xlink"
                              internal-destination="i1751511">
                  <fo:inline color="inherit"
                             font-family="inherit"
                             letter-spacing="inherit"
                             hyphenate="inherit">Figure 122.5 on page <fo:page-number-citation ref-id="i1751511"/>
                  </fo:inline>
               </fo:basic-link>. In this figure, there are 3
    frameworks that collaborate through some discovery bundle. The
    <fo:inline font-family="ProductusOSGiBookc,ArialUnicodeMS"
                          font-size="9pt"
                          letter-spacing="0.08em">Top</fo:inline> framework has created an Endpoint and decides to notify
    all Endpoint Event Listeners and Endpoint Listeners registered in this
    framework that are scoped to this new Endpoint. Local bundle
    <fo:inline font-family="ProductusOSGiBookc,ArialUnicodeMS"
                          font-size="9pt"
                          letter-spacing="0.08em">D</fo:inline> has set its scope to all Endpoint Descriptions that
    originate from its local framework, it therefore receives the Endpoint
    Description from <fo:inline font-family="ProductusOSGiBookc,ArialUnicodeMS"
                          font-size="9pt"
                          letter-spacing="0.08em">T</fo:inline>. Bundle <fo:inline font-family="ProductusOSGiBookc,ArialUnicodeMS"
                          font-size="9pt"
                          letter-spacing="0.08em">D</fo:inline> then sends the
    Endpoint Description to all its peers on the network.</fo:block>
            <fo:block space-before.optimum="5pt"
                      space-before.minimum="5pt"
                      space-before.maximum="5pt">In the <fo:inline font-family="ProductusOSGiBookc,ArialUnicodeMS"
                          font-size="9pt"
                          letter-spacing="0.08em">Quark</fo:inline> framework, the manager bundle
    <fo:inline font-family="ProductusOSGiBookc,ArialUnicodeMS"
                          font-size="9pt"
                          letter-spacing="0.08em">T</fo:inline> has expressed an interest by setting its scope to a filter
    that matches the Endpoint Description from the <fo:inline font-family="ProductusOSGiBookc,ArialUnicodeMS"
                          font-size="9pt"
                          letter-spacing="0.08em">Top</fo:inline> framework.
    When the bundle <fo:inline font-family="ProductusOSGiBookc,ArialUnicodeMS"
                          font-size="9pt"
                          letter-spacing="0.08em">D</fo:inline> on the <fo:inline font-family="ProductusOSGiBookc,ArialUnicodeMS"
                          font-size="9pt"
                          letter-spacing="0.08em">Quark</fo:inline> framework
    receives the Endpoint Description from bundle <fo:inline font-family="ProductusOSGiBookc,ArialUnicodeMS"
                          font-size="9pt"
                          letter-spacing="0.08em">D</fo:inline> on the
    <fo:inline font-family="ProductusOSGiBookc,ArialUnicodeMS"
                          font-size="9pt"
                          letter-spacing="0.08em">Top</fo:inline> framework, it matches it against all local Endpoint Event
    Listener's scope. In this case, the local manager bundle <fo:inline font-family="ProductusOSGiBookc,ArialUnicodeMS"
                          font-size="9pt"
                          letter-spacing="0.08em">T</fo:inline>
    matches and is given the Endpoint Description. The manager then uses the
    Remote Service Admin service to import the exported service described by
    the given Endpoint Description.</fo:block>
            <fo:block start-indent="0pt">
               <fo:block space-before.minimum="0.5em"
                         space-before.optimum="1em"
                         space-before.maximum="2em"
                         space-after.minimum="0.5em"
                         space-after.optimum="1em"
                         space-after.maximum="2em"
                         keep-together.within-column="always"
                         id="i1751511">
                  <fo:block xmlns:d="http://docbook.org/ns/docbook"
                            xmlns:xlink="http://www.w3.org/1999/xlink"
                            space-before.optimum="5pt"
                            space-before.minimum="5pt"
                            space-before.maximum="5pt"
                            font-weight="normal"
                            font-size="9pt"
                            hyphenate="false"
                            space-after.minimum="0.4em"
                            space-after.optimum="0.6em"
                            space-after.maximum="0.8em"
                            start-indent="0pt"
                            font-family="Proforma-Book,ArialUnicodeMS"
                            font-style="italic"
                            keep-with-next.within-column="always">
                     <fo:list-block provisional-distance-between-starts="1in"
                                    provisional-label-separation="0.090in">
                        <fo:list-item>
                           <fo:list-item-label end-indent="label-end()" text-align="start">
                              <fo:block>Figure 122.5</fo:block>
                           </fo:list-item-label>
                           <fo:list-item-body start-indent="body-start()">
                              <fo:block>Endpoint Discovery Architecture. T=Topology Manager,
      D=Discovery</fo:block>
                           </fo:list-item-body>
                        </fo:list-item>
                     </fo:list-block>
                  </fo:block>
                  <fo:block id="d61e1029" text-align="center">
                     <fo:external-graphic src="url(file:///home/stbischof/git/OSGI_MIGRATE/osgi_target/org.osgi.service.remoteserviceadmin/spec/org.osgi.spec.service.remoteserviceadmin/src/main/resources/spec/endpoint-discovery-architecture.svg)"
                                          width="auto"
                                          height="auto"
                                          content-width="4.924in"
                                          content-height="2.692in"
                                          text-align="center"/>
                  </fo:block>
               </fo:block>
            </fo:block>
            <fo:block space-before.optimum="5pt"
                      space-before.minimum="5pt"
                      space-before.maximum="5pt">The previous description is just one of the possible usages of the
    Endpoint Event Listener. For example, the discovery bundles could
    communicate the scopes to their peers. These peers could then register an
    Endpoint Event Listener per peer, minimizing the network traffic because
    Endpoint Descriptions do not have to be broadcast to all peers.</fo:block>
            <fo:block space-before.optimum="5pt"
                      space-before.minimum="5pt"
                      space-before.maximum="5pt">Another alternative usage is described in <fo:basic-link xmlns:d="http://docbook.org/ns/docbook"
                              xmlns:xlink="http://www.w3.org/1999/xlink"
                              internal-destination="i1889341">
                  <fo:inline color="inherit"
                             font-family="inherit"
                             letter-spacing="inherit"
                             hyphenate="inherit">
                     <fo:inline font-style="italic">Endpoint Description Extender Format</fo:inline> on page <fo:page-number-citation ref-id="i1889341"/>
                  </fo:inline>
               </fo:basic-link>. In this chapter the extender pattern is used to
    retrieve Endpoint Descriptions from resources in locally active
    bundles.</fo:block>
            <fo:block id="d61e1038">
               <fo:block>
                  <fo:block>
                     <fo:block keep-together.within-column="always"
                               margin-left="0pt"
                               font-family="ProductusSemibold,ArialUnicodeMS">
                        <fo:block keep-with-next.within-column="always">
                           <fo:block xmlns:d="http://docbook.org/ns/docbook"
                                     xmlns:xlink="http://www.w3.org/1999/xlink"
                                     font-family="ProductusSemibold,ArialUnicodeMS"
                                     font-weight="normal"
                                     keep-with-next.within-column="always"
                                     space-before.minimum="0.8em"
                                     space-before.optimum="1.0em"
                                     space-before.maximum="1.2em"
                                     text-align="start"
                                     start-indent="0pt"
                                     hyphenate="false">
                              <fo:block font-size="12pt"
                                        line-height="14pt"
                                        space-before="8pt"
                                        space-after="5pt">
                                 <fo:list-block provisional-distance-between-starts="1in"
                                                provisional-label-separation="0.090in">
                                    <fo:list-item>
                                       <fo:list-item-label end-indent="label-end()" text-align="start">
                                          <fo:block>122.6.1</fo:block>
                                       </fo:list-item-label>
                                       <fo:list-item-body start-indent="body-start()">
                                          <fo:block>Scope and Filters</fo:block>
                                       </fo:list-item-body>
                                    </fo:list-item>
                                 </fo:list-block>
                              </fo:block>
                           </fo:block>
                        </fo:block>
                     </fo:block>
                  </fo:block>
               </fo:block>
               <fo:block space-before.optimum="5pt"
                         space-before.minimum="5pt"
                         space-before.maximum="5pt">An Endpoint Event Listener or Endpoint Listener service is
      registered with the <fo:basic-link xmlns:d="http://docbook.org/ns/docbook"
                                 xmlns:xlink="http://www.w3.org/1999/xlink"
                                 internal-destination="org.osgi.service.remoteserviceadmin.EndpointEventListener.ENDPOINT_LISTENER_SCOPE">
                     <fo:inline color="blue"
                                font-family="ProductusOSGiBookc,ArialUnicodeMS"
                                letter-spacing="0.08em"
                                hyphenate="false">ENDPOINT_LISTENER_SCOPE</fo:inline>
                  </fo:basic-link> service property. This property, which is
      <fo:inline font-family="ProductusOSGiBookc,ArialUnicodeMS"
                             font-size="9pt"
                             letter-spacing="0.08em">String+</fo:inline>, must be set and must contain at least one filter.
      If there is not at least one filter, then that Endpoint Event Listener
      or Endpoint Listener must not receive any Endpoint Descriptions.</fo:block>
               <fo:block space-before.optimum="5pt"
                         space-before.minimum="5pt"
                         space-before.maximum="5pt">Each filter in the scope is applied against the properties of the
      Endpoint Description until one succeeds. Only if one succeeds is the
      Endpoint informed about the existence of an Endpoint.</fo:block>
               <fo:block space-before.optimum="5pt"
                         space-before.minimum="5pt"
                         space-before.maximum="5pt">The Endpoint Description is designed to reflect the properties of
      the imported service, there is therefore a correspondence with the
      filters that are used by bundles that are listening for service
      registrations. The purpose of this design is to match the filter
      available through Listener Hook services, see <fo:basic-link xmlns:d="http://docbook.org/ns/docbook"
                                 xmlns:xlink="http://www.w3.org/1999/xlink"
                                 internal-destination="i1755239">
                     <fo:inline color="inherit"
                                font-family="inherit"
                                letter-spacing="inherit"
                                hyphenate="inherit">
                        <fo:inline font-style="italic">On Demand</fo:inline> on page <fo:page-number-citation ref-id="i1755239"/>
                     </fo:inline>
                  </fo:basic-link>.</fo:block>
               <fo:block space-before.optimum="5pt"
                         space-before.minimum="5pt"
                         space-before.maximum="5pt">However, the purpose of the filters is more generic than just this
      use case. It can also be used to specify the interest in local Endpoints
      or remote Endpoints. For example, Topology Managers are only interested
      in remote Endpoints while discoverers are only interested in local
      Endpoints. It is easy to discriminate between local and remote by
      filtering on the <fo:inline font-family="ProductusOSGiBookc,ArialUnicodeMS"
                             font-size="9pt"
                             letter-spacing="0.08em">endpoint.framework.uuid</fo:inline> property. Endpoint
      Descriptions contain the Universally Unique ID (UUID) of the originating
      framework. This UUID must be available from the local framework as well.
      See <fo:basic-link xmlns:d="http://docbook.org/ns/docbook"
                                 xmlns:xlink="http://www.w3.org/1999/xlink"
                                 internal-destination="i1887500">
                     <fo:inline color="inherit"
                                font-family="inherit"
                                letter-spacing="inherit"
                                hyphenate="inherit">
                        <fo:inline font-style="italic">Framework UUID</fo:inline> on page <fo:page-number-citation ref-id="i1887500"/>
                     </fo:inline>
                  </fo:basic-link>.</fo:block>
            </fo:block>
            <fo:block id="d61e1057">
               <fo:block>
                  <fo:block>
                     <fo:block keep-together.within-column="always"
                               margin-left="0pt"
                               font-family="ProductusSemibold,ArialUnicodeMS">
                        <fo:block keep-with-next.within-column="always">
                           <fo:block xmlns:d="http://docbook.org/ns/docbook"
                                     xmlns:xlink="http://www.w3.org/1999/xlink"
                                     font-family="ProductusSemibold,ArialUnicodeMS"
                                     font-weight="normal"
                                     keep-with-next.within-column="always"
                                     space-before.minimum="0.8em"
                                     space-before.optimum="1.0em"
                                     space-before.maximum="1.2em"
                                     text-align="start"
                                     start-indent="0pt"
                                     hyphenate="false">
                              <fo:block font-size="12pt"
                                        line-height="14pt"
                                        space-before="8pt"
                                        space-after="5pt">
                                 <fo:list-block provisional-distance-between-starts="1in"
                                                provisional-label-separation="0.090in">
                                    <fo:list-item>
                                       <fo:list-item-label end-indent="label-end()" text-align="start">
                                          <fo:block>122.6.2</fo:block>
                                       </fo:list-item-label>
                                       <fo:list-item-body start-indent="body-start()">
                                          <fo:block>Endpoint Event Listener Interface</fo:block>
                                       </fo:list-item-body>
                                    </fo:list-item>
                                 </fo:list-block>
                              </fo:block>
                           </fo:block>
                        </fo:block>
                     </fo:block>
                  </fo:block>
               </fo:block>
               <fo:block space-before.optimum="5pt"
                         space-before.minimum="5pt"
                         space-before.maximum="5pt">The <fo:inline font-family="ProductusOSGiBookc,ArialUnicodeMS"
                             font-size="9pt"
                             letter-spacing="0.08em">EndpointEventListener</fo:inline> interface has the following
      method:</fo:block>
               <fo:list-block space-before.optimum="1em"
                              space-before.minimum="0.8em"
                              space-before.maximum="1.2em"
                              space-after.optimum="1em"
                              space-after.minimum="0.8em"
                              space-after.maximum="1.2em"
                              provisional-label-separation="0.2em"
                              provisional-distance-between-starts="12pt"
                              id="d61e1063">
                  <fo:list-item space-before.optimum="2pt"
                                space-before.minimum="2pt"
                                space-before.maximum="2pt"
                                id="d61e1064">
                     <fo:list-item-label end-indent="label-end()">
                        <fo:block>•</fo:block>
                     </fo:list-item-label>
                     <fo:list-item-body start-indent="body-start()">
                        <fo:block>
                           <fo:block>
                              <fo:basic-link xmlns:d="http://docbook.org/ns/docbook"
                                             xmlns:xlink="http://www.w3.org/1999/xlink"
                                             internal-destination="org.osgi.service.remoteserviceadmin.EndpointEventListener.endpointChanged-EndpointEvent-String-">
                                 <fo:inline color="blue"
                                            font-family="ProductusOSGiBookc,ArialUnicodeMS"
                                            letter-spacing="0.08em"
                                            hyphenate="false">endpointChanged(EndpointEvent,String)</fo:inline>
                              </fo:basic-link> – Notify the Endpoint Event Listener of
          changes to an Endpoint. The change could entail the addition or
          removal of an Endpoint or the modification of the properties of an
          existing Endpoint. Multiple identical events should be counted as a
          single such event.</fo:block>
                        </fo:block>
                     </fo:list-item-body>
                  </fo:list-item>
               </fo:list-block>
               <fo:block space-before.optimum="5pt"
                         space-before.minimum="5pt"
                         space-before.maximum="5pt">These methods must only be called if the Endpoint Event Listener
      service has a filter in its scope that matches the Endpoint Description
      properties.</fo:block>
               <fo:block space-before.optimum="5pt"
                         space-before.minimum="5pt"
                         space-before.maximum="5pt">The Endpoint Event Listener interface is
      <fo:inline font-style="italic">idempotent</fo:inline>. Endpoint Description Providers must
      inform an Endpoint Event Listener service (and its deprecated
      predecessor Endpoint Listener service) that is registered of all their
      matching Endpoints. The only way to find out about all available
      Endpoints is to register an Endpoint Event Listener (or Endpoint
      Listener) that is then informed by all available Endpoint Description
      Providers of their known Endpoint Descriptions that match their
      scope.</fo:block>
            </fo:block>
            <fo:block id="d61e1073">
               <fo:block>
                  <fo:block>
                     <fo:block keep-together.within-column="always"
                               margin-left="0pt"
                               font-family="ProductusSemibold,ArialUnicodeMS">
                        <fo:block keep-with-next.within-column="always">
                           <fo:block xmlns:d="http://docbook.org/ns/docbook"
                                     xmlns:xlink="http://www.w3.org/1999/xlink"
                                     font-family="ProductusSemibold,ArialUnicodeMS"
                                     font-weight="normal"
                                     keep-with-next.within-column="always"
                                     space-before.minimum="0.8em"
                                     space-before.optimum="1.0em"
                                     space-before.maximum="1.2em"
                                     text-align="start"
                                     start-indent="0pt"
                                     hyphenate="false">
                              <fo:block font-size="12pt"
                                        line-height="14pt"
                                        space-before="8pt"
                                        space-after="5pt">
                                 <fo:list-block provisional-distance-between-starts="1in"
                                                provisional-label-separation="0.090in">
                                    <fo:list-item>
                                       <fo:list-item-label end-indent="label-end()" text-align="start">
                                          <fo:block>122.6.3</fo:block>
                                       </fo:list-item-label>
                                       <fo:list-item-body start-indent="body-start()">
                                          <fo:block>Endpoint Listener Interface</fo:block>
                                       </fo:list-item-body>
                                    </fo:list-item>
                                 </fo:list-block>
                              </fo:block>
                           </fo:block>
                        </fo:block>
                     </fo:block>
                  </fo:block>
               </fo:block>
               <fo:block space-before.optimum="5pt"
                         space-before.minimum="5pt"
                         space-before.maximum="5pt">The <fo:inline font-family="ProductusOSGiBookc,ArialUnicodeMS"
                             font-size="9pt"
                             letter-spacing="0.08em">EndpointListener</fo:inline> interface is marked as
      <fo:inline font-family="ProductusOSGiBookc,ArialUnicodeMS"
                             font-size="9pt"
                             letter-spacing="0.08em">Deprecated</fo:inline> because the <fo:inline font-family="ProductusOSGiBookc,ArialUnicodeMS"
                             font-size="9pt"
                             letter-spacing="0.08em">EndpointEventListener</fo:inline>
      interface must be used in preference when both are implemented by the
      same object. The <fo:inline font-family="ProductusOSGiBookc,ArialUnicodeMS"
                             font-size="9pt"
                             letter-spacing="0.08em">EndpointEvent</fo:inline> interface has the following
      methods:</fo:block>
               <fo:list-block space-before.optimum="1em"
                              space-before.minimum="0.8em"
                              space-before.maximum="1.2em"
                              space-after.optimum="1em"
                              space-after.minimum="0.8em"
                              space-after.maximum="1.2em"
                              provisional-label-separation="0.2em"
                              provisional-distance-between-starts="12pt"
                              id="d61e1085">
                  <fo:list-item space-before.optimum="2pt"
                                space-before.minimum="2pt"
                                space-before.maximum="2pt"
                                id="d61e1086">
                     <fo:list-item-label end-indent="label-end()">
                        <fo:block>•</fo:block>
                     </fo:list-item-label>
                     <fo:list-item-body start-indent="body-start()">
                        <fo:block>
                           <fo:block>
                              <fo:basic-link xmlns:d="http://docbook.org/ns/docbook"
                                             xmlns:xlink="http://www.w3.org/1999/xlink"
                                             internal-destination="org.osgi.service.remoteserviceadmin.EndpointListener.endpointAdded-EndpointDescription-String-">
                                 <fo:inline color="blue"
                                            font-family="ProductusOSGiBookc,ArialUnicodeMS"
                                            letter-spacing="0.08em"
                                            hyphenate="false">endpointAdded(EndpointDescription,String)</fo:inline>
                              </fo:basic-link> – Notify the Endpoint Listener of a new
          Endpoint Description. The second parameter is the filter that
          matched the Endpoint Description. Registering the same Endpoint
          multiple times counts as a single registration.</fo:block>
                        </fo:block>
                     </fo:list-item-body>
                  </fo:list-item>
                  <fo:list-item space-before.optimum="2pt"
                                space-before.minimum="2pt"
                                space-before.maximum="2pt"
                                id="d61e1090">
                     <fo:list-item-label end-indent="label-end()">
                        <fo:block>•</fo:block>
                     </fo:list-item-label>
                     <fo:list-item-body start-indent="body-start()">
                        <fo:block>
                           <fo:block>
                              <fo:basic-link xmlns:d="http://docbook.org/ns/docbook"
                                             xmlns:xlink="http://www.w3.org/1999/xlink"
                                             internal-destination="org.osgi.service.remoteserviceadmin.EndpointListener.endpointRemoved-EndpointDescription-String-">
                                 <fo:inline color="blue"
                                            font-family="ProductusOSGiBookc,ArialUnicodeMS"
                                            letter-spacing="0.08em"
                                            hyphenate="false">endpointRemoved(EndpointDescription,String)</fo:inline>
                              </fo:basic-link> – Notify the Endpoint Listener that the
          provided Endpoint Description is no longer available.</fo:block>
                        </fo:block>
                     </fo:list-item-body>
                  </fo:list-item>
               </fo:list-block>
               <fo:block space-before.optimum="5pt"
                         space-before.minimum="5pt"
                         space-before.maximum="5pt">These methods must only be called if the Endpoint Listener service
      has a filter in its scope that matches the Endpoint Description
      properties. The reason for the filter string in the methods is to
      simplify and speed up matching an Endpoint Description to the cause of
      interest. For example, if the Listener Hook is used to do on demand
      import of services, then the filter can be associated with the Listener
      Info of the hook, see <fo:basic-link xmlns:d="http://docbook.org/ns/docbook"
                                 xmlns:xlink="http://www.w3.org/1999/xlink"
                                 internal-destination="i1755239">
                     <fo:inline color="inherit"
                                font-family="inherit"
                                letter-spacing="inherit"
                                hyphenate="inherit">
                        <fo:inline font-style="italic">On Demand</fo:inline> on page <fo:page-number-citation ref-id="i1755239"/>
                     </fo:inline>
                  </fo:basic-link>. If multiple filters in
      the scope match the Endpoint Description than the first filter in the
      scope must be passed.</fo:block>
               <fo:block space-before.optimum="5pt"
                         space-before.minimum="5pt"
                         space-before.maximum="5pt">The Endpoint Listener interface is
      <fo:inline font-style="italic">idempotent</fo:inline>. Endpoint Description Providers must
      inform an Endpoint Listener service that is registered of all their
      matching Endpoints.</fo:block>
            </fo:block>
            <fo:block id="d61e1102">
               <fo:block>
                  <fo:block>
                     <fo:block keep-together.within-column="always"
                               margin-left="0pt"
                               font-family="ProductusSemibold,ArialUnicodeMS">
                        <fo:block keep-with-next.within-column="always">
                           <fo:block xmlns:d="http://docbook.org/ns/docbook"
                                     xmlns:xlink="http://www.w3.org/1999/xlink"
                                     font-family="ProductusSemibold,ArialUnicodeMS"
                                     font-weight="normal"
                                     keep-with-next.within-column="always"
                                     space-before.minimum="0.8em"
                                     space-before.optimum="1.0em"
                                     space-before.maximum="1.2em"
                                     text-align="start"
                                     start-indent="0pt"
                                     hyphenate="false">
                              <fo:block font-size="12pt"
                                        line-height="14pt"
                                        space-before="8pt"
                                        space-after="5pt">
                                 <fo:list-block provisional-distance-between-starts="1in"
                                                provisional-label-separation="0.090in">
                                    <fo:list-item>
                                       <fo:list-item-label end-indent="label-end()" text-align="start">
                                          <fo:block>122.6.4</fo:block>
                                       </fo:list-item-label>
                                       <fo:list-item-body start-indent="body-start()">
                                          <fo:block>Endpoint Event Listener and Endpoint Listener
      Implementations</fo:block>
                                       </fo:list-item-body>
                                    </fo:list-item>
                                 </fo:list-block>
                              </fo:block>
                           </fo:block>
                        </fo:block>
                     </fo:block>
                  </fo:block>
               </fo:block>
               <fo:block space-before.optimum="5pt"
                         space-before.minimum="5pt"
                         space-before.maximum="5pt">An Endpoint Event Listener service tracks the known Endpoints in
      its given scope. There are potentially a large number of bundles
      involved in creating this federated registry of Endpoints. To ensure
      that no Endpoint Descriptions are orphaned or unnecessarily missed, an
      Endpoint Event Listener implementation must follow the following
      rules:</fo:block>
               <fo:list-block space-before.optimum="1em"
                              space-before.minimum="0.8em"
                              space-before.maximum="1.2em"
                              space-after.optimum="1em"
                              space-after.minimum="0.8em"
                              space-after.maximum="1.2em"
                              provisional-label-separation="0.2em"
                              provisional-distance-between-starts="12pt"
                              id="d61e1105">
                  <fo:list-item space-before.optimum="2pt"
                                space-before.minimum="2pt"
                                space-before.maximum="2pt"
                                id="d61e1106">
                     <fo:list-item-label end-indent="label-end()">
                        <fo:block>•</fo:block>
                     </fo:list-item-label>
                     <fo:list-item-body start-indent="body-start()">
                        <fo:block>
                           <fo:block>
                              <fo:inline font-style="italic">Registration</fo:inline> – The Endpoint Event
          Listener service is called with an event of type <fo:basic-link xmlns:d="http://docbook.org/ns/docbook"
                                             xmlns:xlink="http://www.w3.org/1999/xlink"
                                             internal-destination="org.osgi.service.remoteserviceadmin.EndpointEvent.ADDED">
                                 <fo:inline color="blue"
                                            font-family="ProductusOSGiBookc,ArialUnicodeMS"
                                            letter-spacing="0.08em"
                                            hyphenate="false">ADDED</fo:inline>
                              </fo:basic-link> for all known Endpoint Descriptions that the
          bundles in the local framework are aware of. Similarly, Endpoint
          Listener services are called with an <fo:basic-link xmlns:d="http://docbook.org/ns/docbook"
                                             xmlns:xlink="http://www.w3.org/1999/xlink"
                                             internal-destination="org.osgi.service.remoteserviceadmin.EndpointListener.endpointAdded-EndpointDescription-String-">
                                 <fo:inline color="blue"
                                            font-family="ProductusOSGiBookc,ArialUnicodeMS"
                                            letter-spacing="0.08em"
                                            hyphenate="false">endpointAdded(EndpointDescription,String)</fo:inline>
                              </fo:basic-link> method for all these.</fo:block>
                        </fo:block>
                     </fo:list-item-body>
                  </fo:list-item>
                  <fo:list-item space-before.optimum="2pt"
                                space-before.minimum="2pt"
                                space-before.maximum="2pt"
                                id="d61e1114">
                     <fo:list-item-label end-indent="label-end()">
                        <fo:block>•</fo:block>
                     </fo:list-item-label>
                     <fo:list-item-body start-indent="body-start()">
                        <fo:block>
                           <fo:block>
                              <fo:inline font-style="italic">Tracking providers</fo:inline> – An Endpoint Event
          Listener or Endpoint Listener must track the bundles that provide it
          with Endpoint Descriptions. If a bundle that provided Endpoint
          Descriptions is stopped, all Endpoint Descriptions that were
          provided by that bundle must be removed. This can be implemented
          straightforwardly with a Service Factory.</fo:block>
                        </fo:block>
                     </fo:list-item-body>
                  </fo:list-item>
                  <fo:list-item space-before.optimum="2pt"
                                space-before.minimum="2pt"
                                space-before.maximum="2pt"
                                id="d61e1118">
                     <fo:list-item-label end-indent="label-end()">
                        <fo:block>•</fo:block>
                     </fo:list-item-label>
                     <fo:list-item-body start-indent="body-start()">
                        <fo:block>
                           <fo:block>
                              <fo:inline font-style="italic">Scope modification</fo:inline> – An Endpoint Event
          Listener or Endpoint Listener is allowed to modify the set of
          filters in its scope through a service property modification. This
          modification must result in new and/or existing Endpoint
          Descriptions to be added, however, existing Endpoints that are no
          longer in scope are not required to be explicitly removed by the
          their sources. It is the responsibility for the Endpoint Listener to
          remove these orphaned Endpoint Description from its view.</fo:block>
                        </fo:block>
                     </fo:list-item-body>
                  </fo:list-item>
                  <fo:list-item space-before.optimum="2pt"
                                space-before.minimum="2pt"
                                space-before.maximum="2pt"
                                id="d61e1122">
                     <fo:list-item-label end-indent="label-end()">
                        <fo:block>•</fo:block>
                     </fo:list-item-label>
                     <fo:list-item-body start-indent="body-start()">
                        <fo:block>
                           <fo:block>
                              <fo:inline font-style="italic">Endpoint mutability</fo:inline> – An Endpoint
          Description can change its Properties. The way this is handled is
          different for Endpoint Event Listeners and Endpoint Listeners. An
          Endpoint Event Listener receives a change event of type <fo:basic-link xmlns:d="http://docbook.org/ns/docbook"
                                             xmlns:xlink="http://www.w3.org/1999/xlink"
                                             internal-destination="org.osgi.service.remoteserviceadmin.EndpointEvent.MODIFIED">
                                 <fo:inline color="blue"
                                            font-family="ProductusOSGiBookc,ArialUnicodeMS"
                                            letter-spacing="0.08em"
                                            hyphenate="false">MODIFIED</fo:inline>
                              </fo:basic-link> when the Properties of an existing Endpoint
          are modified. If the modification means that the Endpoint no longer
          matches the listener scope an event of type <fo:basic-link xmlns:d="http://docbook.org/ns/docbook"
                                             xmlns:xlink="http://www.w3.org/1999/xlink"
                                             internal-destination="org.osgi.service.remoteserviceadmin.EndpointEvent.MODIFIED_ENDMATCH">
                                 <fo:inline color="blue"
                                            font-family="ProductusOSGiBookc,ArialUnicodeMS"
                                            letter-spacing="0.08em"
                                            hyphenate="false">MODIFIED_ENDMATCH</fo:inline>
                              </fo:basic-link> is sent instead. Endpoint Listener services
          receive a sequence of <fo:basic-link xmlns:d="http://docbook.org/ns/docbook"
                                             xmlns:xlink="http://www.w3.org/1999/xlink"
                                             internal-destination="org.osgi.service.remoteserviceadmin.EndpointListener.endpointRemoved-EndpointDescription-String-">
                                 <fo:inline color="blue"
                                            font-family="ProductusOSGiBookc,ArialUnicodeMS"
                                            letter-spacing="0.08em"
                                            hyphenate="false">endpointRemoved(EndpointDescription,String)</fo:inline>
                              </fo:basic-link> and <fo:basic-link xmlns:d="http://docbook.org/ns/docbook"
                                             xmlns:xlink="http://www.w3.org/1999/xlink"
                                             internal-destination="org.osgi.service.remoteserviceadmin.EndpointListener.endpointAdded-EndpointDescription-String-">
                                 <fo:inline color="blue"
                                            font-family="ProductusOSGiBookc,ArialUnicodeMS"
                                            letter-spacing="0.08em"
                                            hyphenate="false">endpointAdded(EndpointDescription,String)</fo:inline>
                              </fo:basic-link> callbacks when the Properties of an Endpoint
          are modified.</fo:block>
                        </fo:block>
                     </fo:list-item-body>
                  </fo:list-item>
               </fo:list-block>
               <fo:block space-before.optimum="5pt"
                         space-before.minimum="5pt"
                         space-before.maximum="5pt">Endpoint Descriptions can be added from different sources and
      providers of Endpoint Descriptions often use asynchronous and
      potentially unreliable communications. An implementation must therefore
      handle the addition of multiple equal Endpoint Descriptions from
      different sources as well as from the same source. Implementations must
      not count the number of registrations, a remove operation of an Endpoint
      Description is final for each source. That is, if source <fo:inline font-family="ProductusOSGiBookc,ArialUnicodeMS"
                             font-size="9pt"
                             letter-spacing="0.08em">A</fo:inline>
      added Endpoint Description <fo:inline font-family="ProductusOSGiBookc,ArialUnicodeMS"
                             font-size="9pt"
                             letter-spacing="0.08em">e</fo:inline>, then it can only be removed
      by source <fo:inline font-family="ProductusOSGiBookc,ArialUnicodeMS"
                             font-size="9pt"
                             letter-spacing="0.08em">A</fo:inline>. However, if source <fo:inline font-family="ProductusOSGiBookc,ArialUnicodeMS"
                             font-size="9pt"
                             letter-spacing="0.08em">A</fo:inline> added
      <fo:inline font-family="ProductusOSGiBookc,ArialUnicodeMS"
                             font-size="9pt"
                             letter-spacing="0.08em">e</fo:inline> multiple times, then it only needs to be removed once.
      Removals of Endpoint Descriptions that have not been added (or were
      removed before) should be ignored.</fo:block>
               <fo:block space-before.optimum="5pt"
                         space-before.minimum="5pt"
                         space-before.maximum="5pt">The discovery of Endpoints is a fundamentally indeterministic
      process and implementations of Endpoint Event Listener services should
      realize that there are no guarantees that an added Endpoint Description
      is always describing a valid Endpoint.</fo:block>
            </fo:block>
            <fo:block id="d61e1147">
               <fo:block>
                  <fo:block>
                     <fo:block keep-together.within-column="always"
                               margin-left="0pt"
                               font-family="ProductusSemibold,ArialUnicodeMS">
                        <fo:block keep-with-next.within-column="always">
                           <fo:block xmlns:d="http://docbook.org/ns/docbook"
                                     xmlns:xlink="http://www.w3.org/1999/xlink"
                                     font-family="ProductusSemibold,ArialUnicodeMS"
                                     font-weight="normal"
                                     keep-with-next.within-column="always"
                                     space-before.minimum="0.8em"
                                     space-before.optimum="1.0em"
                                     space-before.maximum="1.2em"
                                     text-align="start"
                                     start-indent="0pt"
                                     hyphenate="false">
                              <fo:block font-size="12pt"
                                        line-height="14pt"
                                        space-before="8pt"
                                        space-after="5pt">
                                 <fo:list-block provisional-distance-between-starts="1in"
                                                provisional-label-separation="0.090in">
                                    <fo:list-item>
                                       <fo:list-item-label end-indent="label-end()" text-align="start">
                                          <fo:block>122.6.5</fo:block>
                                       </fo:list-item-label>
                                       <fo:list-item-body start-indent="body-start()">
                                          <fo:block>Endpoint Description Providers</fo:block>
                                       </fo:list-item-body>
                                    </fo:list-item>
                                 </fo:list-block>
                              </fo:block>
                           </fo:block>
                        </fo:block>
                     </fo:block>
                  </fo:block>
               </fo:block>
               <fo:block space-before.optimum="5pt"
                         space-before.minimum="5pt"
                         space-before.maximum="5pt">The Endpoint Event Listener and Endpoint Listener services are
      based on an asynchronous, unreliable, best effort model because there
      are few guarantees in a distributed world. It is the task of an Endpoint
      Description Provider, for example a discovery bundle, to keep the
      Endpoint Event Listener services up to date of any Endpoint Descriptions
      the provider is aware of and that match the tracked service's
      scope.</fo:block>
               <fo:block space-before.optimum="5pt"
                         space-before.minimum="5pt"
                         space-before.maximum="5pt">If an Endpoint Event Listener or Endpoint Listener service is
      registered, a provider must add all matching Endpoint Descriptions that
      it is aware of and match the tracked listener's scope. This can be done
      during registration or asynchronously later. For example, it is possible
      to use the filters in the scope to request remote systems for any
      Endpoint Descriptions that match those filters. For expediency reasons,
      the service registration event should not be delayed until those results
      return; it is therefore applicable to add these Endpoint Descriptions
      later when the returns from the remote systems finally arrive.</fo:block>
               <fo:block space-before.optimum="5pt"
                         space-before.minimum="5pt"
                         space-before.maximum="5pt">If a tracked listener service object is advertised as both an
      Endpoint Event Listener and an Endpoint Listener then the
      EndpointDescription Provider must ignore the
      <fo:inline font-family="ProductusOSGiBookc,ArialUnicodeMS"
                             font-size="9pt"
                             letter-spacing="0.08em">EndpointListener</fo:inline> interface, and treat the listener only as
      an Endpoint Event Listener. Remote Service Admin <fo:inline font-family="ProductusOSGiBookc,ArialUnicodeMS"
                             font-size="9pt"
                             letter-spacing="0.08em">1.0</fo:inline> actors
      will be unaware of the <fo:inline font-family="ProductusOSGiBookc,ArialUnicodeMS"
                             font-size="9pt"
                             letter-spacing="0.08em">EndpointEventListener</fo:inline> interface, and
      will treat the service object purely as an Endpoint Listener. This
      restriction ensures that all actors will treat the service either as an
      Endpoint Event Listener, or an Endpoint Listener, but never as both. As
      a result the listener service will not have to disambiguate duplicate
      events from a single source. If an Endpoint Description Provider uses
      both the Endpoint Listener and Endpoint Event Listener interfaces of a
      single service object then the resulting behavior is undefined. The
      implementation may detect the misuse and throw an Exception, process or
      ignore the events from one of the interfaces, or it may simply corrupt
      the internal registry of Endpoints within the listener.</fo:block>
               <fo:block space-before.optimum="5pt"
                         space-before.minimum="5pt"
                         space-before.maximum="5pt">A tracked Endpoint Event Listener or Endpoint Listener is allowed
      to modify its scope by setting new properties on its Service
      Registration. An Endpoint Description provider must process the new
      scope and add any newly matching Endpoint Descriptions. It is not
      necessary to remove any Endpoint Descriptions that were added before but
      no longer match the new scope. Removing those orphaned descriptions is
      the responsibility of the listener implementation.</fo:block>
               <fo:block space-before.optimum="5pt"
                         space-before.minimum="5pt"
                         space-before.maximum="5pt">It is not necessary to remove any registered Endpoint Descriptions
      when the Endpoint Event Listener or Endpoint Listener is unregistered;
      also here it is the responsibility of the listener to do the proper
      cleanup.</fo:block>
            </fo:block>
            <fo:block id="i1755239">
               <fo:block>
                  <fo:block>
                     <fo:block keep-together.within-column="always"
                               margin-left="0pt"
                               font-family="ProductusSemibold,ArialUnicodeMS">
                        <fo:block keep-with-next.within-column="always">
                           <fo:block xmlns:d="http://docbook.org/ns/docbook"
                                     xmlns:xlink="http://www.w3.org/1999/xlink"
                                     font-family="ProductusSemibold,ArialUnicodeMS"
                                     font-weight="normal"
                                     keep-with-next.within-column="always"
                                     space-before.minimum="0.8em"
                                     space-before.optimum="1.0em"
                                     space-before.maximum="1.2em"
                                     text-align="start"
                                     start-indent="0pt"
                                     hyphenate="false">
                              <fo:block font-size="12pt"
                                        line-height="14pt"
                                        space-before="8pt"
                                        space-after="5pt">
                                 <fo:list-block provisional-distance-between-starts="1in"
                                                provisional-label-separation="0.090in">
                                    <fo:list-item>
                                       <fo:list-item-label end-indent="label-end()" text-align="start">
                                          <fo:block>122.6.6</fo:block>
                                       </fo:list-item-label>
                                       <fo:list-item-body start-indent="body-start()">
                                          <fo:block>On Demand</fo:block>
                                       </fo:list-item-body>
                                    </fo:list-item>
                                 </fo:list-block>
                              </fo:block>
                           </fo:block>
                        </fo:block>
                     </fo:block>
                  </fo:block>
               </fo:block>
               <fo:block space-before.optimum="5pt"
                         space-before.minimum="5pt"
                         space-before.maximum="5pt">A common distribution policy is to import services that are being
      listened for by local bundles. For example, when a bundle opens a
      Service Tracker on the Log Service, a Topology Manager could be notified
      and attempt to find a Log Service in the local cluster and then import
      this service in the local Service Registry.</fo:block>
               <fo:block space-before.optimum="5pt"
                         space-before.minimum="5pt"
                         space-before.maximum="5pt">The OSGi framework provides service hooks for exactly this
      purpose. A Topology Manager can register a Listener Hook service and
      receive the information about bundles that have specified an interests
      in specific services.</fo:block>
               <fo:block space-before.optimum="5pt"
                         space-before.minimum="5pt"
                         space-before.maximum="5pt">For example, a bundle creates the following Service
      Tracker:</fo:block>
               <fo:block space-before.minimum="0.8em"
                         space-before.optimum="1em"
                         space-before.maximum="1.2em"
                         space-after.minimum="0.8em"
                         space-after.optimum="1em"
                         space-after.maximum="1.2em"
                         hyphenate="false"
                         wrap-option="no-wrap"
                         white-space-collapse="false"
                         white-space-treatment="preserve"
                         linefeed-treatment="preserve"
                         text-align="start"
                         font-family="ProductusOSGiMonoc,ArialUnicodeMS"
                         font-size="9pt"
                         letter-spacing="-.0em"
                         space-before="5pt"
                         space-after="3pt"
                         space-after.conditionality="retain"
                         start-indent="inherit"
                         line-height="11pt"
                         id="d61e1166">ServiceTracker st = new ServiceTracker(context, 
        LogService.class.getName() );
st.open();</fo:block>
               <fo:block space-before.optimum="5pt"
                         space-before.minimum="5pt"
                         space-before.maximum="5pt">This Service Tracker will register a Service Listener with the
      OSGi framework. This will cause the framework to add a
      <fo:inline font-family="ProductusOSGiBookc,ArialUnicodeMS"
                             font-size="9pt"
                             letter-spacing="0.08em">ListenerInfo</fo:inline> to any Listener Hook services. The
      <fo:inline font-family="ProductusOSGiBookc,ArialUnicodeMS"
                             font-size="9pt"
                             letter-spacing="0.08em">getFilter</fo:inline> method on a <fo:inline font-family="ProductusOSGiBookc,ArialUnicodeMS"
                             font-size="9pt"
                             letter-spacing="0.08em">ListenerInfo</fo:inline> object
      provides a filter that is directly applicable for the Endpoint Event
      Listener's scope. In the previous example, this would be the
      filter:</fo:block>
               <fo:block space-before.minimum="0.8em"
                         space-before.optimum="1em"
                         space-before.maximum="1.2em"
                         space-after.minimum="0.8em"
                         space-after.optimum="1em"
                         space-after.maximum="1.2em"
                         hyphenate="false"
                         wrap-option="no-wrap"
                         white-space-collapse="false"
                         white-space-treatment="preserve"
                         linefeed-treatment="preserve"
                         text-align="start"
                         font-family="ProductusOSGiMonoc,ArialUnicodeMS"
                         font-size="9pt"
                         letter-spacing="-.0em"
                         space-before="5pt"
                         space-after="3pt"
                         space-after.conditionality="retain"
                         start-indent="inherit"
                         line-height="11pt"
                         id="d61e1175">(objectClass=org.osgi.service.log.LogService)</fo:block>
               <fo:block space-before.optimum="5pt"
                         space-before.minimum="5pt"
                         space-before.maximum="5pt">A Topology Manager could verify if this listener is satisfied.
      That is, if it has at least one service. If no such service could be
      found, it could then add this filter to its Endpoint Event Listener's
      scope to detect remote implementations of this service. If such an
      Endpoint is detected, it could then request the import of this service
      through the Remote Service Admin service.</fo:block>
            </fo:block>
         </fo:block>
         <fo:block id="i1736220">
            <fo:block>
               <fo:block>
                  <fo:block keep-together.within-column="always"
                            margin-left="0pt"
                            font-family="ProductusSemibold,ArialUnicodeMS">
                     <fo:block keep-with-next.within-column="always">
                        <fo:block xmlns:d="http://docbook.org/ns/docbook"
                                  xmlns:xlink="http://www.w3.org/1999/xlink"
                                  font-family="ProductusSemibold,ArialUnicodeMS"
                                  font-weight="normal"
                                  keep-with-next.within-column="always"
                                  space-before.minimum="0.8em"
                                  space-before.optimum="1.0em"
                                  space-before.maximum="1.2em"
                                  text-align="start"
                                  start-indent="0pt"
                                  hyphenate="false">
                           <fo:marker marker-class-name="section.head.marker">Events</fo:marker>
                           <fo:block font-size="18pt"
                                     line-height="25pt"
                                     space-before="12.5pt"
                                     space-after="12pt">
                              <fo:list-block provisional-distance-between-starts="1in"
                                             provisional-label-separation="0.090in">
                                 <fo:list-item>
                                    <fo:list-item-label end-indent="label-end()" text-align="start">
                                       <fo:block>122.7</fo:block>
                                    </fo:list-item-label>
                                    <fo:list-item-body start-indent="body-start()">
                                       <fo:block>Events</fo:block>
                                    </fo:list-item-body>
                                 </fo:list-item>
                              </fo:list-block>
                           </fo:block>
                        </fo:block>
                     </fo:block>
                  </fo:block>
               </fo:block>
            </fo:block>
            <fo:block space-before.optimum="5pt"
                      space-before.minimum="5pt"
                      space-before.maximum="5pt">The Remote Service Admin service must synchronously inform any
    Remote Service Admin Listener services of events as they happen. Client of
    the events should return quickly and not perform any but trivial
    processing in the same thread.</fo:block>
            <fo:block space-before.optimum="5pt"
                      space-before.minimum="5pt"
                      space-before.maximum="5pt">The following event types are defined:</fo:block>
            <fo:list-block space-before.optimum="1em"
                           space-before.minimum="0.8em"
                           space-before.maximum="1.2em"
                           space-after.optimum="1em"
                           space-after.minimum="0.8em"
                           space-after.maximum="1.2em"
                           provisional-label-separation="0.2em"
                           provisional-distance-between-starts="12pt"
                           id="d61e1181">
               <fo:list-item space-before.optimum="2pt"
                             space-before.minimum="2pt"
                             space-before.maximum="2pt"
                             id="d61e1182">
                  <fo:list-item-label end-indent="label-end()">
                     <fo:block>•</fo:block>
                  </fo:list-item-label>
                  <fo:list-item-body start-indent="body-start()">
                     <fo:block>
                        <fo:block>
                           <fo:basic-link xmlns:d="http://docbook.org/ns/docbook"
                                          xmlns:xlink="http://www.w3.org/1999/xlink"
                                          internal-destination="org.osgi.service.remoteserviceadmin.RemoteServiceAdminEvent.EXPORT_ERROR">
                              <fo:inline color="blue"
                                         font-family="ProductusOSGiBookc,ArialUnicodeMS"
                                         letter-spacing="0.08em"
                                         hyphenate="false">EXPORT_ERROR</fo:inline>
                           </fo:basic-link> - An exported service has run into an
        unrecoverable error, although the Export Registration has not been
        closed yet. The event carries the Export Registration as well as the
        Exception that caused the problem, if present.</fo:block>
                     </fo:block>
                  </fo:list-item-body>
               </fo:list-item>
               <fo:list-item space-before.optimum="2pt"
                             space-before.minimum="2pt"
                             space-before.maximum="2pt"
                             id="d61e1186">
                  <fo:list-item-label end-indent="label-end()">
                     <fo:block>•</fo:block>
                  </fo:list-item-label>
                  <fo:list-item-body start-indent="body-start()">
                     <fo:block>
                        <fo:block>
                           <fo:basic-link xmlns:d="http://docbook.org/ns/docbook"
                                          xmlns:xlink="http://www.w3.org/1999/xlink"
                                          internal-destination="org.osgi.service.remoteserviceadmin.RemoteServiceAdminEvent.EXPORT_REGISTRATION">
                              <fo:inline color="blue"
                                         font-family="ProductusOSGiBookc,ArialUnicodeMS"
                                         letter-spacing="0.08em"
                                         hyphenate="false">EXPORT_REGISTRATION</fo:inline>
                           </fo:basic-link> - The Remote Service Admin has registered a
        new Export Registration.</fo:block>
                     </fo:block>
                  </fo:list-item-body>
               </fo:list-item>
               <fo:list-item space-before.optimum="2pt"
                             space-before.minimum="2pt"
                             space-before.maximum="2pt"
                             id="d61e1190">
                  <fo:list-item-label end-indent="label-end()">
                     <fo:block>•</fo:block>
                  </fo:list-item-label>
                  <fo:list-item-body start-indent="body-start()">
                     <fo:block>
                        <fo:block>
                           <fo:basic-link xmlns:d="http://docbook.org/ns/docbook"
                                          xmlns:xlink="http://www.w3.org/1999/xlink"
                                          internal-destination="org.osgi.service.remoteserviceadmin.RemoteServiceAdminEvent.EXPORT_UNREGISTRATION">
                              <fo:inline color="blue"
                                         font-family="ProductusOSGiBookc,ArialUnicodeMS"
                                         letter-spacing="0.08em"
                                         hyphenate="false">EXPORT_UNREGISTRATION</fo:inline>
                           </fo:basic-link> - An Export Registration has been closed, the
        service is no longer exported and the Endpoint is no longer active
        when this was the last registration for that service/Endpoint
        combination.</fo:block>
                     </fo:block>
                  </fo:list-item-body>
               </fo:list-item>
               <fo:list-item space-before.optimum="2pt"
                             space-before.minimum="2pt"
                             space-before.maximum="2pt"
                             id="d61e1194">
