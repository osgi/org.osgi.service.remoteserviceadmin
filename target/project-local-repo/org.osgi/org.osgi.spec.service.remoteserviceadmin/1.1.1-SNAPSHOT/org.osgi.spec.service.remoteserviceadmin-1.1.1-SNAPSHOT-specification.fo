                  </fo:list-item-label>
                  <fo:list-item-body start-indent="body-start()">
                     <fo:block>
                        <fo:block>
                           <fo:basic-link xmlns:d="http://docbook.org/ns/docbook"
                                          xmlns:xlink="http://www.w3.org/1999/xlink"
                                          internal-destination="org.osgi.service.remoteserviceadmin.RemoteServiceAdminEvent.EXPORT_WARNING">
                              <fo:inline color="blue"
                                         font-family="ProductusOSGiBookc,ArialUnicodeMS"
                                         letter-spacing="0.08em"
                                         hyphenate="false">EXPORT_WARNING</fo:inline>
                           </fo:basic-link> - An exported service is experiencing problems
        but the Endpoint is still available.</fo:block>
                     </fo:block>
                  </fo:list-item-body>
               </fo:list-item>
               <fo:list-item space-before.optimum="2pt"
                             space-before.minimum="2pt"
                             space-before.maximum="2pt"
                             id="d61e1202">
