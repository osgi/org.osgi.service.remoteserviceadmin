                                          </fo:list-item-label>
                                          <fo:list-item-body start-indent="body-start()">
                                             <fo:block>public  EndpointPermission(EndpointDescription endpoint, String localFrameworkUUID, String actions)</fo:block>
                                          </fo:list-item-body>
