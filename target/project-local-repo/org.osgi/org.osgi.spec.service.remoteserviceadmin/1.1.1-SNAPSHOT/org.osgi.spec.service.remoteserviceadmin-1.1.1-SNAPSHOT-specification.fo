                            space-after="3pt"
                            space-after.conditionality="retain"
                            start-indent="inherit"
                            line-height="11pt"
                            id="d61e2129"> endpoint.package.version.com.acme</fo:block>
                  <fo:block space-before.optimum="5pt"
                            space-before.minimum="5pt"
                            space-before.maximum="5pt">
 
 The value of this property is in String format and will be converted to a
 {@code Version} object by this method.
   </fo:block>
