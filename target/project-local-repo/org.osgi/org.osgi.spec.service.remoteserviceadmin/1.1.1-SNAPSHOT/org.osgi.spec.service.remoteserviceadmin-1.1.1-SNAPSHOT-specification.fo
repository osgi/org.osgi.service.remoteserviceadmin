                     <fo:list-item>
                        <fo:list-item-label end-indent="label-end()" text-align="start">
                           <fo:block>Table 122.2</fo:block>
                        </fo:list-item-label>
                        <fo:list-item-body start-indent="body-start()">
                           <fo:block>Property Attributes</fo:block>
                        </fo:list-item-body>
                     </fo:list-item>
                  </fo:list-block>
