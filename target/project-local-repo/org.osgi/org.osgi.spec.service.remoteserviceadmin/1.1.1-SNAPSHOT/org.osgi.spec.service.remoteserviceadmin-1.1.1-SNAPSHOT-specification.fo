                                       padding-top="1pt"
                                       padding-bottom="1pt">
                           <fo:block>
                              <fo:inline font-family="ProductusOSGiBookc,ArialUnicodeMS"
                                         font-size="9pt"
                                         letter-spacing="0.08em">String</fo:inline>
                           </fo:block>
                        </fo:table-cell>
                        <fo:table-cell padding-start="0pt"
                                       padding-end="4pt"
                                       padding-top="1pt"
                                       padding-bottom="1pt">
                           <fo:block>
                              <fo:block space-before.optimum="5pt"
                                        space-before.minimum="5pt"
                                        space-before.maximum="5pt">The required name of the property. The type maps to
            the XML Schema <fo:inline font-family="ProductusOSGiBookc,ArialUnicodeMS"
                                            font-size="9pt"
                                            letter-spacing="0.08em">xsd:string</fo:inline> type.</fo:block>
                           </fo:block>
                        </fo:table-cell>
                     </fo:table-row>
                     <fo:table-row keep-together.within-column="always">
                        <fo:table-cell padding-start="0pt"
                                       padding-end="4pt"
                                       padding-top="1pt"
                                       padding-bottom="1pt">
                           <fo:block>
                              <fo:inline font-family="ProductusOSGiBookc,ArialUnicodeMS"
                                         font-size="9pt"
                                         letter-spacing="0.08em">value-type</fo:inline>
                           </fo:block>
                        </fo:table-cell>
                        <fo:table-cell padding-start="0pt"
                                       padding-end="4pt"
                                       padding-top="1pt"
                                       padding-bottom="1pt">
                           <fo:block>
                              <fo:block space-before.optimum="5pt"
                                        space-before.minimum="5pt"
                                        space-before.maximum="5pt">
                                 <fo:inline font-family="ProductusOSGiBookc,ArialUnicodeMS"
                                            font-size="9pt"
                                            letter-spacing="0.08em">  String</fo:inline>
                              </fo:block>
                              <fo:block space-before.optimum="5pt"
                                        space-before.minimum="5pt"
                                        space-before.maximum="5pt">
                                 <fo:inline font-family="ProductusOSGiBookc,ArialUnicodeMS"
                                            font-size="9pt"
                                            letter-spacing="0.08em">|
            long</fo:inline>
                              </fo:block>
                              <fo:block space-before.optimum="5pt"
                                        space-before.minimum="5pt"
                                        space-before.maximum="5pt">
                                 <fo:inline font-family="ProductusOSGiBookc,ArialUnicodeMS"
                                            font-size="9pt"
                                            letter-spacing="0.08em">| Long</fo:inline>
                              </fo:block>
                              <fo:block space-before.optimum="5pt"
                                        space-before.minimum="5pt"
                                        space-before.maximum="5pt">
                                 <fo:inline font-family="ProductusOSGiBookc,ArialUnicodeMS"
                                            font-size="9pt"
                                            letter-spacing="0.08em">|
            double</fo:inline>
                              </fo:block>
                              <fo:block space-before.optimum="5pt"
                                        space-before.minimum="5pt"
                                        space-before.maximum="5pt">
                                 <fo:inline font-family="ProductusOSGiBookc,ArialUnicodeMS"
                                            font-size="9pt"
                                            letter-spacing="0.08em">|
            Double</fo:inline>
                              </fo:block>
                              <fo:block space-before.optimum="5pt"
                                        space-before.minimum="5pt"
                                        space-before.maximum="5pt">
                                 <fo:inline font-family="ProductusOSGiBookc,ArialUnicodeMS"
                                            font-size="9pt"
                                            letter-spacing="0.08em">| float</fo:inline>
                              </fo:block>
                              <fo:block space-before.optimum="5pt"
                                        space-before.minimum="5pt"
                                        space-before.maximum="5pt">
                                 <fo:inline font-family="ProductusOSGiBookc,ArialUnicodeMS"
                                            font-size="9pt"
                                            letter-spacing="0.08em">|
            Float</fo:inline>
                              </fo:block>
                              <fo:block space-before.optimum="5pt"
                                        space-before.minimum="5pt"
                                        space-before.maximum="5pt">
                                 <fo:inline font-family="ProductusOSGiBookc,ArialUnicodeMS"
                                            font-size="9pt"
                                            letter-spacing="0.08em">| int</fo:inline>
                              </fo:block>
                              <fo:block space-before.optimum="5pt"
                                        space-before.minimum="5pt"
                                        space-before.maximum="5pt">
                                 <fo:inline font-family="ProductusOSGiBookc,ArialUnicodeMS"
                                            font-size="9pt"
                                            letter-spacing="0.08em">|
            Integer</fo:inline>
                              </fo:block>
                              <fo:block space-before.optimum="5pt"
                                        space-before.minimum="5pt"
                                        space-before.maximum="5pt">
                                 <fo:inline font-family="ProductusOSGiBookc,ArialUnicodeMS"
                                            font-size="9pt"
                                            letter-spacing="0.08em">| byte</fo:inline>
                              </fo:block>
                              <fo:block space-before.optimum="5pt"
                                        space-before.minimum="5pt"
                                        space-before.maximum="5pt">
                                 <fo:inline font-family="ProductusOSGiBookc,ArialUnicodeMS"
                                            font-size="9pt"
                                            letter-spacing="0.08em">|
            Byte</fo:inline>
                              </fo:block>
                              <fo:block space-before.optimum="5pt"
                                        space-before.minimum="5pt"
                                        space-before.maximum="5pt">
                                 <fo:inline font-family="ProductusOSGiBookc,ArialUnicodeMS"
                                            font-size="9pt"
                                            letter-spacing="0.08em">| char</fo:inline>
                              </fo:block>
                              <fo:block space-before.optimum="5pt"
                                        space-before.minimum="5pt"
                                        space-before.maximum="5pt">
                                 <fo:inline font-family="ProductusOSGiBookc,ArialUnicodeMS"
                                            font-size="9pt"
                                            letter-spacing="0.08em">|
            Character</fo:inline>
                              </fo:block>
                              <fo:block space-before.optimum="5pt"
                                        space-before.minimum="5pt"
                                        space-before.maximum="5pt">
                                 <fo:inline font-family="ProductusOSGiBookc,ArialUnicodeMS"
                                            font-size="9pt"
                                            letter-spacing="0.08em">|
            boolean</fo:inline>
                              </fo:block>
                              <fo:block space-before.optimum="5pt"
                                        space-before.minimum="5pt"
                                        space-before.maximum="5pt">
                                 <fo:inline font-family="ProductusOSGiBookc,ArialUnicodeMS"
                                            font-size="9pt"
                                            letter-spacing="0.08em">|
            Boolean</fo:inline>
                              </fo:block>
                              <fo:block space-before.optimum="5pt"
                                        space-before.minimum="5pt"
                                        space-before.maximum="5pt">
                                 <fo:inline font-family="ProductusOSGiBookc,ArialUnicodeMS"
                                            font-size="9pt"
                                            letter-spacing="0.08em">|
            short</fo:inline>
                              </fo:block>
                              <fo:block space-before.optimum="5pt"
                                        space-before.minimum="5pt"
                                        space-before.maximum="5pt">
                                 <fo:inline font-family="ProductusOSGiBookc,ArialUnicodeMS"
                                            font-size="9pt"
                                            letter-spacing="0.08em">| Short</fo:inline>
                              </fo:block>
                           </fo:block>
                        </fo:table-cell>
                        <fo:table-cell padding-start="0pt"
                                       padding-end="4pt"
                                       padding-top="1pt"
                                       padding-bottom="1pt">
                           <fo:block>
                              <fo:block space-before.optimum="5pt"
                                        space-before.minimum="5pt"
                                        space-before.maximum="5pt">The optional type name of the property, the default
            is <fo:inline font-family="ProductusOSGiBookc,ArialUnicodeMS"
                                            font-size="9pt"
                                            letter-spacing="0.08em">String</fo:inline>. Any value in the value attribute or the
            value element when collections are used must be converted to the
            corresponding Java types. If the primitive form, for example
            <fo:inline font-family="ProductusOSGiBookc,ArialUnicodeMS"
                                            font-size="9pt"
                                            letter-spacing="0.08em">byte</fo:inline>, is specified for non-array types, then the
            value must be silently converted to the corresponding wrapper
            type.</fo:block>
                           </fo:block>
                        </fo:table-cell>
                     </fo:table-row>
                     <fo:table-row keep-together.within-column="always">
                        <fo:table-cell padding-start="0pt"
                                       padding-end="4pt"
                                       padding-top="1pt"
                                       padding-bottom="1pt">
                           <fo:block>
                              <fo:inline font-family="ProductusOSGiBookc,ArialUnicodeMS"
                                         font-size="9pt"
                                         letter-spacing="0.08em">value</fo:inline>
                           </fo:block>
                        </fo:table-cell>
                        <fo:table-cell padding-start="0pt"
                                       padding-end="4pt"
                                       padding-top="1pt"
                                       padding-bottom="1pt">
                           <fo:block>
                              <fo:inline font-family="ProductusOSGiBookc,ArialUnicodeMS"
                                         font-size="9pt"
                                         letter-spacing="0.08em">String</fo:inline>
                           </fo:block>
                        </fo:table-cell>
                        <fo:table-cell padding-start="0pt"
                                       padding-end="4pt"
                                       padding-top="1pt"
                                       padding-bottom="1pt">
                           <fo:block>
                              <fo:block space-before.optimum="5pt"
                                        space-before.minimum="5pt"
                                        space-before.maximum="5pt">The value. Must be converted to the specified type if
            this is not the <fo:inline font-family="ProductusOSGiBookc,ArialUnicodeMS"
                                            font-size="9pt"
                                            letter-spacing="0.08em">String</fo:inline> type. The <fo:inline font-family="ProductusOSGiBookc,ArialUnicodeMS"
                                            font-size="9pt"
                                            letter-spacing="0.08em">value</fo:inline>
            attribute must not be used when the <fo:inline font-family="ProductusOSGiBookc,ArialUnicodeMS"
                                            font-size="9pt"
                                            letter-spacing="0.08em">property</fo:inline> element
            has a child element.</fo:block>
                           </fo:block>
                        </fo:table-cell>
                     </fo:table-row>
                  </fo:table-body>
               </fo:table>
            </fo:block>
            <fo:block space-before.optimum="5pt"
                      space-before.minimum="5pt"
                      space-before.maximum="5pt">A property can have an <fo:inline font-family="ProductusOSGiBookc,ArialUnicodeMS"
                          font-size="9pt"
                          letter-spacing="0.08em">array</fo:inline>, <fo:inline font-family="ProductusOSGiBookc,ArialUnicodeMS"
                          font-size="9pt"
                          letter-spacing="0.08em">list</fo:inline>,
    <fo:inline font-family="ProductusOSGiBookc,ArialUnicodeMS"
                          font-size="9pt"
                          letter-spacing="0.08em">set</fo:inline>, or <fo:inline font-family="ProductusOSGiBookc,ArialUnicodeMS"
                          font-size="9pt"
                          letter-spacing="0.08em">xml</fo:inline> child element. If a child element is
    present then it is an error if the <fo:inline font-family="ProductusOSGiBookc,ArialUnicodeMS"
                          font-size="9pt"
                          letter-spacing="0.08em">value</fo:inline> attribute is
    defined. It is also an error of there is no child element and no
    <fo:inline font-family="ProductusOSGiBookc,ArialUnicodeMS"
                          font-size="9pt"
                          letter-spacing="0.08em">value</fo:inline> attribute.</fo:block>
            <fo:block space-before.optimum="5pt"
                      space-before.minimum="5pt"
                      space-before.maximum="5pt">The <fo:inline font-family="ProductusOSGiBookc,ArialUnicodeMS"
                          font-size="9pt"
                          letter-spacing="0.08em">array</fo:inline>, <fo:inline font-family="ProductusOSGiBookc,ArialUnicodeMS"
                          font-size="9pt"
                          letter-spacing="0.08em">list</fo:inline>, or <fo:inline font-family="ProductusOSGiBookc,ArialUnicodeMS"
                          font-size="9pt"
                          letter-spacing="0.08em">set</fo:inline> are
    <fo:inline font-style="italic">multi-valued</fo:inline>. That is, they contain 0 or more
    <fo:inline font-family="ProductusOSGiBookc,ArialUnicodeMS"
                          font-size="9pt"
                          letter-spacing="0.08em">value</fo:inline> elements. A value element contains text (a string) that
    must be converted to the given value-type or if not specified, left as is.
    Conversion must <fo:inline font-style="italic">trim</fo:inline> the leading and trailing white
    space characters as defined in the <fo:inline font-family="ProductusOSGiBookc,ArialUnicodeMS"
                          font-size="9pt"
                          letter-spacing="0.08em">Character.isWhitespace</fo:inline>
    method. No trimming must be done for strings. An array of primitive
    integers like <fo:inline font-family="ProductusOSGiBookc,ArialUnicodeMS"
                          font-size="9pt"
                          letter-spacing="0.08em">int[] {1,42,97}</fo:inline> can be encoded as
    follows:</fo:block>
            <fo:block space-before.minimum="0.8em"
                      space-before.optimum="1em"
                      space-before.maximum="1.2em"
                      space-after.minimum="0.8em"
                      space-after.optimum="1em"
                      space-after.maximum="1.2em"
                      hyphenate="false"
                      wrap-option="no-wrap"
                      white-space-collapse="false"
                      white-space-treatment="preserve"
                      linefeed-treatment="preserve"
                      text-align="start"
                      font-family="ProductusOSGiMonoc,ArialUnicodeMS"
                      font-size="9pt"
                      letter-spacing="-.0em"
                      space-before="5pt"
                      space-after="3pt"
                      space-after.conditionality="retain"
                      start-indent="inherit"
                      line-height="11pt"
                      id="d61e1543">&lt;property name="integers" value-type="int"&gt;
    &lt;array&gt;
        &lt;value&gt; 1&lt;/value&gt;
        &lt;value&gt;42&lt;/value&gt;
        &lt;value&gt;97&lt;/value&gt;
    &lt;/array&gt;
&lt;/property&gt;</fo:block>
            <fo:block space-before.optimum="5pt"
                      space-before.minimum="5pt"
                      space-before.maximum="5pt">The <fo:inline font-family="ProductusOSGiBookc,ArialUnicodeMS"
                          font-size="9pt"
                          letter-spacing="0.08em">xml</fo:inline> element is used to convey XML from other
    namespaces, it is allowed to contain one foreign XML root element, with
    any number of children, that will act as the root element of an XML
    document. This root element will be included in the corresponding property
    as a string. The XML element must be a valid XML document but not contain
    the XML processing instructions, the part between the <fo:inline font-family="ProductusOSGiBookc,ArialUnicodeMS"
                          font-size="9pt"
                          letter-spacing="0.08em">&lt;?</fo:inline>
    and <fo:inline font-family="ProductusOSGiBookc,ArialUnicodeMS"
                          font-size="9pt"
                          letter-spacing="0.08em">?&gt;</fo:inline>. The <fo:inline font-family="ProductusOSGiBookc,ArialUnicodeMS"
                          font-size="9pt"
                          letter-spacing="0.08em">value-type</fo:inline> of the property must
    be <fo:inline font-family="ProductusOSGiBookc,ArialUnicodeMS"
                          font-size="9pt"
                          letter-spacing="0.08em">String</fo:inline> or not set when an <fo:inline font-family="ProductusOSGiBookc,ArialUnicodeMS"
                          font-size="9pt"
                          letter-spacing="0.08em">xml</fo:inline> element is
    used, using another type is invalid.</fo:block>
            <fo:block space-before.optimum="5pt"
                      space-before.minimum="5pt"
                      space-before.maximum="5pt">The <fo:inline font-family="ProductusOSGiBookc,ArialUnicodeMS"
                          font-size="9pt"
                          letter-spacing="0.08em">xml</fo:inline> element can be used to embed configuration
    information, making the Endpoint Description self contained.</fo:block>
            <fo:block space-before.optimum="5pt"
                      space-before.minimum="5pt"
                      space-before.maximum="5pt">The following is an example of an <fo:inline font-family="ProductusOSGiBookc,ArialUnicodeMS"
                          font-size="9pt"
                          letter-spacing="0.08em">endpoint-descriptions</fo:inline>
    resource.</fo:block>
            <fo:block space-before.minimum="0.8em"
                      space-before.optimum="1em"
                      space-before.maximum="1.2em"
                      space-after.minimum="0.8em"
                      space-after.optimum="1em"
                      space-after.maximum="1.2em"
                      hyphenate="false"
                      wrap-option="no-wrap"
                      white-space-collapse="false"
                      white-space-treatment="preserve"
                      linefeed-treatment="preserve"
                      text-align="start"
                      font-family="ProductusOSGiMonoc,ArialUnicodeMS"
                      font-size="9pt"
                      letter-spacing="-.0em"
                      space-before="5pt"
                      space-after="3pt"
                      space-after.conditionality="retain"
                      start-indent="inherit"
                      line-height="11pt"
                      id="d61e1567">&lt;?xml version="1.0" encoding="UTF-8"?&gt;
&lt;endpoint-descriptions xmlns="http://www.osgi.org/xmlns/rsa/v1.0.0"&gt;
    &lt;endpoint-description&gt;
        &lt;property name="service.intents"&gt;
            &lt;list&gt;
                &lt;value&gt;SOAP&lt;/value&gt;
                &lt;value&gt;HTTP&lt;/value&gt;
            &lt;/list&gt;
        &lt;/property&gt;
        &lt;property name="endpoint.id" value="http://ws.acme.com:9000/hello"/&gt; 
        &lt;property name="endpoint.package.version.com.acme" value="4.2"/&gt;
        &lt;property name="objectClass"&gt;
            &lt;array&gt;
                &lt;value&gt;com.acme.Foo&lt;/value&gt;
            &lt;/array&gt;
        &lt;/property&gt;
        &lt;property name="service.imported.configs" value="com.acme"/&gt;
        &lt;property name="com.acme.ws.xml"&gt;
            &lt;xml&gt;
                &lt;config xmlns="http://acme.com/defs"&gt;
                    &lt;port&gt;1029&lt;/port&gt;
                    &lt;host&gt;www.acme.com&lt;/host&gt;
                &lt;/config&gt;
            &lt;/xml&gt;
        &lt;/property&gt;
    &lt;/endpoint-description&gt;
&lt;/endpoint-descriptions&gt;</fo:block>
            <fo:block space-before.optimum="5pt"
                      space-before.minimum="5pt"
                      space-before.maximum="5pt">Besides being in a separate resource, the static configuration as
    described here could also be part of a larger XML file. In that case the
    parser must ignore elements not part of the
    <fo:inline font-family="ProductusOSGiBookc,ArialUnicodeMS"
                          font-size="9pt"
                          letter-spacing="0.08em">http://www.osgi.org/xmlns/rsa/v1.0.0</fo:inline> namespace schema.</fo:block>
            <fo:block id="d61e1572">
               <fo:block>
                  <fo:block>
                     <fo:block keep-together.within-column="always"
                               margin-left="0pt"
                               font-family="ProductusSemibold,ArialUnicodeMS">
                        <fo:block keep-with-next.within-column="always">
                           <fo:block xmlns:d="http://docbook.org/ns/docbook"
                                     xmlns:xlink="http://www.w3.org/1999/xlink"
                                     font-family="ProductusSemibold,ArialUnicodeMS"
                                     font-weight="normal"
                                     keep-with-next.within-column="always"
                                     space-before.minimum="0.8em"
                                     space-before.optimum="1.0em"
                                     space-before.maximum="1.2em"
                                     text-align="start"
                                     start-indent="0pt"
                                     hyphenate="false">
                              <fo:block font-size="12pt"
                                        line-height="14pt"
                                        space-before="8pt"
                                        space-after="5pt">
                                 <fo:list-block provisional-distance-between-starts="1in"
                                                provisional-label-separation="0.090in">
                                    <fo:list-item>
                                       <fo:list-item-label end-indent="label-end()" text-align="start">
                                          <fo:block>122.8.1</fo:block>
                                       </fo:list-item-label>
                                       <fo:list-item-body start-indent="body-start()">
                                          <fo:block>XML Schema</fo:block>
                                       </fo:list-item-body>
                                    </fo:list-item>
                                 </fo:list-block>
                              </fo:block>
                           </fo:block>
                        </fo:block>
                     </fo:block>
                  </fo:block>
               </fo:block>
               <fo:block space-before.optimum="5pt"
                         space-before.minimum="5pt"
                         space-before.maximum="5pt">This namespace of the schema is:</fo:block>
               <fo:block space-before.minimum="0.8em"
                         space-before.optimum="1em"
                         space-before.maximum="1.2em"
                         space-after.minimum="0.8em"
                         space-after.optimum="1em"
                         space-after.maximum="1.2em"
                         hyphenate="false"
                         wrap-option="no-wrap"
                         white-space-collapse="false"
                         white-space-treatment="preserve"
                         linefeed-treatment="preserve"
                         text-align="start"
                         font-family="ProductusOSGiMonoc,ArialUnicodeMS"
                         font-size="9pt"
                         letter-spacing="-.0em"
                         space-before="5pt"
                         space-after="3pt"
                         space-after.conditionality="retain"
                         start-indent="inherit"
                         line-height="11pt"
                         id="d61e1575">http://www.osgi.org/xmlns/rsa/v1.0.0</fo:block>
               <fo:block space-before.minimum="0.8em"
                         space-before.optimum="1em"
                         space-before.maximum="1.2em"
                         space-after.minimum="0.8em"
                         space-after.optimum="1em"
                         space-after.maximum="1.2em"
                         hyphenate="false"
                         wrap-option="no-wrap"
                         white-space-collapse="false"
                         white-space-treatment="preserve"
                         linefeed-treatment="preserve"
                         text-align="start"
                         font-family="ProductusOSGiMonoc,ArialUnicodeMS"
