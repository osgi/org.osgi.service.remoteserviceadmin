                         space-after.conditionality="retain"
                         start-indent="inherit"
                         line-height="11pt"
                         id="d61e1725">Provide-Capability: osgi.remoteserviceadmin.distribution;
    configs:List&lt;String&gt;="org.acme.jaxws,org.acme.jaxrs"; version:Version=1.1</fo:block>
            </fo:block>
            <fo:block id="d61e1726">
               <fo:block>
                  <fo:block>
                     <fo:block keep-together.within-column="always"
                               margin-left="0pt"
                               font-family="ProductusSemibold,ArialUnicodeMS">
                        <fo:block keep-with-next.within-column="always">
                           <fo:block xmlns:d="http://docbook.org/ns/docbook"
                                     xmlns:xlink="http://www.w3.org/1999/xlink"
                                     font-family="ProductusSemibold,ArialUnicodeMS"
                                     font-weight="normal"
                                     keep-with-next.within-column="always"
                                     space-before.minimum="0.8em"
                                     space-before.optimum="1.0em"
                                     space-before.maximum="1.2em"
                                     text-align="start"
                                     start-indent="0pt"
                                     hyphenate="false">
                              <fo:block font-size="12pt"
                                        line-height="14pt"
                                        space-before="8pt"
                                        space-after="5pt">
                                 <fo:list-block provisional-distance-between-starts="1in"
                                                provisional-label-separation="0.090in">
                                    <fo:list-item>
                                       <fo:list-item-label end-indent="label-end()" text-align="start">
                                          <fo:block>122.9.4</fo:block>
                                       </fo:list-item-label>
                                       <fo:list-item-body start-indent="body-start()">
                                          <fo:block>Topology Manager Capability</fo:block>
                                       </fo:list-item-body>
                                    </fo:list-item>
                                 </fo:list-block>
                              </fo:block>
                           </fo:block>
                        </fo:block>
                     </fo:block>
                  </fo:block>
               </fo:block>
               <fo:block space-before.optimum="5pt"
                         space-before.minimum="5pt"
                         space-before.maximum="5pt">Remote Service Admin topology managers may use different policies
      when determining which services to export and/or import. Topology
      managers use the namespace <fo:inline font-family="ProductusOSGiBookc,ArialUnicodeMS"
                             font-size="9pt"
                             letter-spacing="0.08em">osgi.remoteserviceadmin.topology</fo:inline>
      to declare this behavior. This namespace defines the <fo:inline font-family="ProductusOSGiBookc,ArialUnicodeMS"
                             font-size="9pt"
                             letter-spacing="0.08em">policy</fo:inline>
      attribute of type <fo:inline font-family="ProductusOSGiBookc,ArialUnicodeMS"
                             font-size="9pt"
                             letter-spacing="0.08em">List&lt;String&gt;</fo:inline>. Values are
      implementation specific, but example definitions can be found at <fo:basic-link xmlns:d="http://docbook.org/ns/docbook"
                                 xmlns:xlink="http://www.w3.org/1999/xlink"
                                 internal-destination="service.remoteserviceadmin-example.policies">
                     <fo:inline color="inherit"
                                font-family="inherit"
                                letter-spacing="inherit"
                                hyphenate="inherit">
                        <fo:inline font-style="italic">Example Use Cases</fo:inline> on page <fo:page-number-citation ref-id="service.remoteserviceadmin-example.policies"/>
                     </fo:inline>
                  </fo:basic-link>.</fo:block>
               <fo:block xmlns:rx="http://www.renderx.com/XSL/Extensions" start-indent="0pt">
                  <fo:block space-before.minimum="0.5em"
                            space-before.optimum="1em"
                            space-before.maximum="2em"
                            space-after.minimum="0.5em"
                            space-after.optimum="1em"
                            space-after.maximum="2em"
                            keep-together.within-column="auto"
                            id="d61e1738">
                     <fo:block xmlns:d="http://docbook.org/ns/docbook"
                               xmlns:xlink="http://www.w3.org/1999/xlink"
                               space-before.optimum="5pt"
                               space-before.minimum="5pt"
                               space-before.maximum="5pt"
                               font-weight="normal"
                               font-size="9pt"
                               hyphenate="false"
                               space-after.minimum="0.4em"
                               space-after.optimum="0.6em"
                               space-after.maximum="0.8em"
                               start-indent="0pt"
                               font-family="Proforma-Book,ArialUnicodeMS"
                               font-style="italic"
                               keep-with-next.within-column="always">
                        <fo:list-block provisional-distance-between-starts="1in"
                                       provisional-label-separation="0.090in">
                           <fo:list-item>
                              <fo:list-item-label end-indent="label-end()" text-align="start">
                                 <fo:block>Table 122.5</fo:block>
                              </fo:list-item-label>
                              <fo:list-item-body start-indent="body-start()">
                                 <fo:block>osgi.remoteserviceadmin.topology Namespace</fo:block>
                              </fo:list-item-body>
                           </fo:list-item>
                        </fo:list-block>
                     </fo:block>
                     <fo:table border-before-width.conditionality="retain"
                               border-collapse="collapse"
                               table-layout="fixed"
                               width="100%">
                        <fo:table-column column-number="1" column-width="proportional-column-width(2)"/>
                        <fo:table-column column-number="2" column-width="proportional-column-width(1)"/>
                        <fo:table-column column-number="3" column-width="proportional-column-width(1)"/>
