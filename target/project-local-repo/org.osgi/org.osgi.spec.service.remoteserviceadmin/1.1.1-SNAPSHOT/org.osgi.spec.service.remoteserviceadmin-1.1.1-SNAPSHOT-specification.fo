                                             <fo:block>122.12.11.2</fo:block>
                                          </fo:list-item-label>
                                          <fo:list-item-body start-indent="body-start()">
                                             <fo:block>public static final String ENDPOINT_ID = "endpoint.id"</fo:block>
                                          </fo:list-item-body>
