                              <fo:block>Methods</fo:block>
                           </fo:table-cell>
                           <fo:table-cell padding-start="0pt"
                                          padding-end="4pt"
                                          padding-top="1pt"
                                          padding-bottom="1pt">
                              <fo:block>Description</fo:block>
                           </fo:table-cell>
                        </fo:table-row>
                     </fo:table-header>
                     <fo:table-body start-indent="0pt" end-indent="0pt">
                        <fo:table-row keep-together.within-column="always">
                           <fo:table-cell padding-start="0pt"
                                          padding-end="4pt"
                                          padding-top="1pt"
                                          padding-bottom="1pt">
                              <fo:block>
                                 <fo:inline font-family="ProductusOSGiBookc,ArialUnicodeMS"
                                            font-size="9pt"
                                            letter-spacing="0.08em">IMPORT</fo:inline>
                              </fo:block>
                           </fo:table-cell>
                           <fo:table-cell padding-start="0pt"
                                          padding-end="4pt"
                                          padding-top="1pt"
                                          padding-bottom="1pt">
                              <fo:block>
                                 <fo:block space-before.optimum="5pt"
                                           space-before.minimum="5pt"
                                           space-before.maximum="5pt">
                                    <fo:basic-link xmlns:d="http://docbook.org/ns/docbook"
                                                   xmlns:xlink="http://www.w3.org/1999/xlink"
                                                   internal-destination="org.osgi.service.remoteserviceadmin.RemoteServiceAdmin.importService-EndpointDescription-">
                                       <fo:inline color="blue"
                                                  font-family="ProductusOSGiBookc,ArialUnicodeMS"
                                                  letter-spacing="0.08em"
                                                  hyphenate="false">importService(EndpointDescription)</fo:inline>
                                    </fo:basic-link>
                                 </fo:block>
                              </fo:block>
                           </fo:table-cell>
                           <fo:table-cell padding-start="0pt"
                                          padding-end="4pt"
                                          padding-top="1pt"
                                          padding-bottom="1pt">
                              <fo:block>
                                 <fo:block space-before.optimum="5pt"
                                           space-before.minimum="5pt"
                                           space-before.maximum="5pt">Import an Endpoint</fo:block>
                              </fo:block>
                           </fo:table-cell>
                        </fo:table-row>
                        <fo:table-row keep-together.within-column="always">
                           <fo:table-cell padding-start="0pt"
                                          padding-end="4pt"
                                          padding-top="1pt"
                                          padding-bottom="1pt">
                              <fo:block>
                                 <fo:inline font-family="ProductusOSGiBookc,ArialUnicodeMS"
                                            font-size="9pt"
                                            letter-spacing="0.08em">EXPORT</fo:inline>
                              </fo:block>
                           </fo:table-cell>
                           <fo:table-cell padding-start="0pt"
                                          padding-end="4pt"
                                          padding-top="1pt"
                                          padding-bottom="1pt">
                              <fo:block>
                                 <fo:block space-before.optimum="5pt"
                                           space-before.minimum="5pt"
                                           space-before.maximum="5pt">
                                    <fo:basic-link xmlns:d="http://docbook.org/ns/docbook"
                                                   xmlns:xlink="http://www.w3.org/1999/xlink"
                                                   internal-destination="org.osgi.service.remoteserviceadmin.RemoteServiceAdmin.exportService-ServiceReference-Map-">
                                       <fo:inline color="blue"
                                                  font-family="ProductusOSGiBookc,ArialUnicodeMS"
                                                  letter-spacing="0.08em"
                                                  hyphenate="false">exportService(ServiceReference,Map)</fo:inline>
                                    </fo:basic-link>
                                 </fo:block>
                              </fo:block>
                           </fo:table-cell>
                           <fo:table-cell padding-start="0pt"
                                          padding-end="4pt"
                                          padding-top="1pt"
                                          padding-bottom="1pt">
                              <fo:block>
                                 <fo:block space-before.optimum="5pt"
                                           space-before.minimum="5pt"
                                           space-before.maximum="5pt">Export a service</fo:block>
                              </fo:block>
                           </fo:table-cell>
                        </fo:table-row>
                        <fo:table-row keep-together.within-column="always">
                           <fo:table-cell padding-start="0pt"
                                          padding-end="4pt"
                                          padding-top="1pt"
                                          padding-bottom="1pt">
                              <fo:block>
                                 <fo:inline font-family="ProductusOSGiBookc,ArialUnicodeMS"
                                            font-size="9pt"
                                            letter-spacing="0.08em">READ</fo:inline>
                              </fo:block>
                           </fo:table-cell>
                           <fo:table-cell padding-start="0pt"
                                          padding-end="4pt"
                                          padding-top="1pt"
                                          padding-bottom="1pt">
                              <fo:block>
                                 <fo:block space-before.optimum="5pt"
                                           space-before.minimum="5pt"
                                           space-before.maximum="5pt">
                                    <fo:basic-link xmlns:d="http://docbook.org/ns/docbook"
                                                   xmlns:xlink="http://www.w3.org/1999/xlink"
                                                   internal-destination="org.osgi.service.remoteserviceadmin.RemoteServiceAdmin.getExportedServices--">
                                       <fo:inline color="blue"
                                                  font-family="ProductusOSGiBookc,ArialUnicodeMS"
                                                  letter-spacing="0.08em"
                                                  hyphenate="false">getExportedServices()</fo:inline>
                                    </fo:basic-link>
                                 </fo:block>
                                 <fo:block space-before.optimum="5pt"
                                           space-before.minimum="5pt"
                                           space-before.maximum="5pt">
                                    <fo:basic-link xmlns:d="http://docbook.org/ns/docbook"
                                                   xmlns:xlink="http://www.w3.org/1999/xlink"
                                                   internal-destination="org.osgi.service.remoteserviceadmin.RemoteServiceAdmin.getImportedEndpoints--">
                                       <fo:inline color="blue"
                                                  font-family="ProductusOSGiBookc,ArialUnicodeMS"
                                                  letter-spacing="0.08em"
                                                  hyphenate="false">getImportedEndpoints()</fo:inline>
                                    </fo:basic-link>
                                 </fo:block>
                                 <fo:block space-before.optimum="5pt"
                                           space-before.minimum="5pt"
                                           space-before.maximum="5pt">
                                    <fo:basic-link xmlns:d="http://docbook.org/ns/docbook"
                                                   xmlns:xlink="http://www.w3.org/1999/xlink"
                                                   internal-destination="org.osgi.service.remoteserviceadmin.RemoteServiceAdminListener.remoteAdminEvent-RemoteServiceAdminEvent-">
                                       <fo:inline color="blue"
                                                  font-family="ProductusOSGiBookc,ArialUnicodeMS"
                                                  letter-spacing="0.08em"
                                                  hyphenate="false">remoteAdminEvent(RemoteServiceAdminEvent)</fo:inline>
                                    </fo:basic-link>
                                 </fo:block>
                              </fo:block>
                           </fo:table-cell>
                           <fo:table-cell padding-start="0pt"
                                          padding-end="4pt"
                                          padding-top="1pt"
                                          padding-bottom="1pt">
                              <fo:block>
                                 <fo:block space-before.optimum="5pt"
                                           space-before.minimum="5pt"
                                           space-before.maximum="5pt">See the presence of distributed services. The
              <fo:inline font-family="ProductusOSGiBookc,ArialUnicodeMS"
                                               font-size="9pt"
                                               letter-spacing="0.08em">IMPORT</fo:inline> and <fo:inline font-family="ProductusOSGiBookc,ArialUnicodeMS"
                                               font-size="9pt"
                                               letter-spacing="0.08em">EXPORT</fo:inline> action imply
              <fo:inline font-family="ProductusOSGiBookc,ArialUnicodeMS"
                                               font-size="9pt"
                                               letter-spacing="0.08em">READ</fo:inline>. Distribution of events to the Remote Service
              Admin Listener. The Remote Service Admin must verify that the
              listener's bundle has the proper permission. No events should be
              delivered that are not implied.</fo:block>
                              </fo:block>
                           </fo:table-cell>
                        </fo:table-row>
                     </fo:table-body>
                  </fo:table>
               </fo:block>
            </fo:block>
         </fo:block>
         <fo:block id="org.osgi.service.remoteserviceadmin">
            <fo:block>
               <fo:block>
                  <fo:block keep-together.within-column="always"
                            margin-left="0pt"
                            font-family="ProductusSemibold,ArialUnicodeMS">
                     <fo:block keep-with-next.within-column="always">
                        <fo:block xmlns:d="http://docbook.org/ns/docbook"
                                  xmlns:xlink="http://www.w3.org/1999/xlink"
                                  font-family="ProductusSemibold,ArialUnicodeMS"
                                  font-weight="normal"
                                  keep-with-next.within-column="always"
                                  space-before.minimum="0.8em"
                                  space-before.optimum="1.0em"
                                  space-before.maximum="1.2em"
                                  text-align="start"
                                  start-indent="0pt"
                                  hyphenate="false">
                           <fo:marker marker-class-name="section.head.marker">org.osgi.service.remoteserviceadmin</fo:marker>
                           <fo:block font-size="18pt"
                                     line-height="25pt"
                                     space-before="12.5pt"
                                     space-after="12pt">
                              <fo:list-block provisional-distance-between-starts="1in"
                                             provisional-label-separation="0.090in">
                                 <fo:list-item>
                                    <fo:list-item-label end-indent="label-end()" text-align="start">
                                       <fo:block>122.12</fo:block>
                                    </fo:list-item-label>
                                    <fo:list-item-body start-indent="body-start()">
                                       <fo:block>org.osgi.service.remoteserviceadmin<fo:inline id="org.osgi.service.remoteserviceadmin-version"/>
                                       </fo:block>
                                    </fo:list-item-body>
                                 </fo:list-item>
                              </fo:list-block>
                           </fo:block>
                        </fo:block>
                     </fo:block>
                  </fo:block>
                  <fo:block keep-together.within-column="always"/>
               </fo:block>
            </fo:block>
            <fo:block space-before.optimum="5pt"
                      space-before.minimum="5pt"
                      space-before.maximum="5pt">
Remote Service Admin Package Version 1.1.
 
 </fo:block>
            <fo:block space-before.optimum="5pt"
                      space-before.minimum="5pt"
                      space-before.maximum="5pt">
 Bundles wishing to use this package must list the package in the
 Import-Package header of the bundle's manifest. This package has two types of
 users: the consumers that use the API in this package and the providers that
 implement the API in this package.
 
 </fo:block>
            <fo:block space-before.optimum="5pt"
                      space-before.minimum="5pt"
                      space-before.maximum="5pt">
 Example import for consumers using the API in this package:
 </fo:block>
            <fo:block space-before.optimum="5pt"
                      space-before.minimum="5pt"
                      space-before.maximum="5pt">
 {@code  Import-Package: org.osgi.service.remoteserviceadmin; version="[1.1,2.0)"}
 </fo:block>
            <fo:block space-before.optimum="5pt"
                      space-before.minimum="5pt"
                      space-before.maximum="5pt">
 Example import for providers implementing the API in this package:
 </fo:block>
            <fo:block space-before.optimum="5pt"
                      space-before.minimum="5pt"
                      space-before.maximum="5pt">
 {@code  Import-Package: org.osgi.service.remoteserviceadmin; version="[1.1,1.2)"}</fo:block>
            <fo:block id="d61e1922">
               <fo:block>
                  <fo:block>
                     <fo:block keep-together.within-column="always"
                               margin-left="0pt"
                               font-family="ProductusSemibold,ArialUnicodeMS">
                        <fo:block keep-with-next.within-column="always">
                           <fo:block xmlns:d="http://docbook.org/ns/docbook"
                                     xmlns:xlink="http://www.w3.org/1999/xlink"
                                     font-family="ProductusSemibold,ArialUnicodeMS"
                                     font-weight="normal"
                                     keep-with-next.within-column="always"
                                     space-before.minimum="0.8em"
                                     space-before.optimum="1.0em"
                                     space-before.maximum="1.2em"
                                     text-align="start"
                                     start-indent="0pt"
                                     hyphenate="false">
                              <fo:block font-size="12pt"
                                        line-height="14pt"
                                        space-before="8pt"
                                        space-after="5pt">
                                 <fo:list-block provisional-distance-between-starts="1in"
                                                provisional-label-separation="0.090in">
                                    <fo:list-item>
                                       <fo:list-item-label end-indent="label-end()" text-align="start">
                                          <fo:block>122.12.1</fo:block>
                                       </fo:list-item-label>
                                       <fo:list-item-body start-indent="body-start()">
                                          <fo:block>Summary</fo:block>
                                       </fo:list-item-body>
                                    </fo:list-item>
                                 </fo:list-block>
                              </fo:block>
                           </fo:block>
                        </fo:block>
                     </fo:block>
                  </fo:block>
               </fo:block>
               <fo:list-block space-before.optimum="1em"
                              space-before.minimum="0.8em"
                              space-before.maximum="1.2em"
                              space-after.optimum="1em"
                              space-after.minimum="0.8em"
                              space-after.maximum="1.2em"
                              provisional-label-separation="0.2em"
                              provisional-distance-between-starts="12pt"
                              id="d61e1924">
                  <fo:list-item space-before.optimum="2pt"
                                space-before.minimum="2pt"
                                space-before.maximum="2pt"
                                id="d61e1925">
                     <fo:list-item-label end-indent="label-end()">
                        <fo:block>•</fo:block>
                     </fo:list-item-label>
                     <fo:list-item-body start-indent="body-start()">
                        <fo:block>
                           <fo:block>
                              <fo:basic-link xmlns:d="http://docbook.org/ns/docbook"
                                             xmlns:xlink="http://www.w3.org/1999/xlink"
                                             internal-destination="org.osgi.service.remoteserviceadmin.EndpointDescription">
                                 <fo:inline color="inherit"
                                            font-family="inherit"
                                            letter-spacing="inherit"
                                            hyphenate="inherit">
                                    <fo:inline font-family="ProductusOSGiBookc,ArialUnicodeMS"
                                               font-size="9pt"
                                               letter-spacing="0.08em">EndpointDescription</fo:inline>
                                 </fo:inline>
                              </fo:basic-link> - 
A description of an endpoint that provides sufficient information for a
 compatible distribution provider to create a connection to this endpoint
 
 An Endpoint Description is easy to transfer between different systems because
 it is property based where the property keys are strings and the values are
 simple types.
   </fo:block>
                        </fo:block>
                     </fo:list-item-body>
                  </fo:list-item>
                  <fo:list-item space-before.optimum="2pt"
                                space-before.minimum="2pt"
                                space-before.maximum="2pt"
                                id="d61e1933">
                     <fo:list-item-label end-indent="label-end()">
                        <fo:block>•</fo:block>
                     </fo:list-item-label>
                     <fo:list-item-body start-indent="body-start()">
                        <fo:block>
                           <fo:block>
                              <fo:basic-link xmlns:d="http://docbook.org/ns/docbook"
                                             xmlns:xlink="http://www.w3.org/1999/xlink"
                                             internal-destination="org.osgi.service.remoteserviceadmin.EndpointEvent">
                                 <fo:inline color="inherit"
                                            font-family="inherit"
                                            letter-spacing="inherit"
                                            hyphenate="inherit">
                                    <fo:inline font-family="ProductusOSGiBookc,ArialUnicodeMS"
                                               font-size="9pt"
                                               letter-spacing="0.08em">EndpointEvent</fo:inline>
                                 </fo:inline>
