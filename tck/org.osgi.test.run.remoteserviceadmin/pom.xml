	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>
	<parent>
		<groupId>org.osgi.tck</groupId>
		<artifactId>org.osgi.tck.service.remoteserviceadmin</artifactId>
		<version>${revision}</version>
	</parent>
	<groupId>org.osgi.tck</groupId>
	<artifactId>org.osgi.test.run.remoteserviceadmin</artifactId>

	<properties>
		<!-- The keystore of the secure suites, as an absolute path. The test VM
		     runs from a working directory below target/, so a path relative to
		     this module would not resolve there; the workspace build likewise
		     hands the framework an absolute path. -->
		<tck.keystore>${project.basedir}/../keystore</tck.keystore>
	</properties>

	<!--
		Manage JUnit here on purpose: the parent POM sets the family to 5.12.2,
		and with that version bnd's bundle engine no longer discovers any tests
		in the run. The BOM pins Jupiter and Platform together to the versions
		the original build used, transitive dependencies included.
	-->
