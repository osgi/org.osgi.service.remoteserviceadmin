# No java: — the test VM is the same as the build's. A fixed path would
# only be valid on one machine; the minimum version a run requires is
# recorded as jdk.run.minimum in the POM.
-tester: biz.aQute.tester.junit-platform

-runee: JavaSE-11

-resolve.effective: active

-runvm: ${def;argLine}, -Djava.security.manager=allow

-runproperties: \
	rsa.tck.timeout=30000,\
	rsa.tck.timeout.factor=3,\
	org.osgi.test.cases.remoteserviceadmin.framework.properties="",\
	org.osgi.test.cases.remoteserviceadmin.system.packages.extra="",\
	org.osgi.test.cases.remoteserviceadmin.serverconfig="service.exported.configs,service.exported.intents,ecf.endpoint.id.ns,ecf.generic.server.hostname,ecf.generic.server.port",\
	service.exported.configs="ecf.generic.server",\
	service.exported.intents="osgi.basic",\
	org.osgi.test.cases.remoteserviceadmin.bundles="${repo;assertj-core;latest},${repo;junit-jupiter-api;latest},${repo;junit-jupiter-engine;latest},${repo;junit-jupiter-params;latest},${repo;junit-platform-commons;latest},${repo;junit-platform-engine;latest},${repo;junit-platform-launcher;latest},${repo;junit-vintage-engine;latest},${repo;org.hamcrest;latest},${repo;org.awaitility;latest},${repo;org.apache.servicemix.bundles.junit;latest},${repo;org.opentest4j;latest},${repo;org.osgi.test.common;latest},${repo;org.osgi.test.assertj.framework;latest},${repo;org.osgi.test.junit5;latest},${repo;org.osgi.test.junit4;latest},${repo;org.mockito.mockito-core;latest},${repo;net.bytebuddy.byte-buddy;latest},${repo;net.bytebuddy.byte-buddy-agent;latest},${repo;org.objenesis;latest},${repo;org.osgi.service.event;latest},${repo;org.eclipse.equinox.event;latest},${repo;org.apache.felix.scr;latest},${repo;org.osgi.service.component;latest},${repo;org.osgi.util.function;latest},${repo;org.osgi.util.promise;latest},${repo;org.apache.felix.configadmin;latest},${repo;org.eclipse.equinox.metatype;latest},${repo;org.osgi.service.metatype;latest},${repo;org.apache.aries.spifly.dynamic.bundle;latest},${repo;org.apache.aries.util;latest},${repo;org.objectweb.asm.all;latest},${repo;org.apache.geronimo.specs.geronimo-json_1.1_spec;latest},${repo;org.apache.johnzon.core;latest},${repo;org.apache.felix.cm.json;latest},${repo;org.apache.felix.configurator;latest},${repo;org.osgi.util.converter;latest},${repo;org.eclipse.core.jobs;latest},${repo;org.eclipse.equinox.common;latest},${repo;org.eclipse.equinox.concurrent;latest},${repo;org.eclipse.equinox.supplement;latest},${repo;org.eclipse.ecf.identity;latest},${repo;org.eclipse.ecf;latest},${repo;org.eclipse.ecf.sharedobject;latest},${repo;org.eclipse.ecf.discovery;latest},${repo;org.eclipse.ecf.provider;latest},${repo;org.eclipse.ecf.remoteservice;latest},${repo;org.eclipse.ecf.provider.remoteservice;latest},${repo;org.eclipse.ecf.remoteservice.asyncproxy;latest},${repo;org.eclipse.ecf.osgi.services.remoteserviceadmin.proxy;latest},${repo;org.eclipse.osgi.services.remoteserviceadmin;latest},${repo;org.eclipse.ecf.osgi.services.remoteserviceadmin;latest},${repo;org.eclipse.ecf.osgi.services.distribution;latest},${repo;org.eclipse.ecf.provider.jmdns;latest}",\
	ecf.endpoint.id.ns=org.eclipse.ecf.core.identity.StringID,\
	org.eclipse.ecf.osgi.services.remoteserviceadmin.AbstractTopologyManager.requireServiceExportedConfigs=true,\
	ecf.generic.server.hostname=localhost,\
	ecf.generic.server.port=@@FREE_PORT@@,\
	org.eclipse.ecf.osgi.services.remoteserviceadmin.HostContainerSelector.reuseExistingContainers=false,\
	org.eclipse.ecf.osgi.services.remoteserviceadmin.TopologyManagerImpl.nonECFTopologyMananger=true

-runfw: org.eclipse.osgi


# API overlays on the framework classpath (exports become system packages)
-runpath: \


# This will help us keep -runbundles sorted
-runstartlevel: \
    order=sortbynameversion,\
    begin=-1

-runrequires: \
	bnd.identity;id='org.osgi.test.cases.remoteserviceadmin',\
	bnd.identity;id='org.apache.felix.configadmin',\
	bnd.identity;id='org.eclipse.equinox.event',\
	bnd.identity;id='org.apache.felix.scr',\
	bnd.identity;id='org.eclipse.equinox.metatype',\
	bnd.identity;id='org.apache.aries.spifly.dynamic.bundle',\
	bnd.identity;id='org.apache.aries.util',\
	bnd.identity;id='org.objectweb.asm.all',\
	bnd.identity;id='org.apache.geronimo.specs.geronimo-json_1.1_spec',\
	bnd.identity;id='org.apache.johnzon.core',\
	bnd.identity;id='org.apache.felix.cm.json',\
	bnd.identity;id='org.apache.felix.configurator',\
	bnd.identity;id='org.eclipse.core.jobs',\
	bnd.identity;id='org.eclipse.equinox.common',\
	bnd.identity;id='org.eclipse.equinox.concurrent',\
	bnd.identity;id='org.eclipse.equinox.supplement',\
	bnd.identity;id='org.eclipse.ecf.identity',\
	bnd.identity;id='org.eclipse.ecf',\
	bnd.identity;id='org.eclipse.ecf.sharedobject',\
	bnd.identity;id='org.eclipse.ecf.discovery',\
	bnd.identity;id='org.eclipse.ecf.provider',\
	bnd.identity;id='org.eclipse.ecf.remoteservice',\
	bnd.identity;id='org.eclipse.ecf.provider.remoteservice',\
	bnd.identity;id='org.eclipse.ecf.remoteservice.asyncproxy',\
	bnd.identity;id='org.eclipse.ecf.osgi.services.remoteserviceadmin.proxy',\
	bnd.identity;id='org.eclipse.osgi.services.remoteserviceadmin',\
	bnd.identity;id='org.eclipse.ecf.osgi.services.remoteserviceadmin',\
	bnd.identity;id='org.eclipse.ecf.osgi.services.distribution',\
	bnd.identity;id='org.eclipse.ecf.provider.jmdns',\
	bnd.identity;id='org.apache.servicemix.bundles.junit',\
	bnd.identity;id='assertj-core';version='[3.23.1,3.23.2)',\
	bnd.identity;id='junit-jupiter-api';version='[5.8.2,5.8.3)',\
	bnd.identity;id='junit-jupiter-engine';version='[5.8.2,5.8.3)',\
	bnd.identity;id='junit-jupiter-params';version='[5.8.2,5.8.3)',\
	bnd.identity;id='junit-platform-commons';version='[1.8.2,1.8.3)',\
	bnd.identity;id='junit-platform-engine';version='[1.8.2,1.8.3)',\
	bnd.identity;id='junit-platform-launcher';version='[1.8.2,1.8.3)',\
	bnd.identity;id='junit-vintage-engine';version='[5.8.2,5.8.3)',\
	bnd.identity;id='org.hamcrest';version='[2.2.0,2.2.1)',\
	bnd.identity;id='org.awaitility';version='[4.2.0,4.2.1)',\
	bnd.identity;id='org.apache.servicemix.bundles.junit';version='[4.13.2.1,4.13.2.2)',\
	bnd.identity;id='org.opentest4j';version='[1.2.0,1.2.1)',\
	bnd.identity;id='org.osgi.test.common';version='[1.2.0,1.2.1)',\
	bnd.identity;id='org.osgi.test.assertj.framework';version='[1.2.0,1.2.1)',\
	bnd.identity;id='org.osgi.test.junit5';version='[1.2.0,1.2.1)',\
	bnd.identity;id='org.osgi.test.junit4';version='[1.2.0,1.2.1)',\
	bnd.identity;id='org.mockito.mockito-core';version='[4.6.1,4.6.2)',\
	bnd.identity;id='net.bytebuddy.byte-buddy';version='[1.12.10,1.12.11)',\
	bnd.identity;id='net.bytebuddy.byte-buddy-agent';version='[1.12.10,1.12.11)',\
	bnd.identity;id='org.objenesis'

# Test infrastructure for the junit-platform tester — mirrors the original
# cnf/repo/osgi.tck.junit-platform lib that every TCK run carried
-runbundles.tck: \
	assertj-core;version='[3.23.1,3.23.2)',\
	junit-jupiter-api;version='[5.8.2,5.8.3)',\
	junit-jupiter-engine;version='[5.8.2,5.8.3)',\
	junit-jupiter-params;version='[5.8.2,5.8.3)',\
	junit-platform-commons;version='[1.8.2,1.8.3)',\
	junit-platform-engine;version='[1.8.2,1.8.3)',\
	junit-platform-launcher;version='[1.8.2,1.8.3)',\
	junit-vintage-engine;version='[5.8.2,5.8.3)',\
	org.hamcrest;version='[2.2.0,2.2.1)',\
	org.awaitility;version='[4.2.0,4.2.1)',\
	org.apache.servicemix.bundles.junit;version='[4.13.2.1,4.13.2.2)',\
	org.opentest4j;version='[1.2.0,1.2.1)',\
	org.osgi.test.common;version='[1.2.0,1.2.1)',\
	org.osgi.test.assertj.framework;version='[1.2.0,1.2.1)',\
	org.osgi.test.junit5;version='[1.2.0,1.2.1)',\
	org.osgi.test.junit4;version='[1.2.0,1.2.1)',\
	org.mockito.mockito-core;version='[4.6.1,4.6.2)',\
	net.bytebuddy.byte-buddy;version='[1.12.10,1.12.11)',\
	net.bytebuddy.byte-buddy-agent;version='[1.12.10,1.12.11)',\
	org.objenesis


# -runbundles is calculated by the bnd-resolver-maven-plugin during the run
-runbundles:
