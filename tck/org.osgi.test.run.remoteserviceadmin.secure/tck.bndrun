# No java: — the test VM is the same as the build's. A fixed path would
# only be valid on one machine; the minimum version a run requires is
# recorded as jdk.run.minimum in the POM.
-tester: biz.aQute.tester.junit-platform

-runee: JavaSE-11

-resolve.effective: active

-runvm: ${def;argLine}, -Djava.security.manager=allow, -Djava.security.policy=all.policy

-runproperties: \
	rsa.tck.timeout=30000,\
	rsa.tck.timeout.factor=3,\
	org.osgi.test.cases.remoteserviceadmin.secure.framework.properties="",\
	org.osgi.test.cases.remoteserviceadmin.secure.system.packages.extra="",\
	org.osgi.test.cases.remoteserviceadmin.secure.serverconfig="service.exported.configs,service.exported.intents,ecf.endpoint.id.ns,ecf.generic.server.hostname,ecf.generic.server.port",\
	service.exported.configs="ecf.generic.server",\
	service.exported.intents="osgi.basic",\
	org.osgi.test.cases.remoteserviceadmin.secure.bundles="${repo;assertj-core;latest},${repo;junit-jupiter-api;latest},${repo;junit-jupiter-engine;latest},${repo;junit-jupiter-params;latest},${repo;junit-platform-commons;latest},${repo;junit-platform-engine;latest},${repo;junit-platform-launcher;latest},${repo;junit-vintage-engine;latest},${repo;org.hamcrest;latest},${repo;org.awaitility;latest},${repo;org.apache.servicemix.bundles.junit;latest},${repo;org.opentest4j;latest},${repo;org.osgi.test.common;latest},${repo;org.osgi.test.assertj.framework;latest},${repo;org.osgi.test.junit5;latest},${repo;org.osgi.test.junit4;latest},${repo;org.mockito.mockito-core;latest},${repo;net.bytebuddy.byte-buddy;latest},${repo;net.bytebuddy.byte-buddy-agent;latest},${repo;org.objenesis;latest},${repo;org.osgi.service.event;latest},${repo;org.eclipse.equinox.event;latest},${repo;org.apache.felix.scr;latest},${repo;org.osgi.service.component;latest},${repo;org.osgi.util.function;latest},${repo;org.osgi.util.promise;latest},${repo;org.apache.felix.configadmin;latest},${repo;org.eclipse.equinox.metatype;latest},${repo;org.osgi.service.metatype;latest},${repo;org.apache.aries.spifly.dynamic.bundle;latest},${repo;org.apache.aries.util;latest},${repo;org.objectweb.asm.all;latest},${repo;org.apache.geronimo.specs.geronimo-json_1.1_spec;latest},${repo;org.apache.johnzon.core;latest},${repo;org.apache.felix.cm.json;latest},${repo;org.apache.felix.configurator;latest},${repo;org.osgi.util.converter;latest},${repo;org.eclipse.core.jobs;latest},${repo;org.eclipse.equinox.common;latest},${repo;org.eclipse.equinox.concurrent;latest},${repo;org.eclipse.equinox.supplement;latest},${repo;org.eclipse.ecf.identity;latest},${repo;org.eclipse.ecf;latest},${repo;org.eclipse.ecf.sharedobject;latest},${repo;org.eclipse.ecf.discovery;latest},${repo;org.eclipse.ecf.provider;latest},${repo;org.eclipse.ecf.remoteservice;latest},${repo;org.eclipse.ecf.provider.remoteservice;latest},${repo;org.eclipse.ecf.remoteservice.asyncproxy;latest},${repo;org.eclipse.ecf.osgi.services.remoteserviceadmin.proxy;latest},${repo;org.eclipse.osgi.services.remoteserviceadmin;latest},${repo;org.eclipse.ecf.osgi.services.remoteserviceadmin;latest},${repo;org.eclipse.ecf.osgi.services.distribution;latest},${repo;org.eclipse.ecf.provider.jmdns;latest}",\
	ecf.endpoint.id.ns=org.eclipse.ecf.core.identity.StringID,\
	org.eclipse.ecf.osgi.services.remoteserviceadmin.AbstractTopologyManager.requireServiceExportedConfigs=true,\
	ecf.generic.server.hostname=localhost,\
	ecf.generic.server.port=@@FREE_PORT@@,\
	org.eclipse.ecf.osgi.services.remoteserviceadmin.HostContainerSelector.reuseExistingContainers=false,\
	org.eclipse.ecf.osgi.services.remoteserviceadmin.TopologyManagerImpl.nonECFTopologyMananger=true,\
	org.osgi.framework.security=osgi,\
	org.osgi.framework.trust.repositories=${def;tck.keystore}

-runfw: org.eclipse.osgi


# API overlays on the framework classpath (exports become system packages)
-runpath: \


# This will help us keep -runbundles sorted
-runstartlevel: \
    order=sortbynameversion,\
    begin=-1

# Test runtime versions: the Maven properties of tck/pom.xml, as the OSGi
# range [x.y.z,x.y.z+1). version_cleanup turns 1.4.0-SNAPSHOT into 1.4.0.SNAPSHOT.
tck.range: ${range;[===,==+);${version_cleanup;${1}}}

-runrequires: \
	bnd.identity;id='org.osgi.test.cases.remoteserviceadmin.secure';version='${tck.range;${revision}}',\
	bnd.identity;id='org.apache.felix.configadmin';version='${tck.range;${org.apache.felix.configadmin.version}}',\
	bnd.identity;id='org.eclipse.equinox.event';version='${tck.range;${org.eclipse.equinox.event.version}}',\
	bnd.identity;id='org.apache.felix.scr';version='${tck.range;${org.apache.felix.scr.version}}',\
	bnd.identity;id='org.eclipse.equinox.metatype';version='${tck.range;${org.eclipse.equinox.metatype.version}}',\
	bnd.identity;id='org.apache.aries.spifly.dynamic.bundle';version='${tck.range;${org.apache.aries.spifly.dynamic.bundle.version}}',\
	bnd.identity;id='org.apache.aries.util';version='${tck.range;${org.apache.aries.util.version}}',\
	bnd.identity;id='org.objectweb.asm.all';version='${tck.range;${asm-all.version}}',\
	bnd.identity;id='org.apache.geronimo.specs.geronimo-json_1.1_spec';version='${tck.range;${geronimo-json_1.1_spec.version}}',\
	bnd.identity;id='org.apache.johnzon.core';version='${tck.range;${johnzon-core.version}}',\
	bnd.identity;id='org.apache.felix.cm.json';version='${tck.range;${org.apache.felix.cm.json.version}}',\
	bnd.identity;id='org.apache.felix.configurator';version='${tck.range;${org.apache.felix.configurator.version}}',\
	bnd.identity;id='org.eclipse.core.jobs';version='${tck.range;${org.eclipse.core.jobs.version}}',\
	bnd.identity;id='org.eclipse.equinox.common';version='${tck.range;${org.eclipse.equinox.common.version}}',\
	bnd.identity;id='org.eclipse.equinox.concurrent';version='${tck.range;${org.eclipse.equinox.concurrent.version}}',\
	bnd.identity;id='org.eclipse.equinox.supplement';version='${tck.range;${org.eclipse.equinox.supplement.version}}',\
	bnd.identity;id='org.eclipse.ecf.identity';version='${tck.range;${org.eclipse.ecf.identity.version}}',\
	bnd.identity;id='org.eclipse.ecf';version='${tck.range;${org.eclipse.ecf.version}}',\
	bnd.identity;id='org.eclipse.ecf.sharedobject';version='${tck.range;${org.eclipse.ecf.sharedobject.version}}',\
	bnd.identity;id='org.eclipse.ecf.discovery';version='${tck.range;${org.eclipse.ecf.discovery.version}}',\
	bnd.identity;id='org.eclipse.ecf.provider';version='${tck.range;${org.eclipse.ecf.provider.version}}',\
	bnd.identity;id='org.eclipse.ecf.remoteservice';version='${tck.range;${org.eclipse.ecf.remoteservice.version}}',\
	bnd.identity;id='org.eclipse.ecf.provider.remoteservice';version='${tck.range;${org.eclipse.ecf.provider.remoteservice.version}}',\
	bnd.identity;id='org.eclipse.ecf.remoteservice.asyncproxy';version='${tck.range;${org.eclipse.ecf.remoteservice.asyncproxy.version}}',\
	bnd.identity;id='org.eclipse.ecf.osgi.services.remoteserviceadmin.proxy';version='${tck.range;${org.eclipse.ecf.osgi.services.remoteserviceadmin.proxy.version}}',\
	bnd.identity;id='org.eclipse.osgi.services.remoteserviceadmin';version='${tck.range;${org.eclipse.osgi.services.remoteserviceadmin.version}}',\
	bnd.identity;id='org.eclipse.ecf.osgi.services.remoteserviceadmin';version='${tck.range;${org.eclipse.ecf.osgi.services.remoteserviceadmin.version}}',\
	bnd.identity;id='org.eclipse.ecf.osgi.services.distribution';version='${tck.range;${org.eclipse.ecf.osgi.services.distribution.version}}',\
	bnd.identity;id='org.eclipse.ecf.provider.jmdns';version='${tck.range;${org.eclipse.ecf.provider.jmdns.version}}',\
	bnd.identity;id='org.apache.servicemix.bundles.junit';version='${tck.range;${servicemix-junit.version}}',\
	bnd.identity;id='assertj-core';version='${tck.range;${assertj.version}}',\
	bnd.identity;id='junit-jupiter-api';version='${tck.range;${junit-jupiter.version}}',\
	bnd.identity;id='junit-jupiter-engine';version='${tck.range;${junit-jupiter.version}}',\
	bnd.identity;id='junit-jupiter-params';version='${tck.range;${junit-jupiter.version}}',\
	bnd.identity;id='junit-platform-commons';version='${tck.range;${junit-platform.version}}',\
	bnd.identity;id='junit-platform-engine';version='${tck.range;${junit-platform.version}}',\
	bnd.identity;id='junit-platform-launcher';version='${tck.range;${junit-platform.version}}',\
	bnd.identity;id='junit-vintage-engine';version='${tck.range;${junit-jupiter.version}}',\
	bnd.identity;id='org.hamcrest';version='${tck.range;${hamcrest.version}}',\
	bnd.identity;id='org.awaitility';version='${tck.range;${awaitility.version}}',\
	bnd.identity;id='org.apache.servicemix.bundles.junit';version='[4.13.2.1,4.13.2.2)',\
	bnd.identity;id='org.opentest4j';version='${tck.range;${opentest4j.version}}',\
	bnd.identity;id='org.osgi.test.common';version='${tck.range;${osgi-test.version}}',\
	bnd.identity;id='org.osgi.test.assertj.framework';version='${tck.range;${osgi-test.version}}',\
	bnd.identity;id='org.osgi.test.junit5';version='${tck.range;${osgi-test.version}}',\
	bnd.identity;id='org.osgi.test.junit4';version='${tck.range;${osgi-test.version}}',\
	bnd.identity;id='org.mockito.mockito-core';version='${tck.range;${mockito.version}}',\
	bnd.identity;id='net.bytebuddy.byte-buddy';version='${tck.range;${byte-buddy.version}}',\
	bnd.identity;id='net.bytebuddy.byte-buddy-agent';version='${tck.range;${byte-buddy.version}}',\
	bnd.identity;id='org.objenesis';version='${tck.range;${objenesis.version}}'

# -runbundles is committed and verified by the build; after a dependency
# change update it with: mvn bnd-resolver:resolve
